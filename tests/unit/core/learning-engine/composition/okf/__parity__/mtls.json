        "journeys": [
          {
            "id": "mtls_happy_path",
            "label": "Successful mTLS Handshake",
            "description": "All certificates are valid, encrypted channel established",
            "steps": [
              {
                "nodeIds": [
                  "client_dev",
                  "pol_init_connection",
                  "cmd_init_connection",
                  "client",
                  "evt_connection_initiated"
