{
  "comments": { "lineComment": "//" },
  "brackets": [["(", ")"], ["[", "]"], ["{", "}"]],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [["(", ")"], ["[", "]"], ["{", "}"], ["\"", "\""]],
  "wordPattern": "[$@]?[A-Za-z_]\\w*",
  "indentationRules": {
    "increaseIndentPattern": "[(\\[{]\\s*(//.*)?$",
    "decreaseIndentPattern": "^\\s*[)\\]}]"
  },
  "onEnterRules": []
}
