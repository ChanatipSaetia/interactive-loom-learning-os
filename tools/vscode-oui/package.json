{
  "name": "loom-openui-lang",
  "displayName": "Loom OpenUI Lang",
  "description": "Syntax highlighting, autocomplete, signature help, hovers and diagnostics for Interactive Loom OpenUI Lang (.oui) content files.",
  "version": "0.1.0",
  "publisher": "interactive-loom",
  "private": true,
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "oui",
        "aliases": [
          "OpenUI Lang (Loom)",
          "oui"
        ],
        "extensions": [
          ".oui"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "oui",
        "scopeName": "source.oui",
        "path": "./syntaxes/oui.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p .",
    "test": "node build.mjs && node --test test/*.test.mjs",
    "package": "node build.mjs && npx -y @vscode/vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "~1.85.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  }
}
