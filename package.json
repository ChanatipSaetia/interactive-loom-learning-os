{
  "name": "interactive-loom-learning-os",
  "private": true,
  "version": "1.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "build:lib": "BUILD_MODE=lib vite build",
    "build:all": "tsc -b && BUILD_MODE=lib vite build && vite build",
    "publish:lib": "npm run build:lib && cp -r docs dist-lib/docs && cp libs/package.lib.json dist-lib/package.json && npm publish dist-lib/ --access public",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "okf:validate": "npx -y tsx scripts/validate-okf.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/highlight": "^1.2.5",
    "@openuidev/lang-core": "^0.3.0",
    "@openuidev/react-lang": "^0.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "animejs": "^4.2.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "js-yaml": "^5.2.1",
    "lenis": "^1.3.24",
    "lucide-react": "^1.17.0",
    "marked": "^18.0.4",
    "motion": "^12.42.0",
    "next-themes": "^0.4.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "jsdom": "^25.0.1",
    "sirv": "^3.0.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
