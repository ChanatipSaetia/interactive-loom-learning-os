// @loom-topic pour-over-coffee
// === topic.oui ===
root = Topic("Pour-Over Coffee", "Food & Drink", "Ratio, water temperature, grind and the bloom: brew a sweet, clear cup by hand, then pick the brewer that suits you.", [SectionRef("intro"), SectionRef("vocabulary"), SectionRef("brew-steps"), SectionRef("knowledge-check"), SectionRef("choose-a-brewer")], ["coffee", "brewing", "pour-over"], "beginner", "2026-10-18", true)

// === sections/intro.oui ===
root = Intro("Pour-Over Coffee", what, why, [vocab, steps, check, brewer], "Slow water, clear cup", "10 min", 4)
what = IntroWhat("Pour-over is coffee made by pouring hot water by hand over ground coffee in a paper filter, so it drips through into the cup.", "Pour-over: a manual filter brew where you control the water's speed, temperature and amount.", ["About 15 g of coffee for 250 g of water (1:16)", "Water at 92–96 °C", "Total brew time of 2½–3½ minutes"], ["coffee", "filter"])
why = IntroWhy("The paper filter holds back oils and fine particles, so the cup is clean and the coffee's own flavours come through.", "Grind size and pour speed are the two dials that turn a sour or bitter cup into a sweet one.")
vocab = RoadmapStep("Vocabulary", "flashcards", "Learn the two words every brew guide uses.", "vocabulary")
steps = RoadmapStep("Brew steps", "bullets", "Follow one brew from kettle to cup.", "brew-steps")
check = RoadmapStep("Knowledge check", "quiz", "Fix a sour cup and explain the bloom.", "knowledge-check")
brewer = RoadmapStep("Choose a brewer", "decision-tree", "Pick a dripper for how you brew.", "choose-a-brewer")

// === sections/intro.narrate.oui ===
root = Narration([s1, s2, s3, s4])
s1 = NarrationStep("title", "Let's brew a cup of pour-over coffee by hand.")
s2 = NarrationStep("what", "Pour-over means you pour the water yourself, slowly, through a paper filter.", [Highlight("what.definition")])
s3 = NarrationStep("why", "Because you control the water, you control the taste.")
s4 = NarrationStep("roadmap", "Two words first, then the steps, a quick check, and finally which brewer to buy.")

// === sections/vocabulary.oui ===
root = Flashcards("Vocabulary", [bloom, extraction])
bloom = Flashcard("bloom", "Bloom", "/bluːm/", "technique", "A first small pour that lets trapped gas escape.", "Fresh coffee holds carbon dioxide from roasting. Wetting the grounds with about twice their weight in water and waiting 30–45 seconds lets the gas bubble out, so the water can reach the coffee evenly afterwards.", "Skip it and the gas pushes water away from the grounds, which gives a weak, uneven cup.")
extraction = Flashcard("extraction", "Extraction", "/ɪkˈstrækʃən/", "concept", "How much of the coffee dissolves into the water.", "Acids dissolve first, then sugars, then bitter compounds. Too little extraction tastes sour and thin; too much tastes bitter and dry. A finer grind or hotter water extracts more; a coarser grind or cooler water extracts less.", "Every fix for a bad cup is a change in extraction.")

// === sections/vocabulary.narrate.oui ===
root = Narration([w1, b1, w2, b2])
w1 = NarrationStep("card1", "First word: the bloom.", [Highlight("bloom")])
b1 = NarrationStep("card1.back", "Fresh coffee is full of gas from roasting, so you wet it and wait half a minute.", [Callout("bloom", "Bubbles on the surface are the gas escaping. Old coffee barely blooms.")])
w2 = NarrationStep("card2", "Next: extraction.")
b2 = NarrationStep("card2.back", "Sour means too little, bitter means too much.", [Callout("extraction", "Grind finer to extract more, coarser to extract less.")])

// === sections/brew-steps.oui ===
root = Bullets("Brew Steps", [heat, bloomStep, pour], true)
heat = Bullet("Heat water to 92–96 °C and rinse the paper filter", [Bullet("Rinsing removes the paper taste and warms the dripper"), Bullet("Weigh 15 g of medium-fine coffee into the filter")])
bloomStep = Bullet("Bloom: pour 30 g of water and wait 30–45 seconds", [Bullet("Wet every ground; swirl gently if dry spots remain")])
pour = Bullet("Pour the rest in slow circles up to 250 g", [Bullet("Keep the stream in the centre, away from the paper"), Bullet("Aim to finish dripping at 2½–3½ minutes")])

// === sections/brew-steps.narrate.oui ===
root = Narration([i1, i2, i3])
i1 = NarrationStep("item1", "Start with hot water, just off the boil, and a rinsed filter.", [Highlight("heat")])
i2 = NarrationStep("item2", "Then the bloom: a little water, and a short wait.", [Highlight("bloomStep")])
i3 = NarrationStep("item3", "Finally pour the rest slowly. The total time tells you how the grind did.", [Callout("pour", "Faster than 2½ minutes: grind finer. Slower than 3½: grind coarser.")])

// === sections/knowledge-check.oui ===
root = Quiz("Knowledge Check", [q1, q2])
q1 = QuizQuestion("q1", "Your cup tastes sour and thin, and it finished dripping in 2 minutes. What do you change?", [QuizChoice("a", "Grind coarser", false, "A coarser grind extracts even less, so the cup gets more sour."), QuizChoice("b", "Grind finer", true, "A finer grind slows the water and extracts more, moving the cup from sour towards sweet.")], "Sour means too little extraction.")
q2 = QuizQuestion("q2", "Why do you pause after the first small pour?", [QuizChoice("a", "To let the water cool down", false, "The pause is not about temperature; the kettle water is already at 92–96 °C."), QuizChoice("b", "To let the roasting gas escape", true, "That is the bloom: once the gas is out, the water reaches the coffee evenly.")], "Think back to the bloom card.")

// === sections/knowledge-check.narrate.oui ===
root = Narration([k1, k1w, k1r, k2, k2w, k2r])
k1 = NarrationStep("q1", "A sour cup that ran fast. What would you change?")
k1w = NarrationStep("q1.wrong", "Coarser sounds like a fix for anything that tastes off, but it makes the water run even faster.")
k1r = NarrationStep("q1.right", "Finer is right: the water slows down and extracts more.", [Highlight("q1.choices[1]")])
k2 = NarrationStep("q2", "Now the pause after the first pour.")
k2w = NarrationStep("q2.wrong", "Cooling the water is tempting, but the temperature was already set.")
k2r = NarrationStep("q2.right", "It is the bloom, letting the gas out.")

// === sections/choose-a-brewer.oui ===
root = DecisionTree("Choose a Brewer", "brewer-tree", "cups", [cups, forgiving, chemex, kalita, v60])
cups = DecisionNode("cups", "How many cups do you usually brew at once?", [DecisionChoice("one", "One cup", "forgiving", "Single-cup drippers sit on a mug and are the easiest place to start.", true), DecisionChoice("several", "Two or more", "chemex", "A larger brewer keeps the bed deep enough for 500 g of water or more.")])
forgiving = DecisionNode("forgiving", "Do you want the brewer to forgive an uneven pour?", [DecisionChoice("yes", "Yes, keep it consistent", "kalita", "A flat bed with three small holes slows the flow, so pour speed matters less.", true), DecisionChoice("no", "No, I want control", "v60", "One large hole lets the pour speed set the flow, which rewards practice.")])
chemex = DecisionNode("chemex", null, null, DecisionLeaf("Chemex", "Its thick filter gives a very clean cup, and it brews up to 8 cups. It needs a coarser grind than single-cup drippers.", ["Thick filters cost more", "Slower to brew"]))
kalita = DecisionNode("kalita", null, null, DecisionLeaf("Kalita Wave", "The flat bottom keeps the coffee bed even and the small holes keep the brew time steady. It is the easiest dripper to get the same cup every day.", ["Needs its own wave filters"]))
v60 = DecisionNode("v60", null, null, DecisionLeaf("Hario V60", "The cone and large hole make the flow depend on how you pour. It can brew a brighter cup, but it takes practice.", ["Less forgiving while you learn"]))

// === sections/choose-a-brewer.narrate.oui ===
root = Narration([d1, d2, d3, d4, d5])
d1 = NarrationStep("start", "There are many drippers. The first question is how much coffee you make.", [Highlight("cups")])
d2 = NarrationStep("answer1", "Say you brew one cup at a time.")
d3 = NarrationStep("q2", "Then it comes down to how much the brewer should forgive.")
d4 = NarrationStep("answer2", "For a steady cup every morning, pick consistency.")
d5 = NarrationStep("result", "A flat-bottom dripper keeps the brew time steady.", [Highlight("kalita")])
