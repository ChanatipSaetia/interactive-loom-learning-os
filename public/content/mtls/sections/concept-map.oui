    ConceptLink(mtls, serverCertificate, "requires"),
    ConceptLink(mtls, zeroTrust, "enables"),
    ConceptLink(certificate, pki, "part of"),
    ConceptLink(ca, certificate, "issues"),
    ConceptLink(ca, pki, "core of"),
    ConceptLink(clientCertificate, certificate, "type of"),
