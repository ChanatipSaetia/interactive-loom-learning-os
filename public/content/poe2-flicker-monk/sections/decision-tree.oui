root = DecisionTree(
  "Build Setup Advisor",
  "flicker-advisor",
  "stage",
  [
    stage,
    weaponCheck,
    recLeagueStartGood,
    recSwitchStaff,
    recGetStaff,
    chargeChoice,
    recBuyAiliths,
    recMidOptimized,
    uberCheck,
    recStandardEndgame,
    recUberSetup,
  ],
  "Flicker Monk Setup Advisor",
)

stage = DecisionNode(
  "stage",
  "What stage of the league are you at?",
  [
    DecisionChoice(
      "league-start",
      "League start (Acts 1-4)",
      "weapon-check",
      "Early league priorities differ from endgame.",
      true,
    ),
    DecisionChoice("mid-league", "Mid-league (mapping, some endgame gear)", "charge-choice"),
    DecisionChoice("endgame", "Late league (Uber endgame target)", "uber-check"),
  ],
)

weaponCheck = DecisionNode(
  "weapon-check",
  "What weapon do you currently have?",
  [
    DecisionChoice(
      "has-staff",
      "A Quarterstaff with Lightning Damage",
      "rec-league-start-good",
      "You have the correct weapon type.",
      true,
    ),
    DecisionChoice("has-dreaming", "Dreaming Quarterstaff", "rec-switch-staff"),
    DecisionChoice("no-staff", "No Quarterstaff yet", "rec-get-staff"),
  ],
)

recLeagueStartGood = DecisionNode(
  "rec-league-start-good",
  null,
  null,
  DecisionLeaf(
    "Focus on reaching 4000 ES for Chaos Inoculation.",
    "You have the right weapon. Priority now is gearing toward CI: ES/Evasion hybrid armor, Spirit nodes for auras, and Shavronne's Satchel. Take CI at ~4000 ES.",
    [
      "Don't rush CI without Shavronne's Satchel — instant recovery is mandatory",
      "Early league charge generation: use Hollow Focus + Killing Palm bells",
      "Aim for 60% Crit Chance on Whirling Assault for Cast on Critical uptime",
    ],
  ),
)

recSwitchStaff = DecisionNode(
  "rec-switch-staff",
  null,
  null,
  DecisionLeaf(
    "Switch to any non-Dreaming Quarterstaff immediately.",
    "Dreaming Quarterstaff has 0% base Crit Chance, which breaks Cast on Critical, Nova Projectiles crit scaling, and every crit mechanic in this build. Any other Quarterstaff is better.",
    [
      "Even a basic staff with Lightning Damage outperforms the Dreaming variant for this build",
      "Look for: flat Lightning Damage, % Increased Critical Damage, Attack Speed",
      "Oisin's Oath requires Leech Phys Damage as Mana somewhere on gear",
    ],
  ),
)

recGetStaff = DecisionNode(
  "rec-get-staff",
  null,
  null,
  DecisionLeaf(
    "Acquire a Quarterstaff (avoid Dreaming) as your top priority.",
    "The Quarterstaff is the build's foundation — it sockets Falling Thunder, Flicker Strike, and other skills. Look for flat Lightning Damage, Crit stats, and Attack Speed.",
    [
      "League starter staffs are cheap on trade (1-3 Divine equivalent)",
      "Focus on getting ES/Evasion body armor simultaneously",
      "Don't invest in jewelry until you have a staff and body armor",
    ],
  ),
)

chargeChoice = DecisionNode(
  "charge-choice",
  "How are you generating Power Charges for boss fights?",
  [
    DecisionChoice(
      "hollow-focus-charges",
      "Hollow Focus + Killing Palm bell culling",
      "rec-buy-ailiths",
    ),
    DecisionChoice("ailiths-charges", "Ailith's Chimes + Combo", "rec-mid-optimized", null, true),
  ],
)

recBuyAiliths = DecisionNode(
  "rec-buy-ailiths",
  null,
  null,
  DecisionLeaf(
    "Buy Ailith's Chimes now — prices have dropped mid-league.",
    "Ailith's Chimes converts Combo expenditure into Power Charges instantly. The Hollow Focus method works but is manual and slow for boss fights.",
    [
      "Mid-league Ailith's Chimes is affordable (check trade for current price)",
      "Requires Mantra of Destruction + Delayed Gratification link",
      "Once acquired, boss charge generation becomes one-click",
    ],
  ),
)

recMidOptimized = DecisionNode(
  "rec-mid-optimized",
  null,
  null,
  DecisionLeaf(
    "You're on the right path. Focus on defense upgrades and Stonefist glove optimization.",
    "With Ailith's Chimes, your charge generation is optimal. Now prioritize: Subterfuge Mask helmet (400+ ES), Heart of the Well for Chaos Damage, and Stonefist gloves with Physical + 2 elemental prefixes.",
