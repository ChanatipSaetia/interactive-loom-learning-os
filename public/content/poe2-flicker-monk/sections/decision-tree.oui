  ),
)

uberCheck = DecisionNode(
  "uber-check",
  "What's your endgame target?",
  [
    DecisionChoice(
      "map-bosses",
      "Clear map bosses and regular endgame",
      "rec-standard-endgame",
      null,
      true,
    ),
    DecisionChoice("uber-pinnacles", "One-shot Uber Pinnacle bosses", "rec-uber-setup"),
  ],
)

recStandardEndgame = DecisionNode(
  "rec-standard-endgame",
  null,
  null,
  DecisionLeaf(
    "Standard endgame setup: 6500 ES, 75% Evasion, CI, Shavronne's, Ailith's Chimes.",
    "For regular endgame, focus on solid defenses and reliable damage. No Uber-specific gear needed.",
