root = Quiz("ทดสอบความรู้การคุมไฟและกายวิภาคเตา Kamado", [q1, q2, q3, q4])

q1 = QuizQuestion(
  "q1",
  "หน้าที่หลักของแผ่นหินกันความร้อน (Ceramic Heat Deflector) ในเตา Kamado คืออะไร?",
  [
    QuizChoice(
      "a",
      "กั้นเปลวไฟตรง แปลงเตาเป็นเตาอบ Convection สำหรับการย่างทางอ้อม (Indirect Cooking)",
      true,
      "ถูกต้อง! Heat Deflector ทำหน้าที่บังเปลวไฟและรังสีความร้อนตรง ทำให้ความร้อนไหลเวียนรอบๆ เหมาะสำหรับ Low & Slow และการอบช่วงแรกของ Reverse Sear",
    ),
    QuizChoice(
      "b",
      "ใช้ดับไฟในกล่อง Firebox ทันทีเมื่อย่างเสร็จ",
      false,
      "ไม่ถูกต้อง แผ่น Deflector ไม่ได้ใช้ดับไฟ แต่ใช้กั้นความร้อนระหว่างกองถ่านกับตะแกรง",
    ),
    QuizChoice(
      "c",
      "เพิ่มอุณหภูมิเปลวไฟให้สูงขึ้นถึง 500°C",
      false,
      "ไม่ถูกต้อง แผ่น Deflector มีไว้กั้นความร้อนตรง ไม่ได้มีหน้าที่เร่งไฟ",
    ),
  ],
  "นึกถึงการจัดโซนความร้อนสำหรับการทำสเต๊กหรือการรมควัน",
)

q2 = QuizQuestion(
  "q2",
  "ในการควบคุมอุณหภูมิเตา Kamado ประตูวาล์วลมล่าง (Bottom Draft Door) มีบทบาทอย่างไร?",
  [
    QuizChoice(
      "a",
      "ใช้ปรับลมขาออกอย่างละเอียดระดับมิลลิเมตร",
      false,
      "การปรับลมขาออกละเอียดระดับมิลลิเมตรเป็นหน้าที่ของ Top Vent ด้านบน",
    ),
    QuizChoice(
      "b",
      "เป็นช่องรับออกซิเจนหลักเข้าสู่กองถ่าน ใช้ควบคุมอุณหภูมิช่วงกว้างแบบหยาบ (Coarse Tuning)",
      true,
      "ถูกต้อง! วาล์วล่างทำหน้าที่ป้อนออกซิเจนเข้าเตา ยิ่งเปิดกว้างออกซิเจนยิ่งเข้ามาก ไฟยิ่งลุกแรง",
    ),
    QuizChoice(
      "c",
      "ใช้ระบายควันขี้เถ้าและไอน้ำออกจากเตา",
      false,
      "ควันและไอน้ำจะระบายออกทางวาล์วด้านบน (Top Vent) ไม่ใช่วาล์วล่าง",
    ),
  ],
  "เปรียบเทียบระหว่างการปรับแบบหยาบกับการปรับแบบละเอียด",
)

q3 = QuizQuestion(
  "q3",
  "ฝาครอบเซรามิกหนาพิเศษ (Ceramic Dome) ช่วยให้สเต๊กสุกสม่ำเสมอได้อย่างไร?",
  [
    QuizChoice(
      "a",
      "ดูดซับความร้อนทั้งหมดแล้วปล่อยให้เตาเย็นลงอย่างรวดเร็ว",
      false,
      "เซรามิกกักเก็บความร้อนสูงและปล่อยออกมาอย่างช้าๆ ต่อเนื่อง ไม่ได้ทำให้เตาเย็นลง",
    ),
    QuizChoice(
      "b",
      "สะท้อนรังสีความร้อนอินฟราเรดกลับลงมาที่ผิวเนื้อ ทำให้เนื้อสุกรอบทิศทางโดยไม่ต้องเปิดฝาบ่อย",
      true,
      "ถูกต้อง! ผนังเซรามิกสะท้อนรังสีความร้อนอินฟราเรดกระจายทั่วห้องเตา ทำให้เนื้อได้รับความร้อนรอบด้านอย่างสม่ำเสมอ",
    ),
    QuizChoice(
      "c",
      "ปล่อยให้น้ำมันหยดลงบนถ่านเพื่อสร้างควันดำ",
      false,
      "ควันดำเกิดจากการเผาไหม้ไม่สมบูรณ์ ไม่ใช่ข้อดีของฝาครอบเซรามิก",
    ),
  ],
  "พิจารณาคุณสมบัติของวัสดุเซรามิกและการสะท้อนความร้อน",
)

q4 = QuizQuestion(
  "q4",
  "หากไม่ทำความสะอาดลิ้นชักรองขี้เถ้า (Ash Drawer) จนขี้เถ้าสะสมเต็มก้นเตา จะเกิดผลเสียใด?",
  [
    QuizChoice(
      "a",
      "ขี้เถ้าจะอุดตันช่องลมเข้า ทำให้ออกซิเจนไหลเวียนไม่สะดวก และคุมอุณหภูมิได้ยาก",
      true,
      "ถูกต้อง! เมื่อขี้เถ้าทับถมปิดช่องอากาศ อากาศบริสุทธิ์จะไม่สามารถไหลผ่านตะแกรงก้นเตาขึ้นมาเลี้ยงกองถ่านได้ ทำให้ไฟหรี่ลงหรือไม่สม่ำเสมอ",
    ),
    QuizChoice(
      "b",
      "ทำให้เนื้อสเต๊กเค็มขึ้นโดยไม่ตั้งใจ",
      false,
      "ขี้เถ้าด้านล่างไม่ได้สัมผัสกับเนื้อโดยตรง",
    ),
    QuizChoice(
      "c",
      "ทำให้ตัวเตาเซรามิกแตกหักในทันที",
      false,
      "ขี้เถ้าไม่ได้ทำให้เซรามิกแตก แต่ทำให้กระแสลมถูกบล็อก",
    ),
  ],
  "คิดถึงสิ่งที่กองถ่านต้องการสำหรับการเผาไหม้",
)
