root = FormulaSandbox(
  "เครื่องคำนวณเวลาและอุณหภูมิสเต๊ก Reverse Sear",
  [
    FormulaVariable("thickness_cm", "ความหนาของเนื้อสเต๊ก (cm)", 2, 8, 0.5, 4),
    FormulaVariable("oven_temp_c", "อุณหภูมิเตาอบทางอ้อม (°C)", 95, 135, 5, 110),
    FormulaVariable(
      "target_doneness_level",
      "ระดับความสุก (1=Rare, 2=Med-Rare, 3=Med, 4=Med-Well)",
      1,
      4,
      1,
      2,
    ),
  ],
  [pullTempC, targetInternalTempC, indirectTimeMin, restingTimeMin],
)

pullTempC = FormulaMetric(
  "pull_temp_c",
  "อุณหภูมิแกนกลางที่ต้องยกเนื้อออกเพื่อเตรียม Sear (°C)",
  "Math.round((46 + (target_doneness_level * 4)) - 4)",
  "อุณหภูมิที่อ่านได้จาก Meat Probe ในช่วงจบการอบทางอ้อม โดยต้องยกออกก่อนถึงความสุกจริง 3-4°C เพื่อเผื่อความร้อนที่จะเพิ่มขึ้นตอน Sear และ Rest",
  "เหมือนการเหยียบเบรกรถก่อนถึงไฟแดงเพื่อไม่ให้ล้ำเส้น",
  [
    "การยกเนื้อออกมาพักชั่วคราวเพื่อรอเตาเร่งอุณหภูมิ Sear",
    "การป้องกันไม่ให้เนื้อสุกเกินระดับเป้าหมาย",
  ],
  ["การย่างสเต๊กบางที่สุกเร็วเกินกว่าจะวัดอุณหภูมิช่วงอบได้"],
)

targetInternalTempC = FormulaMetric(
  "target_internal_temp_c",
  "อุณหภูมิแกนกลางสุดท้ายหลังพักเนื้อ (°C)",
  "Math.round(46 + (target_doneness_level * 4))",
  "อุณหภูมิสุดท้ายของใจกลางเนื้อหลังผ่านการ Sear และกระบวนการ Carryover Cooking ในช่วงพักเนื้อ (Medium Rare อยู่ที่ประมาณ 54°C)",
  "เหมือนเป้าหมายปลายทางที่รถจะหยุดนิ่งพอดี",
  ["การวัดความสุกด้วยโพรบดิจิทัลมาตรฐานสากล"],
  ["การใช้นิ้วกดกะความสุกแบบดั้งเดิมซึ่งไม่แม่นยำสำหรับเนื้อชิ้นหนา"],
)

indirectTimeMin = FormulaMetric(
  "indirect_time_min",
  "เวลาอบทางอ้อมโดยประมาณ (นาที)",
  "Math.round((thickness_cm * 12) * (110 / oven_temp_c) * (0.8 + (target_doneness_level * 0.15)))",
  "ระยะเวลาที่เนื้อต้องอยู่ในเตาช่วงอุณหภูมิ 105-120°C เพื่อให้ความร้อนค่อยๆ ซึมเข้าสู่ใจกลางเนื้ออย่างนุ่มนวล",
  "เหมือนเวลาในการแช่ออนเซ็นให้น้ำอุ่นซึมลึกถึงกล้ามเนื้อ",
  ["การคำนวณเวลาเบื้องต้นเพื่อเตรียมตารางการทำอาหาร"],
  ["การยึดเวลาเป็นตัวตัดสินความสุกแทนการดูอุณหภูมิโพรบจริง"],
)

restingTimeMin = FormulaMetric(
  "resting_time_min",
  "เวลาพักเนื้อที่แนะนำ (นาที)",
  "Math.max(5, Math.round(thickness_cm * 2))",
  "ระยะเวลาวางพักเนื้อหลัง Sear เพื่อให้เส้นใยกล้ามเนื้อคลายตัวและดูดซับของเหลวกลับเข้าสู่เซลล์",
  "เหมือนการให้ฟองน้ำดูดน้ำกลับคืนหลังจากถูกบีบด้วยความร้อน",
  ["การวางพักบนตะแกรงโปร่งในที่อุณหภูมิห้อง"],
  ["การหั่นเนื้อทันทีที่ยกออกจากเตา (จะทำให้น้ำเนื้อไหลทะลักสูญเสียความฉ่ำ)"],
)
