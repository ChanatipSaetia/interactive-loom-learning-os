root = Flashcards(
  "คลังคำศัพท์สำคัญในการย่างเนื้อเตา Kamado",
  [maillardReaction, heatDeflector, blueSmoke, carryoverCooking, theStall, edgeToEdgePink],
)

maillardReaction = Flashcard(
  "maillard-reaction",
  "Maillard Reaction",
  "มาย-ยาร์ด รี-แอก-ชัน",
  "วิทยาศาสตร์อาหาร",
  "ปฏิกิริยาเคมีระหว่างกรดอะมิโนและน้ำตาลโมเลกุลเดี่ยวเมื่อโดนความร้อนสูงกว่า 140°C",
  "กระบวนการสร้างสารประกอบกลิ่นหอมและรสชาติใหม่อีกนับร้อยชนิด ทำให้ผิวนอกของเนื้อเปลี่ยนเป็นสีน้ำตาลทองและเกิดความกรอบหอมอูมามิ",
  "หากไม่มีปฏิกิริยานี้ สเต๊กจะมีรสชาติเหมือนเนื้อต้มและขาดกลิ่นหอมของการย่างไฟ",
  null,
  Dialogue(
    "ทำไมสเต๊กที่ย่างเตา Kamado ถึงมี Crust สีน้ำตาลทองกรอบหอมกว่าเตาแก๊ส?",
    "ผู้ใช้ต้องการเข้าใจกลไกความร้อนสูงของตะแกรงเหล็กหล่อและรังสีอินฟราเรดจากเซรามิกที่เร่งปฏิกิริยาเมลลาร์ด",
    "คุณได้ซับผิวเนื้อให้แห้งสนิทก่อนนำลง Sear หรือไม่ เพราะความชื้นส่วนเกินจะขัดขวางไม่ให้อุณหภูมิผิวแตะ 140°C?",
  ),
)

heatDeflector = Flashcard(
  "heat-deflector",
  "Heat Deflector",
  "ฮีต ดิ-เฟล็ก-เทอร์",
  "อุปกรณ์เตา",
  "แผ่นหินเซรามิกครึ่งวงกลมหรือเต็มวงสำหรับกั้นเปลวไฟตรงจากกองถ่าน",
  "ทำหน้าที่แปลงเตาย่างเปลวไฟให้กลายเป็นเตาอบ Convection ช่วยให้ความร้อนแผ่กระจายรอบตัวเนื้อ เหมาะสำหรับ Low & Slow และช่วงอบของ Reverse Sear",
  "หัวใจสำคัญที่ทำให้เตา Kamado ทำงานได้อเนกประสงค์ทั้งการย่าง อบ รมควัน และทำพิซซ่า",
  null,
  Dialogue(
    "ลืมใส่ Heat Deflector แล้วนำเนื้อ Tomahawk ลงย่าง จะเกิดอะไรขึ้น?",
    "การย่างเนื้อหนาโดยไม่มี Deflector จะทำให้ผิวนอกไหม้เป็นถ่านก่อนที่ข้างในจะสุก",
    "สเต๊กของคุณมีความหนาเกิน 1.5 นิ้วหรือไม่ หากหนาควรยกเนื้อออกแล้วใส่ Deflector ก่อนอบไฟอ่อน",
  ),
)

blueSmoke = Flashcard(
  "blue-smoke",
  "Thin Blue Smoke",
  "ธิน บลู สโมก",
  "การควบคุมไฟ",
  "ควันสีฟ้าใสจางๆ ที่เกิดจากการเผาไหม้ไม้และถ่านไม้อย่างสมบูรณ์และสะอาด",
  "ควันที่ให้กลิ่นหอมหวานละมุน ไร้รสขมฝาด ต่างจากควันสีขาวหนาทึบ (White Acrid Smoke) ซึ่งเต็มไปด้วยเขม่าและน้ำมันดิบที่ทำให้เนื้อมีรสขมเปรี้ยว",
  "สัญญาณบอกว่าเตาและท่อนไม้รมควันพร้อมสำหรับการนำเนื้อลงย่างแล้ว",
  null,
  Dialogue(
    "เพิ่งจุดเตาแล้วควันขาวฟุ้งเต็มไปหมด ใส่เนื้อลงไปได้เลยไหม?",
    "ควันขาวในช่วงแรกมีสารระเหยที่เป็นกรดและเขม่าดำ ซึ่งจะทำให้เนื้อเสียรสชาติ",
    "คุณสามารถรออีกประมาณ 15-20 นาทีให้ควันขาวเปลี่ยนเป็นควันสีฟ้าใสก่อนวางเนื้อได้หรือไม่?",
  ),
)

carryoverCooking = Flashcard(
  "carryover-cooking",
  "Carryover Cooking",
  "แคร์-รี-โอ-เวอร์ คุก-กิง",
  "เทคนิคการปรุง",
  "ปรากฏการณ์ที่อุณหภูมิแกนกลางเนื้อยังคงเพิ่มขึ้นต่อเนื่องแม้จะยกออกจากเตาแล้ว",
  "ความร้อนที่สะสมอยู่ที่ผิวนอกจะยังคงนำพาความร้อนซึมลึกเข้าสู่แกนกลางอย่างช้าๆ ทำให้อุณหภูมิแกนกลางเพิ่มขึ้นอีกประมาณ 2-4°C ในช่วงพักเนื้อ",
  "ต้องยกเนื้อออกจากเตาก่อนถึงอุณหภูมิเป้าหมายเสมอ มิฉะนั้นเนื้อจะสุกเกิน (Overcooked)",
  null,
  Dialogue(
    "ต้องการสเต๊ก Medium Rare ที่ 54°C ควรยกเนื้อออกจากเตาที่อุณหภูมิเท่าใด?",
    "ต้องคำนวณเผื่อความร้อนแฝง Carryover Cooking ประมาณ 3-4°C",
    "คุณควรยกเนื้อออกจากเตาที่ 50-51°C แล้วปล่อยให้ความร้อนแฝงดันอุณหภูมิไปแตะ 54°C ระหว่างพักเนื้อ",
  ),
)

theStall = Flashcard(
  "the-stall",
  "The BBQ Stall",
  "เดอะ สตอลล์",
  "วิทยาศาสตร์อาหาร",
  "ภาวะที่อุณหภูมิแกนกลางของเนื้อหยุดนิ่งอยู่ที่ช่วง 65-75°C เป็นเวลานานหลายชั่วโมง",
  "เกิดจากการระเหยของน้ำออกจากผิวเนื้อ (Evaporative Cooling) ซึ่งดึงความร้อนออกไปในอัตราเดียวกับที่เตาป้อนความร้อนเข้ามา",
  "เป็นปรากฏการณ์ธรรมชาติในการทำ Brisket ไม่ควรตกใจเร่งไฟ แต่สามารถแก้ด้วยการห่อฟอยล์หรือ Butcher Paper (Texas Crutch)",
  null,
  Dialogue(
    "รมควันเนื้อ Brisket มา 4 ชั่วโมงแล้ว อุณหภูมิค้างอยู่ที่ 70°C ไม่ขยับเลย เตาดับหรือเปล่า?",
    "เนื้อกำลังเข้าสู่ช่วง Stall จากการระเหยของความชื้น",
    "คุณต้องการห่อเนื้อด้วย Butcher Paper เพื่อกักเก็บความชื้นและเร่งให้ข้ามช่วง Stall หรือไม่?",
  ),
)

