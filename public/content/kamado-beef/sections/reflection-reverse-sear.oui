root = ReflectionSequence("ลำดับขั้นตอนการย่างแบบ Reverse Sear", [challenge1])

challenge1 = SequenceChallenge(
  "เรียงลำดับขั้นตอนการทำสเต๊กแบบ Reverse Sear บนเตา Kamado ให้ถูกต้องตามกระบวนการทำลายขอบเทา (Edge-to-edge pink):",
  [stepPrepSetup, stepProbeIndirect, stepBakeTarget, stepRestStoke, stepHighSear, stepFinalRest],
  [stepPrepSetup, stepProbeIndirect, stepBakeTarget, stepRestStoke, stepHighSear, stepFinalRest],
)

stepPrepSetup = SequenceItem(
  "step-prep-setup",
  "1. ปรุงรสเนื้อสเต๊กหนา และเตรียมเตา Kamado ใส่แผ่น Heat Deflector คุมไฟที่ 105-120°C",
)

stepProbeIndirect = SequenceItem(
  "step-probe-indirect",
  "2. วางเนื้อลงบนตะแกรง เสียบโพรบวัดอุณหภูมิแกนกลาง และปิดฝาครอบเซรามิก",
)

stepBakeTarget = SequenceItem(
  "step-bake-target",
  "3. อบเนื้อด้วยความร้อนทางอ้อมอย่างช้าๆ จนอุณหภูมิแกนกลางถึงประมาณ 45-48°C",
)

stepRestStoke = SequenceItem(
  "step-rest-stoke",
  "4. ยกเนื้อออกมาพักชั่วคราว ถอดแผ่น Deflector และเปิดวาล์วลมเร่งอุณหภูมิเตาขึ้นสู่ 300-350°C",
)

stepHighSear = SequenceItem(
  "step-high-sear",
  "5. นำเนื้อลง Sear บนเปลวไฟแรงจัดด้านละ 45-60 วินาที เพื่อสร้าง Crust สีน้ำตาลทอง (Maillard Reaction)",
)

stepFinalRest = SequenceItem(
  "step-final-rest",
  "6. นำเนื้อขึ้นมาพัก (Resting) 5-10 นาที เพื่อให้น้ำในเนื้อกระจายตัวสม่ำเสมอก่อนหั่นเสิร์ฟ",
)
