root = TaxonomyBrowser(
  "หมวดหมู่เทคนิคการย่างเนื้อบนเตา Kamado",
  [reverseSear, lowSlowSmoking, directHighHeatGrilling, cavemanStyle],
)

reverseSear = TaxonomyCategory(
  "Reverse Sear (ย่างย้อนศร)",
  "เทคนิคที่ดีที่สุดสำหรับสเต๊กชิ้นหนา (1.5 - 3 นิ้ว)",
  "Flame",
  "red",
  "อบเนื้อด้วยความร้อนทางอ้อม (Indirect Low Heat 105-120°C) จนอุณหภูมิแกนกลางใกล้ถึงเป้าหมาย แล้วพักเนื้อก่อนนำมา Sear ผิวไฟแรงสุด (300-350°C) 45-60 วินาทีต่อด้าน",
  "ช่วยขจัดปัญหาขอบเนื้อสุกเกินจนกลายเป็นสีเทา (Grey Band) ทำให้ได้เนื้อในสีชมพูสม่ำเสมอตั้งแต่ขอบจรดขอบ (Edge-to-edge pink) พร้อมผิวกรอบสีน้ำตาลเข้มจาก Maillard Reaction",
  "เหมือนการอุ่นเค้กให้ร้อนทั่วถึงจากข้างในก่อนแล้วค่อยพ่นไฟเคลือบน้ำตาลด้านบน",
  "การควบคุมอุณหภูมิแกนกลาง (Internal Temp) และการสร้าง Crust กรอบโดยไม่ทำลายความฉ่ำ",
  [
    "สเต๊กเนื้อหนา เช่น Tomahawk, Cowboy Ribeye, Thick T-Bone, Picanha Block",
    "การใช้แผ่น Ceramic Heat Deflector ในช่วงแรก",
    "การใช้โพรบวัดอุณหภูมิเนื้อ (Meat Probe) ตรวจสอบความสุก",
  ],
  [
    "สเต๊กบางต่ำกว่า 1 นิ้ว (เสี่ยงสุกเกินไปในช่วง Sear)",
    "เนื้อส่วนที่มีพังผืดเหนียวมากที่ต้องใช้เวลาละลายคอลลาเจนหลายชั่วโมง",
  ],
)

lowSlowSmoking = TaxonomyCategory(
  "Low & Slow Smoking (รมควันไฟอ่อนระยะยาว)",
  "ศิลปะการปรุงเนื้อส่วนเหนียวและคอลลาเจนสูง",
  "Wind",
  "peach",
  "รมควันเนื้อที่อุณหภูมิคงที่ 105-120°C ต่อเนื่องเป็นเวลา 6-12 ชั่วโมง โดยใส่แผ่น Heat Deflector เต็มแผ่นพร้อมท่อนไม้รมควัน (Wood Chunks)",
  "ความร้อนต่ำและเวลาที่ยาวนานจะค่อยๆ สลายเส้นใยคอลลาเจน (Collagen) ให้กลายเป็นเจลาติน (Gelatin) ที่นุ่มชุ่มฉ่ำ พร้อมสร้างเปลือก Bark สีดำเข้มที่มีกลิ่นหอมรมควันอันเป็นเอกลักษณ์",
  "เหมือนการตุ๋นหม้อเซรามิกโบราณแต่ใช้อากาศร้อนและควันหอมเป็นตัวปรุงแทนน้ำซุป",
  "การสลายคอลลาเจน, การคุมความชื้น (Moisture Retention), และการก้าวข้ามช่วงอุณหภูมิชะงัก (The BBQ Stall)",
  [
    "เนื้อเสือร้องไห้/เนื้ออก (Beef Brisket)",
    "ซี่โครงเนื้อชิ้นโต (Beef Short Ribs / Dinosaur Ribs)",
    "เนื้อสันคอ/น่องลาย (Beef Chuck Roast)",
  ],
  [
    "สเต๊กเนื้อนุ่มพรีเมียมอย่าง Tenderloin หรือ Flat Iron",
    "การปรุงด่วนที่ต้องการรับประทานภายใน 30 นาที",
  ],
)

directHighHeatGrilling = TaxonomyCategory(
  "Direct High-Heat Grilling (ย่างไฟแรงตรง)",
  "ย่างด่วนบนเปลวไฟและตะแกรงเหล็กหล่อ 250-350°C",
  "Zap",
  "mauve",
  "ย่างชิ้นเนื้อบนเปลวถ่านโดยตรงโดยไม่ใส่แผ่น Heat Deflector โดยอาศัยความร้อนจากการแผ่รังสีและตะแกรงเหล็กหล่อสะสมความร้อน",
  "เหมาะสำหรับชิ้นเนื้อที่นุ่มโดยธรรมชาติแต่มีความหนาปานกลางถึงบาง ใช้เวลาสั้น พลิกกลับด้านรวดเร็วเพื่อสร้างลวดลายกริลล์ (Grill Marks) และกลิ่นเกรียมหอมหวานของไขมันที่หยดลงถ่าน",
  "เหมือนการย่างยากินิกุหรือเนื้อเสียบไม้แบบญี่ปุ่นด้วยเตาชิจิรินแต่พลังความร้อนสูงกว่า",
  "การสร้างเปลือกเกรียมรวดเร็ว, การป้องกันเนื้อสุกเกินไปข้างใน, และการควบคุมไฟลุก (Flare-ups)",
  [
    "สเต๊กเนื้อบางต่ำกว่า 1.2 นิ้ว (Thin Ribeye / Striploin)",
    "เนื้อใบบัว/เนื้อชายโครง (Skirt Steak / Flank Steak)",
    "เนื้อลูกเต๋าเสียบไม้ คุชิยากิ (Beef Skewers / Kebabs)",
  ],
  [
    "สเต๊กหนาพิเศษ เช่น Tomahawk (ข้างในจะยังดิบเย็นขณะที่ผิวนอกไหม้)",
    "เนื้อ Brisket ทั้งก้อน (จะเหนียวเคี้ยวไม่ได้)",
  ],
)

cavemanStyle = TaxonomyCategory(
  "Caveman Style (ย่างบนถ่านไม้ธรรมชาติโดยตรง)",
  "Dirty Steak - สัมผัสถ่านไม้ก้อนแดงฉานแบบคนยุคหิน",
  "Sparkles",
  "teal",
  "วางชิ้นเนื้อหนาลงบนก้อนถ่านไม้ธรรมชาติ (Natural Hardwood Lump Charcoal) ที่คุแดงไร้เปลวไฟโดยตรง โดยไม่ใช้ตะแกรงย่าง",
  "อาศัยการนำความร้อนแบบสัมผัสโดยตรง (Direct Conduction) ก่อให้เกิดเปลือก Crust ที่กรอบเกรียมลึก มีกลิ่นหอมเฉพาะตัว เถ้าถ่านธรรมชาติแท้จะไม่ติดเนื้อเมื่อปัดออกเล็กน้อย",
  "เหมือนการประทับตราเหล็กร้อนลงบนแผ่นหนังอย่างรวดเร็วและทรงพลัง",
  "การเลือกถ่านไม้เนื้อแข็งแท้คุณภาพพรีเมียมไร้สารเคมี, การพัดขี้เถ้าส่วนเกินออกก่อนวางเนื้อ, และการกลับด้านรวดเร็ว",
  [
    "เนื้อสเต๊กชิ้นหนา เช่น T-Bone, Porterhouse, Ribeye Cap",
    "ถ่านไม้ธรรมชาติก้อนใหญ่ (Hardwood Lump Charcoal) คุณภาพสูงเท่านั้น",
  ],
  [
    "การใช้ถ่านอัดก้อน (Briquettes) ที่มีสารประสานทางเคมีและขี้เถ้าหนา (อันตรายต่อสุขภาพ)",
    "เนื้อบางหรือเนื้อหมักซอสหวาน (จะไหม้ดำทันที)",
  ],
)
