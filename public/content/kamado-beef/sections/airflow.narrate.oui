root = Narration([title, head, door, coals, deflector, grate, dome, vent, flow, rule])
title = NarrationStep("title", "ผังชั้นเมื่อครู่บอกว่าเตามีชิ้นส่วนอะไรบ้าง คราวนี้มาดูว่าลมเดินผ่านชิ้นส่วนเหล่านั้นอย่างไร")
head = NarrationStep("part1", "เตา Kamado ทำงานเหมือนปล่องไฟ อากาศร้อนลอยขึ้น และดึงอากาศเย็นตามเข้ามาจากด้านล่าง", [Highlight("header")])
door = NarrationStep("part2", "ทุกอย่างเริ่มที่ประตูลมล่าง ช่องเดียวที่ออกซิเจนเข้าสู่เตาได้", [Highlight("kamado.draft-door")])
coals = NarrationStep("part2", "ออกซิเจนวิ่งตรงเข้าหากองถ่าน ยิ่งลมเข้ามาก ถ่านยิ่งลุกแรง", [Spotlight(["kamado.coals", "kamado.firebox"])])
deflector = NarrationStep("part2", "เหนือกองถ่านคือแผ่น Deflector ที่บังไม่ให้ความร้อนพุ่งตรงขึ้นไปหาเนื้อ", [Callout("kamado.deflector", "ลมร้อนต้องอ้อมขอบแผ่นออกไป เตาจึงกลายเป็นเตาอบ Convection")])
grate = NarrationStep("part2", "เนื้อบนตะแกรงจึงสุกจากลมร้อนที่โอบรอบ ไม่ใช่จากเปลวไฟตรง", [Highlight("kamado.steak")])
dome = NarrationStep("part2", null, [Callout("kamado.dome", "ผนังเซรามิกหนาเก็บความร้อนและสะท้อนกลับลงมาที่เนื้อ อุณหภูมิจึงนิ่ง")])
vent = NarrationStep("part2", "สุดท้ายไอร้อนออกทางวาล์วบน วาล์วนี้ตัดสินว่าลมทั้งสายไหลเร็วแค่ไหน", [Highlight("kamado.top-vent")])
flow = NarrationStep("part2", "ดูเส้นทางทั้งหมดอีกครั้ง เข้าล่าง ผ่านไฟ อ้อมแผ่นกั้น แล้วออกบน", [Spotlight(["kamado.airflow"])])
rule = NarrationStep("part3", "จำง่ายๆ ประตูล่างปรับหยาบ วาล์วบนปรับละเอียด", [Highlight("rule")])
