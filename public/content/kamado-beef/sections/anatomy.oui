root = PillarLayer(
  "โครงสร้างและกายวิภาคของเตา Kamado",
  [lDomeExhaust, lCookingZone, lFireboxCore, lBaseDraft],
  [bTopVent, bCeramicDome, bGrillGrate, bDeflector, bFirebox, bFireRing, bDraftDoor, bAshDrawer],
  "โครงสร้างแบบเป็นชั้นของเตา Kamado แสดงการถ่ายเทความร้อน การกักเก็บพลังงาน และการควบคุมการไหลเวียนอากาศ",
  "กายวิภาคและสถาปัตยกรรมเตาเซรามิก Kamado (Kamado Anatomy Stack)",
)

lDomeExhaust = Layer(
  "l-dome-exhaust",
  "1. ชั้นควบคุมไอเสียและกักเก็บความร้อนด้านบน (Top Exhaust & Dome Tier)",
  "วาล์วด้านบนและฝาครอบเซรามิกหนา ทำหน้าที่กักเก็บรังสีความร้อนและคุมการระบายไอเสีย",
)

lCookingZone = Layer(
  "l-cooking-zone",
  "2. ชั้นตะแกรงย่างและจัดโซนความร้อน (Cooking Grates & Deflector Tier)",
  "พื้นที่วางเนื้อสเต๊ก ตะแกรงเหล็กหล่อ/สเตนเลส และแผ่นหิน Deflector สำหรับกระจายความร้อนทางอ้อม",
)

lFireboxCore = Layer(
  "l-firebox-core",
  "3. ชั้นกล่องเผาไหม้และศูนย์รวมถ่าน (Firebox & Fire Ring Tier)",
  "ห้องเซรามิกทนความร้อนสูงสำหรับบรรจุถ่านไม้ธรรมชาติ มีรูระบายอากาศเพื่อกระจายออกซิเจน",
)

lBaseDraft = Layer(
  "l-base-draft",
  "4. ชั้นฐานรองและประตูรับอากาศเข้าล่าง (Base & Draft Door Tier)",
  "ช่องดึงอากาศบริสุทธิ์เข้าด้านล่างเพื่อป้อนออกซิเจนให้ไฟ และลิ้นชักสำหรับดักขี้เถ้า",
)

bTopVent = MatrixBlock(
  "b-top-vent",
  "วาล์วปรับลมบน (Top Vent / Dual-Disc)",
  lDomeExhaust,
  0,
  2,
  null,
  "ควบคุมความเร็วลมขาออกและดักความร้อน ละเอียดระดับมิลลิเมตรเพื่อปรับอุณหภูมิละเอียด (Fine-tuning)",
  "mauve",
  ["b-grill-grate"],
)

bCeramicDome = MatrixBlock(
  "b-ceramic-dome",
  "ฝาครอบเซรามิกหนาพิเศษ (Ceramic Heavy Dome)",
  lDomeExhaust,
  2,
  2,
  null,
  "ผนังเซรามิกสะท้อนรังสีความร้อนอินฟราเรดกลับลงมาที่ผิวเนื้อ ทำให้เนื้อสุกรอบทิศทางโดยไม่ต้องเปิดฝาบ่อย",
  "blue",
  ["b-deflector"],
)

bGrillGrate = MatrixBlock(
  "b-grill-grate",
  "ตะแกรงย่างเหล็กหล่อ/สเตนเลส (Cooking Grate)",
  lCookingZone,
  0,
  2,
  null,
  "รองรับเนื้อวัว สามารถเลือกใช้เหล็กหล่อเพื่อสะสมความร้อนสำหรับ Sear ลายสวยงาม",
  "peach",
  ["b-firebox"],
)

bDeflector = MatrixBlock(
  "b-deflector",
  "แผ่นหินกันความร้อน (Ceramic Heat Deflector)",
  lCookingZone,
  2,
  2,
  null,
  "แปลงเตาย่างเปลวไฟตรงให้กลายเป็นเตาอบ Convection กั้นเปลวไฟตรงเพื่อย่างทางอ้อม (Indirect Smoking / Reverse Sear)",
  "teal",
  ["b-fire-ring"],
)

bFirebox = MatrixBlock(
  "b-firebox",
