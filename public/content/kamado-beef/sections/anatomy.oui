  2,
  null,
  "จุดรับออกซิเจนหลักเข้าสู่เตา ทำหน้าที่ควบคุมอุณหภูมิหยาบ (Coarse tuning) เปิดกว้างเพื่อเร่งไฟ หรี่เพื่อลดไฟ",
  "maroon",
)

bAshDrawer = MatrixBlock(
  "b-ash-drawer",
  "ลิ้นชักรองขี้เถ้า (Ash Drawer / Base Cavity)",
  lBaseDraft,
