  2,
  null,
  "บรรจุถ่านไม้ก้อนธรรมชาติ ผนังมีรูเจาะระบายอากาศเพื่อกระจายออกซิเจนเข้าสู่กองถ่านอย่างสม่ำเสมอ",
  "sapphire",
  ["b-draft-door"],
)

bFireRing = MatrixBlock(
  "b-fire-ring",
  "วงแหวนยกความสูง (Fire Ring)",
  lFireboxCore,
  2,
  2,
  null,
  "วางซ้อนบน Firebox เพื่อเพิ่มระยะห่างระหว่างกองถ่านกับตะแกรงย่าง และเป็นฐานรองรับแผ่น Heat Deflector",
  "green",
  ["b-ash-drawer"],
)

bDraftDoor = MatrixBlock(
  "b-draft-door",
  "ประตูวาล์วลมล่าง (Bottom Draft Door)",
  lBaseDraft,
