root = Scenario(
  "สถานการณ์กอบกู้เตา Kamado ความร้อนพุ่งเกิน (Overheat)",
  "overheat-crisis",
  [
    start,
    branchOpenDome,
    outcomeChokeSuccess,
    outcomeLateSeal,
    outcomeRuinedSteak,
    outcomeWaterDisaster,
  ],
  "คุณกำลังเตรียมย่าง Tomahawk หนา 2.5 นิ้วด้วยวิธี Reverse Sear ที่ต้องการอุณหภูมิ 110°C แต่เผลอเปิดวาล์วทิ้งไว้จนกลับมาดูอีกที เข็มวัดความร้อนพุ่งทะลุ 230°C และมวลเซรามิกกำลังดูดซับความร้อนมหาศาล!",
  null,
  "วิกฤตความร้อนเตาพุ่งเกิน (The Runaway Temperature Crisis)",
)

start = ScenarioNode(
  "start",
  "อุณหภูมิเตาพุ่งไปที่ 230°C ในขณะที่คุณยังไม่ได้ใส่เนื้อ คุณจะตัดสินใจทำสิ่งใดเป็นอันดับแรก?",
  [
    ScenarioChoice(
      "choke_vents_wait",
      "หรี่วาล์วล่างเหลือ 2 มม. และวาล์วบนเกือบปิดสนิทเพื่อตัดออกซิเจน รอให้ความร้อนเซรามิกค่อยๆ ถ่ายเทลงมา",
      "outcome_choke_success",
    ),
    ScenarioChoice(
      "open_dome_wide",
      "เปิดฝาครอบเซรามิกอ้าทิ้งไว้กว้างๆ เพื่อหวังให้ความร้อนระบายออกสู่อากาศภายนอกอย่างรวดเร็ว",
      "branch_open_dome",
    ),
    ScenarioChoice(
      "spray_water_fire",
      "เปิดฝาแล้วนำฟ็อกกี้ฉีดน้ำใส่กองถ่านและแผ่นเซรามิกเพื่อดับความร้อนทันที",
      "outcome_water_disaster",
    ),
  ],
)

branchOpenDome = ScenarioNode(
  "branch_open_dome",
  "เมื่อคุณเปิดฝาค้างไว้ ออกซิเจนปริมาณมหาศาลไหลกรูเข้าสู่กองถ่าน ทำให้ถ่านไม้ธรรมชาติลุกไหม้เป็นเปลวไฟสีส้มรุนแรง คุณจะแก้ไขอย่างไรต่อ?",
  [
    ScenarioChoice(
      "close_and_seal",
      "รีบปิดฝาลงทันที และปิดวาล์วล่างให้สนิทเพื่อตัดออกซิเจนก่อนที่เปลวไฟจะลาม",
      "outcome_late_seal",
    ),
    ScenarioChoice(
      "put_meat_in",
      "ตัดสินใจใส่เนื้อลงไปย่างทันทีเพราะคิดว่าไหนๆ ไฟก็แรงแล้ว",
      "outcome_ruined_steak",
    ),
  ],
)

outcomeChokeSuccess = ScenarioNode(
  "outcome_choke_success",
  null,
  null,
  Outcome(
    "คุณควบคุมสถานการณ์ได้อย่างยอดเยี่ยมและเข้าใจธรรมชาติของมวลเซรามิก!",
    "เตา Kamado ควบคุมด้วยออกซิเจน การหรี่วาล์วเกือบสนิทจะทำให้กองถ่านสงบลง แม้เซรามิกจะคายความร้อนช้า (ใช้เวลา ~20-30 นาที) แต่จะทำให้อุณหภูมิกลับมาคงที่ 110°C ได้อย่างปลอดภัยโดยเนื้อไม่เสียหาย",
    "a",
  ),
)

outcomeLateSeal = ScenarioNode(
  "outcome_late_seal",
  null,
  null,
  Outcome(
    "กอบกู้ได้บางส่วน แต่เสียเวลาและเปลืองถ่านโดยไม่จำเป็น",
    "การเปิดฝาเตา Kamado ทิ้งไว้ไม่ได้ช่วยระบายความร้อน แต่เป็นการเติมเชื้อไฟให้ถ่านลุกแรงขึ้น เมื่อปิดฝาจึงต้องใช้เวลานานขึ้นเป็นสองเท่ากว่าเตาจะเย็นลง",
    "b-plus",
  ),
)

outcomeRuinedSteak = ScenarioNode(
  "outcome_ruined_steak",
  null,
  null,
  Outcome(
    "สเต๊ก Tomahawk ชิ้นหนาของคุณไหม้เกรียมด้านนอกแต่ด้านในยังดิบเย็นจัด",
    "การใส่เนื้อหนาลงในเตาที่ร้อนจัดโดยไม่มีการอบไฟอ่อนทางอ้อม จะทำลายโครงสร้างเนื้อ เกิด Grey Band หนาเตอะ และสูญเสียเนื้อพรีเมียมราคาแพง",
    "c",
  ),
)

outcomeWaterDisaster = ScenarioNode(
  "outcome_water_disaster",
  null,
  null,
  Outcome(
    "หายนะ! เตาเซรามิกเกิดภาวะช็อกความร้อน (Thermal Shock) และขี้เถ้าฟุ้งกระจาย",
    "ห้ามฉีดน้ำหรือสาดน้ำลงในเตาเซรามิก Kamado ที่ร้อนจัดโดยเด็ดขาด เพราะความแตกต่างของอุณหภูมิจะทำให้เซรามิกแตกร้าวเสียหายถาวร และทำให้เถ้าถ่านฟุ้งติดเตา",
    "c",
  ),
)
