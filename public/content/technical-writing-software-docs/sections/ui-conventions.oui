root = TaxonomyBrowser(
  "UI Text Conventions",
  [
    boldUiLabelsExactlyAsShown,
    locationBeforeAction,
    menuPathsWith,
    inputFormatting,
    consistentDeviceNeutralVerbs,
  ],
)

boldUiLabelsExactlyAsShown = TaxonomyCategory(
  "Bold UI Labels, Exactly as Shown",
  "**Save**, not \"save\" or 'the save button'",
  "Bold",
  "mauve",
  "Write UI labels in bold, spelled and capitalised exactly as they appear on screen.",
  "Readers scan the page, then scan the screen for the same word. Bold makes the label stand out in the text, and exact spelling and capitalisation let them match it instantly. If the button says Save changes, write **Save changes**, not 'save' or 'the Save Changes button'. When the UI label changes in a release, the doc must change too.",
  "Station names on a train map match the signs on the platform letter for letter.",
  "Instant matching between page and screen",
  ["Buttons, menu items, tabs, field names, page titles"],
  ["Text the user types (see Input Formatting)"],
)

locationBeforeAction = TaxonomyCategory(
  "Location Before Action",
  "Where, then what",
  "MapPin",
  "sky",
  "State where before what: 'In the Settings pane, select Save' so the reader looks in the right place first.",
  "If the sentence says 'Select Save in the Settings pane', the reader may click the first Save they see, and there are often several. Putting the location first tells their eyes where to go before telling their hand what to do. The same applies to conditions: 'If you see an error, select Retry' rather than 'Select Retry if you see an error'.",
  "'At the second traffic light, turn left', not 'turn left at the second traffic light', when there are lefts everywhere.",
  "Guiding the eye before the hand",
  ["Panes, dialogs, tabs, regions of the page", "Conditions before instructions"],
  ["Multi-level menus (see Menu Paths)"],
)

menuPathsWith = TaxonomyCategory(
  "Menu Paths with >",
  "File > Export > PDF",
  "ChevronsRight",
  "teal",
  "Write menu paths with a > separator, e.g. File > Export > PDF.",
  "A menu path compresses several clicks into one readable line: **File** > **Export** > **PDF**. Each item stays bold, and the > shows the order. Use it for straightforward menu navigation; if something happens between the clicks, such as a dialog, write separate steps instead.",
  "A folder path on your computer: Documents > Reports > 2026.",
  "Compact, unambiguous navigation",
  ["Nested menus and settings navigation"],
  ["Steps where a dialog or choice happens in between"],
)

inputFormatting = TaxonomyCategory(
  "Input Formatting",
  "`monospace` for what users type",
  "Terminal",
  "green",
  "Format text the user types, code and file names in monospace, separate from UI labels.",
  "Readers must be able to tell 'click this' from 'type this'. In the **Name** field, enter `Q3-budget`. The bold word is on the screen; the monospace word goes into it. Monospace also shows exact characters (spaces, dashes, capital letters) that matter when typing, and it's the standard for file names like `claims.xlsx` and commands.",
  "The difference between the label on a form and what you write in the box.",
  "Separating what you see from what you type",
  ["Values to type, file names, code and commands"],
  ["UI labels (these are bold)"],
)

consistentDeviceNeutralVerbs = TaxonomyCategory(
  "Consistent, Device-Neutral Verbs",
  "select · enter · choose, used the same way everywhere",
  "Repeat",
  "yellow",
  "Pick device-neutral verbs such as 'select' and 'enter' (as the Microsoft style guide recommends) and use them consistently.",
  "Web apps are used with mouse, touch and keyboard, so 'click' doesn't fit everyone; the Microsoft style guide recommends 'select'. The Google developer style guide still uses 'click' for mouse actions. Either can work; what matters is choosing one set of verbs in your house style and using it the same way on every page, so readers don't wonder whether 'press', 'hit' and 'click' mean different things.",
  "A referee who uses the same whistle for the same foul every time.",
  "One verb, one meaning",
  ["Verbs for selecting, entering, choosing", "Recording the choice in the house style"],
  ["Mixing 'click', 'press', 'hit' and 'tap' for the same action"],
)
