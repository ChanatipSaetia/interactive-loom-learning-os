root = DecisionTree(
  "ทุเรียนทอดแบบไหนเหมาะกับคุณ?",
  "durian-advisor",
  "experience",
  [
    experience,
    tastePrefBeginner,
    tastePrefPro,
    recPlain,
    recPlainSugar,
    recPalmSugarChanee,
    recDeepFry,
  ],
  "ที่ปรึกษาทุเรียนทอด",
  null,
  Lead(
    "ตอบคำถามเพื่อรับคำแนะนำว่าทุเรียนทอดแบบไหนเหมาะกับคุณที่สุด",
    "เลือกสูตรที่เหมาะกับรสนิยมและความสามารถ",
    "จบแล้ว — กลับไปเริ่มใหม่หรือลองทำเลย!",
  ),
)

experience = DecisionNode(
  "experience",
  "คุณมีประสบการณ์ในการทำอาหารมากน้อยแค่ไหน?",
  [
    DecisionChoice(
      "beginner",
      "มือใหม่ — ไม่เคยทำ",
      "taste_pref_beginner",
      "เริ่มจากสูตรง่ายๆ ก่อน",
      true,
    ),
    DecisionChoice("experienced", "เคยทำ —有经验", "taste_pref_pro", "ลองสูตรที่ซับซ้อนขึ้น"),
  ],
)

tastePrefBeginner = DecisionNode(
  "taste_pref_beginner",
  "คุณชอบรสชาติแบบไหน?",
  [
    DecisionChoice("sweet", "ชอบหวาน", "rec_plain_sugar", "หวานกรอบคือทางที่ง่ายและอร่อย"),
    DecisionChoice("natural", "ชอบรสธรรมชาติ", "rec_plain", "แบบเปล่ายิ่งง่ายที่สุด"),
  ],
)

tastePrefPro = DecisionNode(
  "taste_pref_pro",
  "คุณอยากได้ทุเรียนทอดแบบไหน?",
  [
    DecisionChoice(
      "premium",
      "รสจัด สีสวย ระดับพรีเมียม",
      "rec_palm_sugar_chanee",
      "ชะนี+น้ำตาลปี๊บ = รสเข้มข้นระดับท็อป",
    ),
    DecisionChoice("crunchy", "กรอบที่สุด", "rec_deep_fry", "ทอดน้ำมันท่วมกรอบทุกด้าน"),
  ],
)

recPlain = DecisionNode(
  "rec_plain",
  null,
  null,
  DecisionLeaf(
    "ทุเรียนทอดเปล่า",
    "เลือกหมอนทองหั่นบาง ทอดในน้ำมันที่เติมน้ำเกลือ ทอดไฟกลางจนสีทอง สะเด็ดน้ำมัน ทานได้เลย ง่ายที่สุด เน้นกลิ่นทุเรียนแท้",
    ["รสชาติเรียบง่าย ไม่หวาน", "กรอบนานเพราะไม่เคลือบ", "เหมาะสำหรับมือใหม่ที่สุด"],
  ),
)

recPlainSugar = DecisionNode(
  "rec_plain_sugar",
  null,
  null,
  DecisionLeaf(
    "ทุเรียนทอดเคลือบน้ำตาลทราย",
    "หมอนทองหั่นบางทอดกรอบ แล้วคลุกน้ำตาลทรายที่熬ละลายบางๆ หวานกรอบอร่อย เป็นสูตรยอดนิยม ทำไม่ยาก",
    ["ความหวานเพิ่มเข้ามา", "ความกรอบลดลงเล็กน้อยจากน้ำตาล", "เป็นรูปแบบที่คนส่วนใหญ่ชอบ"],
  ),
)

recPalmSugarChanee = DecisionNode(
  "rec_palm_sugar_chanee",
  null,
  null,
  DecisionLeaf(
    "ทุเรียนชะนีทอดเคลือบน้ำตาลปี๊บ",
    "ใช้ทุเรียนชะนีที่กลิ่นหอมจัด ทอดกรอบแล้วเคลือบน้ำตาลปี๊บ熬ละลาย ได้ทุเรียนทอดรสเข้มข้น สีน้ำตาลทองสวย เป็นระดับพรีเมียม",
    [
      "ทำยากกว่า ต้องควบคุม熬น้ำตาลปี๊บ",
      "ชะนีหาซื้อยากกว่าหมอนทอง",
      "ความกรอบน้อยกว่าเพราะน้ำตาลปี๊บมีความชื้น",
    ],
  ),
)

recDeepFry = DecisionNode(
  "rec_deep_fry",
  null,
  null,
  DecisionLeaf(
    "ทุเรียนทอดน้ำมันท่วม",
    "หมอนทองหั่นบาง ทอดในน้ำมันที่ท่วมชิ้น 170-180°C กรอบเท่ากันทุกด้าน สะเด็ดน้ำมัน แล้วเคลือบน้ำตาลตามชอบ",
    ["ใช้น้ำมันเยอะ", "กรอบที่สุด", "ต้องระวังอุณหภูมิน้ำมัน"],
  ),
)
