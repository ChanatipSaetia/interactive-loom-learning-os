root = Quiz(
  "ทดสอบความรู้",
  [q1, q2, q3, q4, q5],
  null,
  Lead(
    "ทดสอบความเข้าใจเกี่ยวกับการทำทุเรียนทอด",
    "ตรวจสอบว่าเข้าใจขั้นตอนและเทคนิคเพียงพอหรือยัง",
    "ถัดไป: สำรวจทางเลือกในการตัดสินใจ",
  ),
)

q1 = QuizQuestion(
  "q1",
  "ทุเรียนทอดควรใช้ทุเรียนแบบไหน?",
  [
    QuizChoice("a", "ทุเรียนสุกเต็มผล", false, "ทุเรียนสุกจะนิ่มและเละเมื่อทอด ไม่กรอบ"),
    QuizChoice(
      "b",
      "ทุเรียนดิบหรือทุเรียนอ่อน",
      true,
      "ถูกต้อง! ทุเรียนดิบเนื้อแน่น เมื่อทอดจะกรอบนอกนุ่มใน",
    ),
    QuizChoice(
      "c",
      "ทุเรียนแช่เย็น",
      false,
      "ทุเรียนแช่เย็นอาจมีน้ำแข็งเกาะ ทำให้ทอดแล้วน้ำมันกระเด็น",
    ),
  ],
  "คิดว่าทุเรียนแบบไหนจะกรอบเมื่อทอด",
)

q2 = QuizQuestion(
  "q2",
  "น้ำเกลือช่วยอะไรในการทอดทุเรียน?",
  [
    QuizChoice(
      "a",
      "ทำให้รสชาติเค็มอร่อย",
      false,
      "ไม่ใช่เป้าหมายหลัก — น้ำเกลือใช้ในปริมาณน้อยในกระทะ ไม่ได้เคลือบ",
    ),
    QuizChoice(
      "b",
      "ช่วยให้กรอบนานและไม่ดูดซับน้ำมัน",
      true,
      "ถูกต้อง! น้ำเกลือช่วยสร้างเกราะป้องกันทำให้ทุเรียนกรอบและไม่อมน้ำมัน",
    ),
    QuizChoice("c", "ทำให้สีสวยขึ้น", false, "สีทองมาจากการทอดที่อุณหภูมิเหมาะสม ไม่ใช่จากเกลือ"),
  ],
  "คิดถึงเนื้อสัมผัสและน้ำมัน",
)

q3 = QuizQuestion(
  "q3",
  "อุณหภูมิที่เหมาะสมในการทอดทุเรียน是多少?",
  [
    QuizChoice(
      "a",
      "100-120°C (ไฟเบา)",
      false,
      "อุณหภูมิต่ำเกินไป ทุเรียนจะดูดซับน้ำมันและไม่กรอบ",
    ),
    QuizChoice(
      "b",
      "170-180°C (ไฟกลาง)",
      true,
      "ถูกต้อง! อุณหภูมินี้ทำให้ทุเรียนกรอบทองเหลืองอร่าม",
    ),
    QuizChoice(
      "c",
      "220-250°C (ไฟแรง)",
      false,
      "อุณหภูมิสูงเกินไป ทุเรียนจะไหม้ด้านนอกแต่ข้างในยังไม่กรอบ",
    ),
  ],
  "ไฟกลาง ไม่แรงเกินไปไม่เบาเกินไป",
)

q4 = QuizQuestion(
  "q4",
  "เจมุดเจมุดทุเรียนต่างจากทุเรียนทอดธรรมดาอย่างไร?",
  [
    QuizChoice(
      "a",
      "ใช้ทุเรียนสุกบดผสมกับแป้ง",
      true,
      "ถูกต้อง! เจมุดเจมุดใช้ทุเรียนสุกบดผสมแป้งแล้วคลึงทอด",
    ),
    QuizChoice(
      "b",
      "ทอดในน้ำมันมากกว่า",
      false,
      "ปริมาณน้ำมันไม่ต่างกัน ความต่างอยู่ที่วัตถุดิบและวิธีการเตรียม",
    ),
    QuizChoice("c", "ไม่ใช้น้ำตาล", false, "เจมุดเจมุดมีส่วนผสมของน้ำตาลในแป้ง"),
  ],
  "คิดว่าวัตถุดิบหลักต่างกัน",
)

q5 = QuizQuestion(
  "q5",
  "พันธุ์ทุเรียนอะไรเหมาะสำหรับทำทุเรียนทอดมากที่สุด?",
  [
    QuizChoice(
      "a",
      "หมอนทอง (Monthong)",
      true,
      "ถูกต้อง! หมอนทองมีเนื้อเยอะ เมล็ดเล็ก และหาได้ง่าย",
    ),
    QuizChoice("b", "หมากขี้หอย", false, "หมากขี้หอยเนื้อน้อย เมล็ดใหญ่ ไม่คุ้มค่าสำหรับทอด"),
    QuizChoice("c", "กระดุม", false, "กระดุมมีขนาดเล็ก เนื้อน้อย ไม่เหมาะสำหรับหั่นชิ้นทอด"),
  ],
  "พันธุ์ที่เนื้อเยอะ เมล็ดเล็ก",
)
