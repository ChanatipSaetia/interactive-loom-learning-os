root = TradeoffSandbox(
  "ทางเลือกในการทอดทุเรียน",
  [durianChoice],
  null,
  Lead(
    "ทดลองตัดสินใจเลือกวิธีการทำทุเรียนทอด",
    "เข้าใจว่าการเลือกแต่ละอย่างส่งผลต่อผลลัพธ์อย่างไร",
    "ถัดไป: ใช้ Decision Tree เลือกสไตล์ที่เหมาะกับคุณ",
  ),
)

durianChoice = TradeoffScenario(
  "durian-choice",
  "เลือกส่วนผสมและวิธีการ",
  [
    TradeoffMetric("crispiness", "ความกรอบ", 50, 0, 100, "higher"),
    TradeoffMetric("flavor", "กลิ่นทุเรียน", 50, 0, 100, "higher"),
    TradeoffMetric("sweetness", "ความหวาน", 30, 0, 100, "higher"),
    TradeoffMetric("difficulty", "ความง่าย", 50, 0, 100, "higher"),
  ],
  [durianType, fryingMethod, coating],
  "ทำทุเรียนทอด โดยเลือกประเภททุเรียน วิธีการทอด และเคลือบ",
)

durianType = TradeoffStep(
  "durian_type",
  "เลือกพันธุ์ทุเรียน",
  [monthong, chanee, kanYao],
  "พันธุ์ทุเรียนส่งผลต่อเนื้อสัมผัสและรสชาติ",
  "monthong",
)

monthong = TradeoffChoice(
  "monthong",
  "หมอนทอง",
  "เนื้อเยอะ เมล็ดเล็ก หาได้ง่าย",
  {crispiness: 10, flavor: 5, difficulty: 10},
  [
    ProCon("เนื้อเยอะ", "ได้ชิ้นทุเรียนเยอะจากผลเดียว"),
    ProCon("หาได้ง่าย", "พันธุ์หลักที่ปลูกทั่วไทย"),
  ],
  [ProCon("กลิ่นไม่จัด", "กลิ่นทุเรียนไม่เข้มข้นเท่าพันธุ์อื่น")],
  "หมอนทองเหมาะสำหรับมือใหม่ เนื้อเยอะหั่นง่าย",
)

chanee = TradeoffChoice(
  "chanee",
  "ชะนี",
  "เนื้อน้อยลง แต่กลิ่นและรสจัดกว่า",
  {crispiness: 5, flavor: 15, difficulty: -5},
  [
    ProCon("กลิ่นหอมจัด", "กลิ่นทุเรียนเข้มข้น"),
    ProCon("รสหวานมัน", "เนื้อทุเรียนชะนีหวานมันกว่า"),
  ],
  [ProCon("เนื้อน้อย", "ได้ชิ้นทุเรียนน้อยกว่าหมอนทอง")],
  null,
  "ใช้เมื่อต้องการทุเรียนทอดกลิ่นหอมจัด",
)

kanYao = TradeoffChoice(
  "kan_yao",
  "ก้านยาว",
  "เนื้อบาง เมล็ดแบน กลิ่นหอม",
  {crispiness: 5, flavor: 10, difficulty: -5},
  [ProCon("เมล็ดแบน", "แยกเนื้อออกง่าย")],
  [ProCon("หั่นยาก", "เนื้อบาง อาจขาดง่ายตอนหั่น")],
  null,
  "ใช้เมื่อต้องการความสมดุลระหว่างกลิ่นและความง่าย",
)

fryingMethod = TradeoffStep(
  "frying_method",
  "เลือกวิธีการทอด",
  [deepFry, shallowFry],
  "วิธีการทอดส่งผลต่อความกรอบและปริมาณน้ำมัน",
  "shallow_fry",
)

deepFry = TradeoffChoice(
  "deep_fry",
  "ทอดน้ำมันท่วม",
  "ใส่ทุเรียนในน้ำมันที่ท่วมชิ้น",
  {crispiness: 15, sweetness: 0, difficulty: -5},
  [ProCon("กรอบเท่ากันทุกด้าน", "ชิ้นทุเรียนสัมผัสความร้อนสม่ำเสมอ")],
  [ProCon("ใช้น้ำมันเยอะ", "ต้องใช้น้ำมันปริมาณมาก")],
  null,
  "ใช้เมื่อต้องการความกรอบสูงสุด",
)

shallowFry = TradeoffChoice(
  "shallow_fry",
  "ทอดน้ำมันน้อย",
  "ใช้น้ำมันแค่ครึ่งชิ้น กลับด้านเอง",
  {crispiness: 0, difficulty: 10},
  [
    ProCon("ประหยัดน้ำมัน", "ใช้น้ำมันน้อยลง"),
    ProCon("ควบคุมง่าย", "เห็นชิ้นทุเรียนชัด ควบคุมการทอดง่าย"),
  ],
  [ProCon("ต้องกลับด้าน", "ต้องคอยกลับด้านเพื่อให้สุกเท่ากัน")],
  "ทอดน้ำมันน้อยประหยัดและควบคุมง่าย เหมาะกับมือใหม่",
)

coating = TradeoffStep(
  "coating",
  "เลือกการเคลือบ",
  [noCoat, sugarCoat, palmSugar],
  "เคลือบหรือไม่เคลือบ ส่งผลต่อรสชาติ",
  "sugar_coat",
)

noCoat = TradeoffChoice(
  "no_coat",
  "ไม่เคลือบ (แบบเปล่า)",
  "ทอดเสร็จทานได้เลย เน้นรสธรรมชาติ",
  {crispiness: 5, flavor: 10, sweetness: -10, difficulty: 10},
  [ProCon("ง่ายที่สุด", "ทอดเสร็จทานได้เลย"), ProCon("เน้นกลิ่นทุเรียนแท้", "ไม่มีการปรุงแต่ง")],
  [ProCon("รสชาติเรียบง่าย", "อาจจืดสำหรับบางคน")],
  null,
  "ใช้เมื่อชอบรสธรรมชาติของทุเรียน",
)

sugarCoat = TradeoffChoice(
  "sugar_coat",
  "เคลือบน้ำตาลทราย",
  "คลุกน้ำตาลทรายให้เคลือบบางๆ",
  {crispiness: -5, sweetness: 20, difficulty: 0},
  [ProCon("หวานกรอบอร่อย", "รสชาติหวานสมดุลกับความกรอบ"), ProCon("เป็นที่ยอมรับ", "รูปแบบยอดนิยม")],
  [ProCon("ความกรอบลดลงบ้าง", "น้ำตาลดูดความชื้น ทำให้กรอบน้อยลง")],
  "เคลือบน้ำตาลเป็นแบบยอดนิยม หวานกรอบอร่อย",
)

palmSugar = TradeoffChoice(
  "palm_sugar",
  "เคลือบน้ำตาลปี๊บ",
  "ใช้น้ำตาลปี๊บ熬ละลายเคลือบ",
  {crispiness: -10, sweetness: 15, flavor: 10, difficulty: -10},
  [ProCon("รสหวานลึก", "น้ำตาลปี๊บมีกลิ่นหอมอ้อย"), ProCon("สีสันสวยงาม", "สีน้ำตาลทองสวย")],
  [
    ProCon("ทำยากกว่า", "ต้อง熬น้ำตาลปี๊บให้ละลายพอดี"),
    ProCon("ความกรอบลดลง", "น้ำตาลปี๊บมีความชื้นมากกว่า"),
  ],
  null,
  "ใช้เมื่อต้องการรสชาติลึกและสีสันสวย",
)
