root = ReflectionTemplate("Synthesis Vault", [challenge1, challenge2, challenge3])

challenge1 = TemplateChallenge(
  "Complete the doctrine (Track 1):",
  "The doctrine grants {zone-1} before day one, drives every newcomer to one {zone-2} task in week one, and reveals complexity through {zone-3}.",
  [
    Chip("chip-access", "day-zero access"),
    Chip("chip-wiki", "a 40-page handbook"),
    Chip("chip-golden", "golden-path"),
    Chip("chip-firehose", "an information firehose"),
    Chip("chip-disclosure", "progressive disclosure"),
  ],
  {"zone-1": "chip-access", "zone-2": "chip-golden", "zone-3": "chip-disclosure"},
  "<strong>Correct!</strong> Principle 1 grants day-zero access, Principle 2 drives one golden-path task in week one, and Principle 4 reveals complexity through progressive disclosure — the handbook firehose is the anti-pattern.",
)

challenge2 = TemplateChallenge(
  "Complete the method doctrine (Track 2):",
  "At hundred-thousand-user scale only {zone-1} scale at near-zero marginal cost; high-risk operator roles climb best via {zone-2}; and the docs-first {zone-3} is the backbone, never the only door.",
