    Chip("chip-ttfv", "time-to-first-value"),
    Chip("chip-pages", "pages-read count"),
    Chip("chip-storm", "ticket storm"),
    Chip("chip-4003", "'4003 access denied'"),
    Chip("chip-smoke", "'Monday morning'"),
  ],
  {"zone-1": "chip-ttfv", "zone-2": "chip-storm", "zone-3": "chip-4003"},
  "<strong>Correct!</strong> Time-to-first-value is the north star the whole stack feeds; ticket storms are the cohort telling you where the path broke; and the manual credential-fix loop earns its name from the day-one 4003 that exposes it. Pages-read counts are the vanity metric the realm rejects.",
)
