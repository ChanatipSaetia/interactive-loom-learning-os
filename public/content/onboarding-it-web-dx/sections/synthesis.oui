    Chip("chip-bootcamps", "bootcamps"),
    Chip("chip-tours", "self-serve in-app tours"),
    Chip("chip-buddy", "buddy apprenticeship"),
    Chip("chip-handbook", "handbook"),
  ],
  {"zone-1": "chip-tours", "zone-2": "chip-buddy", "zone-3": "chip-handbook"},
  "<strong>Correct!</strong> In-app tours carry the mass audience, apprenticeship carries the high-risk climb (watching for burnout), and the handbook is the spine everything links to — bootcamps are calendar-locked and cost-per-head.",
)

challenge3 = TemplateChallenge(
  "Complete the measurement doctrine (Track 3):",
  "The dashboard's north star is {zone-1}; a {zone-2} is an unanswered-documentation signal; and the provisioning flow's rework loop is nicknamed {zone-3}.",
