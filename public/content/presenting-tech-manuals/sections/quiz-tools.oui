root = Quiz("Trial of the Instrument Choice", [q1, q2, q3, q4, q5])

q1 = QuizQuestion(
  "q1",
  "You want to author slides as plain markdown in the same Git repo as the code, and still export a PPTX for stakeholders who demand PowerPoint. Which tool fits?",
  [
    QuizChoice(
      "a",
      "Marp",
      true,
      "Correct. Marp compiles CommonMark into themed slides and exports to HTML, PDF, and PPTX.",
    ),
    QuizChoice(
      "b",
      "Redoc",
      false,
      "Redoc renders readable API references from OpenAPI specs — it does not make slide decks.",
    ),
    QuizChoice(
      "c",
      "mdBook",
      false,
      "mdBook is a minimal docs site generator for pure-text handbooks, not a slide deck exporter.",
    ),
  ],
  "It is described as 'a README.md that stands up and gives a talk'.",
)

q2 = QuizQuestion(
  "q2",
  "Your developer audience keeps getting burned by API docs that drifted from the real API. What instrument makes the reference impossible to stale?",
  [
    QuizChoice(
      "a",
      "Longer release-notes emails",
      false,
      "Prose release notes drift exactly like screenshots do. Generate the reference from the OpenAPI spec instead.",
    ),
    QuizChoice(
      "b",
      "A Swagger UI console rendered from the OpenAPI spec",
      true,
      "Correct. Swagger UI (and Redoc) render the live contract — the reference cannot be out of date because it is generated from the code.",
    ),
    QuizChoice(
      "c",
      "High-resolution screenshots of Postman requests",
      false,
      "A screenshot of a request is still a screenshot — it goes stale the moment the API changes. Render the spec itself.",
    ),
  ],
  "The manual becomes the running contract itself.",
)

q3 = QuizQuestion(
  "q3",
  "Instead of a keynote, you want users to learn the Web App's new onboarding flow by clicking through it with highlight-and-explain overlays. Which category do you reach for?",
  [
    QuizChoice(
      "a",
      "Intro.js or Shepherd in-app tours",
      true,
      "Correct. Intro.js and Shepherd render step-by-step overlay tours on the live product screens.",
    ),
    QuizChoice(
      "b",
      "Marp theme directives",
      false,
      "Marp makes slides; an overlay tour on live screens is the job of the In-App & In-Code Guided Tours category (Intro.js, Shepherd).",
    ),
    QuizChoice(
      "c",
      "OBS Studio",
      false,
      "OBS records video — clickable, self-serve overlay tours on running screens are Intro.js/Shepherd territory.",
    ),
  ],
  "A museum audio guide inside the actual room.",
)

q4 = QuizQuestion(
  "q4",
  "Where does the safety-net clip for a live product demo come from, and which tool makes it?",
  [
    QuizChoice(
      "a",
      "A screen recording made with OBS Studio, reused as fallback clip, async manual, and docs GIF",
      true,
      "Correct. OBS Studio captures the real UI with narration; the same recording serves as fallback, async manual, and embedded clip.",
    ),
    QuizChoice(
      "b",
      "A second presenter with a backup laptop running reveal.js",
      false,
      "reveal.js is a presentation framework, not a recording tool. The taught safety net is a pre-recorded OBS Studio clip.",
    ),
    QuizChoice(
      "c",
      "An animated walkthrough generated by Docusaurus",
      false,
      "Docusaurus hosts docs sites; the fallback clip is a screen recording captured with OBS Studio.",
    ),
  ],
  "Recorded once, it lives three lives.",
)

q5 = QuizQuestion(
  "q5",
  "Which markdown-deck tool is specifically described as a presentation that runs as an HTML/JS web app, deployable to the same web server as the product itself?",
  [
    QuizChoice(
      "a",
      "Marp",
      false,
      "Marp exports static decks to HTML/PDF/PPTX; the browser-native HTML/JS presentation framework in this landscape is reveal.js.",
    ),
    QuizChoice(
      "b",
      "reveal.js",
      true,
      "Correct. reveal.js builds presentations as HTML/JS web apps with nested slides and speaker notes.",
    ),
    QuizChoice(
      "c",
      "VitePress",
      false,
      "VitePress builds documentation sites from markdown; the HTML/JS presentation framework is reveal.js.",
    ),
  ],
  "Its decks open in a browser tab like any other web app.",
)
