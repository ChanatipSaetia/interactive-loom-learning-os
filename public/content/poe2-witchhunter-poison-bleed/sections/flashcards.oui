root = Flashcards(
  "Key Vocabulary",
  [
    witchhunter,
    noMercy,
    obsessiveRituals,
    sorceryWard,
    poison,
    bleeding,
    magnitude,
    poison3,
    bleed3,
    atMixture,
    gasGrenade,
    barrage,
    concentration,
    escalatingPoison,
  ],
)

witchhunter = Flashcard(
  "witchhunter",
  "Witchhunter",
  "WITCH-hun-ter",
  "ascendancy",
  "Third Mercenary ascendancy focused on ballista summons and precision attacks.",
  "The Witchhunter ascendancy specializes in summoning ballistas that fire projectiles, combined with precision-based offense. Key nodes include Ballista summons, attack speed scaling, and ailment-focused damage multipliers.",
  "Core ascendancy for this build. Provides ballista summons for sustained ailment application and precision nodes that amplify poison and bleed damage.",
  "https://www.poe2wiki.net/images/thumb/9/93/Mercenary_portrait.png/96px-Mercenary_portrait.png",
  Dialogue(
    "Why Witchhunter over other Mercenary ascendancies?",
    "Player comparing ascendancy options.",
    "Witchhunter's ballista summons apply ailments independently from your character, letting you stack poison and bleed while kiting safely.",
  ),
)

noMercy = Flashcard(
  "no-mercy",
  "No Mercy",
  "noh MER-si",
  "ascendancy",
  "Ascendancy node giving up to 40% more damage based on enemy missing Concentration.",
  "A notable Witchhunter node that grants increasing More Damage as the target's Concentration drops. At maximum effect, enemies with no remaining Concentration take 40% More Damage from all sources.",
  "Massive damage multiplier against boss-tier enemies with Concentration bars. Synergizes with sustained ailment damage that keeps pressure on fleeing targets.",
  "https://www.poe2wiki.net/images/thumb/b/b1/No_Mercy_passive_icon.png/48px-No_Mercy_passive_icon.png",
  Dialogue(
    "Does No Mercy work on normal maps?",
    "Player unsure about map applicability.",
    "No Mercy only activates against enemies with a Concentration mechanic — mainly Expedition and Delve bosses. On standard maps, focus on raw ailment magnitude instead.",
  ),
)

obsessiveRituals = Flashcard(
  "obsessive-rituals",
  "Obsessive Rituals",
  "ob-SESS-iv RIT-yuh-lz",
  "ascendancy",
  "50% less Armour and Evasion in exchange for offensive power.",
  "A Witchhunter notable that trades 50% less Armour and 50% less Evasion Rating for substantial offensive gains, including ailment magnitude and attack speed. Intentional fragility for maximum damage output.",
  "Defines the build's risk-reward identity. You sacrifice physical defense to become an ailment damage specialist — positioning and ballista distance become your real defense.",
  "https://www.poe2wiki.net/images/thumb/0/07/Obsessive_Rituals_passive_icon.png/48px-Obsessive_Rituals_passive_icon.png",
  Dialogue(
    "Won't Obsessive Rituals make me too squishy?",
    "Player worried about survivability trade-off.",
    "It does remove physical defenses, but the ballista summons handle clearing from range. Position carefully and rely on movement skills to survive.",
  ),
)

sorceryWard = Flashcard(
  "sorcery-ward",
  "Sorcery Ward",
  "SOR-uh-see WAR-d",
  "skill",
  "Barrier mechanic that absorbs damage and recharges over time.",
  "A defensive skill unique to the Mercenary that creates a damage-absorbing barrier. The ward recharges gradually over time, providing a reliable layer of damage mitigation without requiring active management.",
  "Primary defense layer after taking Obsessive Rituals. Compensates for lost Armour/Evasion with a rechargeable damage shield.",
  "https://www.poe2wiki.net/images/8/82/Sorcery_Ward_inventory_icon.png",
  Dialogue(
    "How do I stay alive without Armour?",
    "Player needs defense guidance post-Obsessive Rituals.",
    "Sorcery Ward is your main damage buffer. Keep it topped up during boss fights and use movement to avoid sustained hits.",
  ),
)

poison = Flashcard(
  "poison",
  "Poison",
  "POY-zun",
  "ailment",
  "Chaos damage over time with base magnitude equal to 20% of Physical + Chaos damage from the hit.",
  "An ailment that deals chaos damage over time. The base magnitude captures 20% of the combined Physical and Chaos damage from the triggering hit. Duration scales with attack speed and skill modifiers, allowing multiple overlapping stacks.",
  "One half of the dual-ailment engine. Poison's chaos damage type bypasses enemy resistance more reliably than elemental ailments at endgame.",
  "https://www.poe2wiki.net/images/d/d3/Poisoned_debuff_icon.png",
  Dialogue(
    "How is poison damage calculated?",
    "Player needs the math explained simply.",
    "Each poison tick equals 20% of your Physical + Chaos hit damage, modified by more/faster poison nodes. Stack multiple hits for overlapping damage.",
  ),
)

bleeding = Flashcard(
  "bleeding",
  "Bleeding",
  "BLEE-ding",
  "ailment",
  "Physical damage over time with base magnitude of 15% of Physical damage, doubled while target moves.",
  "A physical damage over time ailment. Base magnitude captures 15% of the Physical damage from the triggering hit. Critically, bleeding damage doubles while the affected target is moving, making it exceptionally strong against mobile enemies.",
  "The other half of the dual-ailment engine. The movement damage multiplier makes bleeding synergize with kiting plays and area denial setups.",
  "https://www.poe2wiki.net/images/1/19/Bleeding_debuff_icon.png",
  Dialogue(
    "Why does bleeding double when enemies move?",
    "Player curious about the movement multiplier.",
    "It's a built-in design to reward kiting. Circle-strafe bosses and bleed damage spikes — this is your build's core loop.",
  ),
)

magnitude = Flashcard(
  "magnitude",
  "Magnitude",
  "MAG-nih-tood",
  "mechanic",
  "The base damage value captured by an ailment before modifiers are applied.",
  "The snapshot value that determines how much damage a single ailment instance deals per tick. For poison, magnitude = 20% of (Physical + Chaos) from the hit. For bleeding, magnitude = 15% of Physical from the hit. All % more magnitude modifiers multiply this base value.",
  "The fundamental stat to optimize. Every damage node in this build funnels into magnitude — higher magnitude means stronger ticks per stack.",
  "https://www.poe2wiki.net/images/thumb/d/d0/Magnitude_passive_icon.png/48px-Magnitude_passive_icon.png",
  Dialogue(
    "Should I care about magnitude or duration?",
    "Player confused about ailment priorities.",
    "Magnitude first, always. Duration only matters to ensure ticks outlast the fight. A high-magnitude short poison outdamages a weak long one.",
  ),
)

poison3 = Flashcard(
  "poison-3",
  "Poison 3",
  "POY-zun three",
  "keystone",
  "Gives more poison magnitude against enemies that are also bleeding.",
  "A keystone passive that significantly increases poison magnitude specifically when the target is also affected by bleeding. This creates a conditional damage spike that rewards maintaining both ailments simultaneously.",
  "Core keystone that justifies the dual-ailment approach. Without it, poison and bleed operate independently. With it, they multiply each other's value.",
  "https://www.poe2wiki.net/images/thumb/f/f9/Poison_passive_icon.png/48px-Poison_passive_icon.png",
  Dialogue(
    "What does Poison 3 actually do?",
    "Player needs keystone function clarified.",
    "Poison 3 says 'your poison hits harder when the enemy is also bleeding.' It's the reason this build runs both ailments.",
  ),
)

bleed3 = Flashcard(
  "bleed-3",
  "Bleed 3",
  "BLEED three",
  "keystone",
  "Gives more bleeding magnitude against enemies that are also poisoned.",
  "A keystone passive that significantly increases bleeding magnitude specifically when the target is also affected by poison. Paired with Poison 3, it creates a symmetric dual-ailment amplification loop.",
  "The mirror keystone to Poison 3. Together they ensure both ailments are always stronger when stacked, making the dual-ailment strategy mandatory rather than optional.",
  "https://www.poe2wiki.net/images/thumb/5/50/Bleed_passive_icon.png/48px-Bleed_passive_icon.png",
  Dialogue(
    "Do I need both Poison 3 and Bleed 3?",
    "Player weighing keystone investment.",
    "Yes — they feed each other. Poison 3 strengthens poison when bleed is present, and Bleed 3 does the reverse. Dropping one halves the synergy.",
  ),
)

atMixture = Flashcard(
  "at-mixture",
  "At Mixture",
  "at MIX-chur",
  "support",
  "20% more bleeding magnitude against poisoned enemies and 20% more poison magnitude against bleeding enemies.",
  "A support gem that provides bidirectional ailment magnitude bonuses. When linked to a physical attack, it increases bleeding magnitude by 20% on poisoned targets and poison magnitude by 20% on bleeding targets, amplifying the dual-ailment synergy.",
  "Stacks multiplicatively with Poison 3 and Bleed 3 keystones, creating a compounding damage loop that makes dual ailments dramatically stronger than either alone.",
  "https://www.poe2wiki.net/images/3/34/At_Mixture_inventory_icon.png",
  Dialogue(
    "Is At Mixture worth linking?",
    "Player evaluating support gem slot usage.",
    "Absolutely — At Mixture stacks with both keystones. It's the cheapest way to spike dual-ailment damage before investing in expensive uniques.",
  ),
)

gasGrenade = Flashcard(
  "gas-grenade",
  "Gas Grenade",
  "gas gre-NAYD",
  "skill",
  "Fires a bouncing grenade that causes poison gas burst and leaves a growing poison cloud.",
  "An attack skill that launches a bouncing grenade, dealing an initial poison gas burst on impact and leaving a poison cloud that grows in radius over time. Excellent for area denial and applying poison to multiple enemies simultaneously.",
  "Primary clearing and poison-application skill. The growing cloud ensures sustained poison uptime on groups, feeding into the Poison 3 / Bleed 3 synergy.",
  "https://www.poe2wiki.net/images/6/60/Gas_Grenade_inventory_icon.png",
  Dialogue(
    "Which skill should I use for clearing?",
    "Player needs skill guidance.",
    "Gas Grenade is your clear skill. Bounce it into dense packs and let the expanding cloud apply poison to everything.",
  ),
)

barrage = Flashcard(
  "barrage",
  "Barrage",
  "buh-RAJ",
  "skill",
  "Fires a rapid volley of projectiles, empowered to repeat multiple times.",
  "An attack skill that fires a volley of projectiles in the target direction. When empowered through passive nodes or support gems, Barrage repeats multiple times in a single activation, making it effective for applying bleeding through repeated physical hits.",
  "Strong single-target and AoE option for applying bleeding. Each projectile attempt is a separate hit chance, maximizing bleed application rate.",
  "https://www.poe2wiki.net/images/8/86/Barrage_inventory_icon.png",
  Dialogue(
    "Barrage or Gas Grenade for bosses?",
    "Player choosing between skills for bossing.",
    "Barrage excels at single-target bleed application through repeated hits. Gas Grenade is better for multi-target poison clouds.",
  ),
)

concentration = Flashcard(
  "concentration",
  "Concentration",
  "kon-sen-tray-SHUN",
  "mechanic",
  "Enemy resource that causes them to flee when depleted; No Mercy scales damage based on missing Concentration.",
  "A mechanic present on Expedition and Delve enemies where they possess a Concentration bar. When depleted, the enemy enters a fleeing state, attempting to escape the arena. The No Mercy ascendancy node converts their missing Concentration into More Damage dealt against them.",
  "The damage-scaling engine for No Mercy. Pushing Concentration to zero maximizes your damage output on bosses that use this mechanic.",
  "https://www.poe2wiki.net/images/c/c2/Concentration_debuff_icon.png",
  Dialogue(
    "How do I maximize No Mercy damage?",
    "Player wants to optimize the Concentration interaction.",
    "Break the enemy's Concentration bar as fast as possible early in the fight. The lower it is, the higher your No Mercy damage bonus.",
  ),
)

escalatingPoison = Flashcard(
  "escalating-poison",
  "Escalating Poison",
  "es-kal-AY-ting POY-zun",
  "mechanic",
  "Increases the maximum number of poison stacks maintainable on a single target.",
  "A mechanic or node that raises the cap on poison stacks per target. By default, a limited number of poison instances can exist on one enemy. Escalating Poison increases this cap, allowing more simultaneous poison ticks and higher total damage output.",
  "Directly multiplies poison damage by allowing more stacks. Combined with high magnitude, escalating poison turns single-target encounters into chaos damage fountains.",
  "https://www.poe2wiki.net/images/thumb/e/e2/Escalating_Poison_passive_icon.png/48px-Escalating_Poison_passive_icon.png",
  Dialogue(
    "How many poison stacks can I have on a boss?",
    "Player needs stack limit info.",
    "Stack count depends on your Escalating Poison investment. More stacks mean more simultaneous ticks, each dealing magnitude damage.",
  ),
)
