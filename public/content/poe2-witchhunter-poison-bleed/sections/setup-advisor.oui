root = DecisionTree(
  "Build Setup Advisor",
  "witchhunter-advisor",
  "stage",
  [
    stage,
    lsGear,
    lsBowGood,
    lsNoBowRec,
    midGear,
    midTreeGoodRec,
    midTreeBadRec,
    lateGear,
    lateMappingRec,
    lateUberRec,
  ],
  "Witchhunter Poison + Bleed Setup Advisor",
)

stage = DecisionNode(
  "stage",
  "What stage of the league are you at?",
  [
    DecisionChoice(
      "league-start",
      "League start (Acts 1-5)",
      "ls-gear",
      "Early league priorities differ from endgame.",
      true,
    ),
    DecisionChoice("mid-league", "Mid-league (mapping, some endgame gear)", "mid-gear"),
    DecisionChoice("late-league", "Late league (high-tier maps, Uber target)", "late-gear"),
  ],
)

lsGear = DecisionNode(
  "ls-gear",
  "What weapon do you have?",
  [
    DecisionChoice(
      "ls-has-bow",
      "A Bow with Physical Damage and Attack Speed",
      "ls-bow-good",
      null,
      true,
    ),
    DecisionChoice("ls-no-bow", "No proper bow yet", "ls-no-bow-rec"),
  ],
)

lsBowGood = DecisionNode(
  "ls-bow-good",
  null,
  null,
  DecisionLeaf(
    "Link Poison 3, Bleed 3, and At Mixture into your bow immediately.",
    "With a physical bow, you can apply both Bleed and Poison. At Mixture creates the dual-DoT synergy where each ailment boosts the other's magnitude by 20%. Focus on reaching the Poison and Bleed clusters in the passive tree.",
    [
      "Early game, prioritize ailment chance over magnitude — consistent application matters more",
      "Take No Mercy ascendancy node first for Concentration-based damage bonus",
      "Budget flasks: Life Leech flask is your best early survival tool",
    ],
  ),
)

lsNoBowRec = DecisionNode(
  "ls-no-bow-rec",
  null,
  null,
  DecisionLeaf(
    "Find any Bow with Physical Damage. Attack Speed is the priority stat.",
    "You need a bow for this build. Any physical bow works league start. Avoid bows with only elemental damage — you need Physical for Bleed. Attack Speed > Raw Damage early game because more hits = more DoT applications.",
    [
      "A cheap 1-socket bow with At Mixture is better than a 6L without it",
      "Gradually upgrade: more sockets → more supports → exponential DoT growth",
    ],
  ),
)

midGear = DecisionNode(
  "mid-gear",
  "How's your passive tree progress?",
  [
    DecisionChoice(
      "mid-tree-good",
      "Allocated to Poison + Bleed clusters with Notables",
      "mid-tree-good-rec",
      null,
      true,
    ),
    DecisionChoice(
      "mid-tree-bad",
      "Still near Mercenary start, minimal allocation",
      "mid-tree-bad-rec",
    ),
  ],
)

midTreeGoodRec = DecisionNode(
  "mid-tree-good-rec",
  null,
  null,
  DecisionLeaf(
    "Invest in Serpent's Kiss bow and Body and Soul chest piece.",
    "Mid-league is when unique items transform your build. Serpent's Kiss adds lifesteal and damage. Body and Soul gives massive Spirit for aura sustainability. Start allocating to RFLAS belt for survivability.",
    [
      "Serpent's Kiss is the best-in-slot bow for this build — prioritize saving for it",
      "Obsessive Rituals means you need good movement mechanics to survive",
      "Consider Sorcery Ward skill for an extra damage buffer",
    ],
  ),
)

midTreeBadRec = DecisionNode(
  "mid-tree-bad-rec",
  null,
  null,
  DecisionLeaf(
    "Rush Poison and Bleed magnitude clusters in the passive tree.",
    "Without tree allocation, your DoTs underperform. Allocate to the nearest Poison and Bleed notables first, then extend toward magnitude and duration clusters. The dual-DoT synergy from At Mixture scales with tree investment.",
    [
      "Short allocation to key nodes > long allocation to mediocre nodes",
      "Consider using a Vaal orb to relocate your start if stuck",
    ],
  ),
)

lateGear = DecisionNode(
  "late-gear",
  "What's your endgame target?",
  [
    DecisionChoice(
      "late-mapping",
      "Fast map clearing and efficient farming",
      "late-mapping-rec",
      null,
      true,
    ),
    DecisionChoice("late-uber", "Uber bosses and Vaal Overmap", "late-uber-rec"),
  ],
)

lateMappingRec = DecisionNode(
  "late-mapping-rec",
  null,
  null,
  DecisionLeaf(
    "Maximize clear speed with Gas Grenade cloud coverage and high Attack Speed.",
    "For mapping, you want screen-filling poison clouds from Gas Grenade while Barrage applies Bleed. Stack Attack Speed, Area of Effect, and DoT duration. RFLAS belt + Body and Soul + two life rings for safe mapping.",
    [
      "Clear speed > single-target in mapping builds — more maps cleared = more profit",
      "Gas Grenade clouds persist and overlap, creating AoE poison zones",
      "Movement speed is implicit DPS — faster mapping = more clears per hour",
    ],
  ),
)

lateUberRec = DecisionNode(
  "late-uber-rec",
  null,
  null,
  DecisionLeaf(
    "Shift to maximum single-target DoT magnitude with crafted modifiers.",
    "Uber bosses require sustained single-target DoT. Craft 'More Magnitude of Poison' and 'More Magnitude of Bleeding' on your gear. Stack Duration over Clear Speed. No Mercy becomes critical as boss Concentration drains. Sorcery Ward is mandatory for survival.",
    [
      "Single-target focus means terrible clear — use a separate clearing skill or accept slow mapping",
      "Crafted 'More%' modifiers are worth the investment for Uber attempts",
      "Practice boss mechanics — Obsessive Rituals leaves you fragile",
    ],
  ),
)
