root = DecisionTree(
  "Mechanic Fit Advisor",
  "mechanic-fit",
  "inherent-fun",
  [
    inherentFun,
    funWhat,
    choreWhat,
    recLightHabit,
    recMastery,
    recSocial,
    recPbl,
    recNarrative,
    recCareful,
  ],
)

inherentFun = DecisionNode(
  "inherent-fun",
  "Is the core activity already intrinsically enjoyable for your target users?",
  [
    DecisionChoice(
      "yes-fun",
      "Yes — users do it for its own sake",
      "fun-what",
      "If it's already fun, your risk is over-gamifying and crowding out intrinsic motivation.",
    ),
    DecisionChoice(
      "no-fun",
      "No — it's a chore, a duty, or a pain",
      "chore-what",
      "Chores need motivation design; the question is which kind.",
    ),
  ],
)

funWhat = DecisionNode(
  "fun-what",
  "What is your main goal?",
  [
    DecisionChoice(
      "goal-habit",
      "Build a daily habit / consistency",
      "rec-light-habit",
      "Habit formation needs a commitment device, not reward inflation.",
    ),
    DecisionChoice(
      "goal-skill",
      "Accelerate skill mastery",
      "rec-mastery",
      "Mastery is best served by progress visibility tied to real ability.",
    ),
    DecisionChoice(
      "goal-social",
      "Grow a community",
      "rec-social",
      "Communities thrive on relatedness and shared goals.",
    ),
  ],
)

choreWhat = DecisionNode(
  "chore-what",
  "What kind of activity is it?",
  [
    DecisionChoice(
      "short-task",
      "Short, repeatable tasks (under 15 minutes)",
      "rec-pbl",
      "Short repeatable tasks map well to points, streaks, and quests.",
    ),
    DecisionChoice(
      "long-project",
      "Long, open-ended projects",
      "rec-narrative",
      "Long projects need meaning and milestones, not point churn.",
    ),
    DecisionChoice(
      "sensitive",
      "Sensitive context (health, finance, children)",
      "rec-careful",
      "Sensitive contexts demand ethical guardrails before mechanics.",
    ),
  ],
)

recLightHabit = DecisionNode(
  "rec-light-habit",
  null,
  null,
  DecisionLeaf(
    "Light-touch commitment devices: flexible streaks with freezes, gentle reminders, no leaderboards.",
    "The activity is already fun, so add the minimum structure that builds consistency. Strict streaks and extrinsic rewards risk overjustification — replacing the joy you already have with anxiety.",
    [
      "Weaker pull for sporadic users than hard streaks",
      "Requires A/B testing to find the right nudge intensity",
    ],
  ),
)

recMastery = DecisionNode(
  "rec-mastery",
  null,
  null,
  DecisionLeaf(
    "Mastery-first: skill progress visualization, levels tied to demonstrated ability, badges for genuine milestones.",
    "Development & Accomplishment (Octalysis CD2) is the strongest drive for learning. Tie every point and badge to a real skill gain, or users will optimize the metric instead of the skill.",
    [
      "Needs per-skill assessment design — higher upfront effort",
      "Slower early dopamine than raw XP",
    ],
  ),
)

recSocial = DecisionNode(
  "rec-social",
  null,
  null,
  DecisionLeaf(
    "Social layer first: team quests, cohort teams, opt-in recognition, shared celebrations.",
    "Social Influence & Relatedness (CD5) drives community growth. Recognition should be opt-in and broad, not a narrow leaderboard that shames the bottom.",
    [
      "Requires a minimum viable community size to work",
      "Free-riders and social pressure need moderation tools",
    ],
  ),
)

recPbl = DecisionNode(
  "rec-pbl",
  null,
  null,
  DecisionLeaf(
    "Classic PBL with a twist: XP, badges, and flexible streaks, plus one social element.",
    "Short repeatable tasks reward well with Development & Accomplishment mechanics. Pair with a light social layer so engagement doesn't decay after the novelty wears off — the 'sprinkles and donuts' failure mode.",
    [
      "Extrinsic rewards may crowd out intrinsic motivation over time",
      "Points need a clear purpose — status or exchangeable, not both",
    ],
  ),
)

recNarrative = DecisionNode(
  "rec-narrative",
  null,
  null,
  DecisionLeaf(
    "Narrative framing: quests with story arcs, epic meaning & purpose, milestone celebrations.",
    "Long projects fatigue under point churn. Epic Meaning & Purpose (CD1) — 'this work matters' — sustains effort across weeks, and milestone badges mark real progress.",
    [
      "Story and quest design is expensive to author",
      "Narrative can feel forced if it doesn't match the work",
    ],
  ),
)

recCareful = DecisionNode(
  "rec-careful",
  null,
  null,
  DecisionLeaf(
    "Ethics-first design: intrinsic feedback, private progress, no pressure mechanics, opt-in everything.",
    "In health, finance, and children's contexts, black-hat drives (scarcity, loss aversion, guilt) can cause real harm. Use white-hat drives — meaning, mastery, autonomy — and let users control the intensity.",
    [
      "Lower short-term engagement than pressure-based designs",
      "Requires ongoing ethics review as mechanics evolve",
    ],
  ),
)
