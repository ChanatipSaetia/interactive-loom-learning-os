root = Intro(
  "",
  what,
  why,
  [
    RoadmapStep(
      "1. Core Vocabulary",
      "flashcards",
      "Understand Ports, Adapters, Driving vs Driven boundaries, and Dependency Inversion.",
    ),
    RoadmapStep(
