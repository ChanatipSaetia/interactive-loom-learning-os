root = Quiz(
  "Knowledge Check Checkpoint",
  [q1, q2, q3],
  null,
  Lead(
    "Multiple-choice checkpoint testing your understanding of Hexagonal Architecture principles.",
    "Validates your readiness to design software using Ports and Adapters.",
    "Congratulations on completing the Hexagonal Architecture module!",
  ),
)

q1 = QuizQuestion(
  "q1",
  "What is the primary role of a Driving (Primary) Port in Hexagonal Architecture?",
  [
    QuizChoice(
      "c1",
      "It exposes SQL queries to external clients.",
      false,
      "SQL queries belong in database adapters, not in driving ports.",
    ),
    QuizChoice(
      "c2",
      "It acts as an inbound contract interface declaring use cases the domain offers to external actors.",
      true,
      "Driving Ports are inbound interfaces owned by the Application Core that define how external drivers (HTTP Controllers, CLI) can invoke use cases.",
    ),
    QuizChoice(
      "c3",
      "It connects the database directly to the HTTP controller.",
      false,
      "Hexagonal Architecture strictly prohibits connecting HTTP controllers directly to databases.",
    ),
    QuizChoice(
      "c4",
      "It parses HTML templates for web pages.",
      false,
      "HTML parsing is a UI presentation concern, completely outside driving port contracts.",
    ),
  ],
  "Think about who initiates execution (inbound vs outbound).",
)

q2 = QuizQuestion(
  "q2",
  "Why does Hexagonal Architecture invert dependencies for database access using Driven Ports?",
  [
    QuizChoice(
      "c1",
      "So the database schema determines the domain model.",
      false,
      "Database schema driving domain models is a anti-pattern that Hexagonal Architecture prevents.",
    ),
    QuizChoice(
      "c2",
      "To allow the Domain Core to define its data requirements without depending on concrete ORMs or database drivers.",
      true,
      "Driven Ports allow the domain logic to specify repository contracts while concrete database adapters implement those contracts outside the hexagon.",
    ),
    QuizChoice(
      "c3",
      "To avoid writing unit tests.",
      false,
      "Dependency inversion makes unit testing significantly easier and faster.",
    ),
    QuizChoice(
      "c4",
      "To force all database queries to be written in GraphQL.",
      false,
      "GraphQL is a web API query layer, unrelated to persistence ports.",
    ),
  ],
  "Consider how domain tests run without booting real SQL databases.",
)

q3 = QuizQuestion(
  "q3",
  "Which component in Hexagonal Architecture is responsible for converting HTTP REST payloads into domain commands?",
  [
    QuizChoice(
      "c1",
      "Driven Adapter",
      false,
      "Driven Adapters handle outbound infrastructure like databases or external web APIs.",
    ),
    QuizChoice(
      "c2",
      "Driven Port",
      false,
      "Driven Ports are outbound interface definitions, not request handlers.",
    ),
    QuizChoice(
      "c3",
      "Driving Adapter",
      true,
      "Driving Adapters (such as Express or Spring HTTP controllers) receive external HTTP requests and adapt them to call Driving Port use cases.",
    ),
    QuizChoice(
      "c4",
      "Domain Aggregate",
      false,
      "Domain Aggregates enforce business rules and consistency, unaware of HTTP protocols.",
    ),
  ],
  "Who converts inbound HTTP requests before calling the port?",
)
