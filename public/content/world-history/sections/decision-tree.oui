root = DecisionTree(
  "คู่มือเลือกแนวทางศึกษาประวัติศาสตร์",
  "history_study_advisor",
  "interest_domain",
  [
    interestDomain,
    eraPolitics,
    eraCulture,
    eraEconomy,
    leafAncientStrategy,
    leafModernDiplomacy,
    leafClassicalThought,
    leafEnlightenment,
    leafSilkroadTrade,
    leafIndustrialModern,
  ],
  "เครื่องมือแนะนำแนวทางศึกษาประวัติศาสตร์ (History Study Advisor)",
  "วินิจฉัยเป้าหมายและความสนใจเพื่อเลือกยุคสมัยและมิติการศึกษาที่เหมาะสม",
)

interestDomain = DecisionNode(
  "interest_domain",
  "คุณสนใจศึกษาประวัติศาสตร์ในมิติใดมากที่สุด?",
  [
    DecisionChoice(
      "politics_war",
      "การเมือง จักรวรรดิ และความขัดแย้ง/สงคราม",
      "era_politics",
      "เหมาะสำหรับผู้ที่สนใจกลยุทธ์ ภูมิรัฐศาสตร์ และการเปลี่ยนแปลงอำนาจ",
    ),
    DecisionChoice(
      "ideas_culture",
      "ความคิด ปรัชญา ศิลปะ และวิทยาการ",
      "era_culture",
      "เหมาะสำหรับผู้ที่ต้องการเข้าใจวิวัฒนาการทางสติปัญญาและจิตวิญญาณมนุษย์",
      true,
    ),
    DecisionChoice(
      "economy_tech",
      "เศรษฐกิจ เทคโนโลยี และการปฏิวัติอุตสาหกรรม",
      "era_economy",
      "เหมาะสำหรับผู้ที่สนใจกลไกการผลิต วิถีชีวิต และความมั่งคั่งของโลก",
    ),
  ],
)

eraPolitics = DecisionNode(
  "era_politics",
  "คุณต้องการเน้นช่วงเวลาใด?",
  [
    DecisionChoice(
      "ancient_classical",
      "ยุคโบราณและคลาสสิก (กรีก โรมัน สามก๊ก)",
      "leaf_ancient_strategy",
      "รากฐานของยุทธศาสตร์การรบและการกำเนิดจักรวรรดิ",
      true,
    ),
    DecisionChoice(
      "modern_contemporary",
      "ยุคใหม่และสงครามโลก / สงครามเย็น",
      "leaf_modern_diplomacy",
      "บทเรียนโดยตรงต่อภูมิรัฐศาสตร์โลกปัจจุบัน",
    ),
  ],
)

eraCulture = DecisionNode(
  "era_culture",
  "คุณสนใจพัฒนาการทางความคิดแบบใด?",
  [
    DecisionChoice(
      "classical_philosophy",
      "ปรัชญากรีก-โรมันและศาสนาโบราณ",
      "leaf_classical_thought",
      "จุดเริ่มต้นของตรรกศาสตร์ จริยศาสตร์ และคุณค่าชีวิต",
    ),
    DecisionChoice(
      "renaissance_enlightenment",
      "ยุคเรเนซองส์และยุคภูมิธรรม (Enlightenment)",
      "leaf_enlightenment",
      "การกำเนิดสิทธิ เสรีภาพ ประชาธิปไตย และวิทยาศาสตร์สมัยใหม่",
      true,
    ),
  ],
)

eraEconomy = DecisionNode(
  "era_economy",
  "คุณสนใจกลไกเศรษฐกิจในมิติใด?",
  [
    DecisionChoice(
      "trade_silkroad",
      "การค้าข้ามทวีปโบราณและเส้นทางสายไหม",
      "leaf_silkroad_trade",
      "การแลกเปลี่ยนสินค้าและวัฒนธรรมข้ามทวีปยุคแรกเริ่ม",
    ),
    DecisionChoice(
      "industrial_globalization",
      "การปฏิวัติอุตสาหกรรมและทุนนิยมโลกาภิวัตน์",
      "leaf_industrial_modern",
      "เข้าใจระบบเศรษฐกิจโรงงาน การเงิน และห่วงโซ่อุปทานโลกปัจจุบัน",
      true,
    ),
  ],
)

leafAncientStrategy = DecisionNode(
  "leaf_ancient_strategy",
  null,
  null,
  DecisionLeaf(
    "ศึกษาประวัติศาสตร์การทหารและจักรวรรดิโบราณ (Classical Empire Strategy)",
    "เริ่มจากประวัติศาสตร์จักรวรรดิโรมัน สงครามเปอร์เซีย และสามก๊ก เพื่อทำความเข้าใจการบริหารดินแดนกว้างใหญ่และยุทธศาสตร์การปกครอง",
    [
      "ได้หลักคิดเชิงยุทธศาสตร์ที่ทรงคุณค่าเหนือกาลเวลา",
      "บริบทสังคมแตกต่างจากโลกปัจจุบันมาก ต้องระวังการนำมาเทียบเคียงตรงๆ",
    ],
  ),
)

leafModernDiplomacy = DecisionNode(
  "leaf_modern_diplomacy",
  null,
  null,
  DecisionLeaf(
    "ศึกษาประวัติศาสตร์สงครามโลก สงครามเย็น และภูมิรัฐศาสตร์ร่วมสมัย",
    "เน้นวิกฤตการณ์ทางการทูต สนธิสัญญาแวร์ซาย สนธิสัญญาเบรตตันวูดส์ และการแข่งขันในสงครามเย็น ซึ่งเป็นโครงสร้างของโลกปัจจุบัน",
    [
      "เชื่อมโยงกับข่าวสารและการเมืองโลกปัจจุบันได้ทันที",
      "มีข้อมูลและหลักฐานซับซ้อนหลากหลายมุมมองที่ต้องวิเคราะห์อย่างรอบคอบ",
    ],
  ),
)

leafClassicalThought = DecisionNode(
  "leaf_classical_thought",
  null,
  null,
  DecisionLeaf(
    "ศึกษาประวัติศาสตร์ปรัชญาและอารยธรรมคลาสสิก (Classical Thought & Ethics)",
    "อ่านงานของโสกราตีส เพลโต ขงจื๊อ และเต๋า เพื่อเข้าใจฐานคิดเรื่องความยุติธรรม คุณธรรม และการจัดระเบียบสังคม",
    [
      "ช่วยบ่มเพาะความคิดเชิงปรัชญาและการให้เหตุผลอย่างลึกซึ้ง",
      "ต้องใช้เวลาทำความเข้าใจแนวคิดเชิงนามธรรม",
    ],
  ),
)

leafEnlightenment = DecisionNode(
  "leaf_enlightenment",
  null,
  null,
  DecisionLeaf(
    "ศึกษายุคฟื้นฟูศิลปวิทยาการและยุคภูมิธรรม (Renaissance & Enlightenment)",
    "สำรวจแนวคิดของวอลแตร์ จอห์น ล็อก รุสโซ และนิวตัน ซึ่งเป็นจุดกำเนิดของรัฐธรรมนูญ สิทธิมนุษยชน และวิธีคิดแบบวิทยาศาสตร์",
    [
      "เป็นรากฐานของระบอบเสรีนิยมประชาธิปไตยและนวัตกรรมตะวันตก",
      "สะท้อนมุมมองที่เน้นยุโรปเป็นศูนย์กลาง (Eurocentric) ควรศึกษาควบคู่กับมุมมองโลกอื่น",
    ],
  ),
)

leafSilkroadTrade = DecisionNode(
  "leaf_silkroad_trade",
  null,
  null,
  DecisionLeaf(
    "ศึกษาประวัติศาสตร์เส้นทางการค้าโลกโบราณ (Ancient Trade Networks)",
    "ติดตามเส้นทางสายไหม เส้นทางเครื่องเทศ และการเดินทางของมาร์โค โปโลและเจิ้งเหอ เพื่อเห็นพลังของการค้าในการเชื่อมโยงมนุษยชาติ",
    [
      "มองเห็นการผสมผสานทางวัฒนธรรมและศาสนาอย่างเห็นภาพชัดเจน",
      "ข้อมูลสถิติทางเศรษฐกิจในยุคโบราณมีบันทึกน้อยกว่ายุคใหม่",
    ],
  ),
)

leafIndustrialModern = DecisionNode(
  "leaf_industrial_modern",
  null,
  null,
  DecisionLeaf(
    "ศึกษาประวัติศาสตร์การปฏิวัติอุตสาหกรรมและเศรษฐกิจโลก (Industrial & Economic History)",
    "วิเคราะห์การกำเนิดเครื่องจักรไอน้ำ รถไฟ ระบบธนาคาร ตลาดทุน และการขยายตัวของเมืองใหญ่ เพื่อเข้าใจวิวัฒนาการสู่เศรษฐกิจดิจิทัล",
    [
      "ประยุกต์ใช้ทำความเข้าใจการปฏิวัติอุตสาหกรรมระลอก 4 (AI/Automation) ในปัจจุบันได้ดีเยี่ยม",
      "ต้องเข้าใจสถิติและตัวแปรทางเศรษฐศาสตร์เบื้องต้น",
    ],
  ),
)
