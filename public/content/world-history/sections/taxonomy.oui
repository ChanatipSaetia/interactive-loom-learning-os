taxonomyCategory = TaxonomyCategory(
  "อารยธรรมเมโสโปเตเมีย",
  "ดินแดนระหว่างแม่น้ำไทกริสและยูเฟรทีส",
  "Landmark",
  "peach",
  "แหล่งกำเนิดอารยธรรมที่เก่าแก่ที่สุดในโลก (ดินแดนพระจันทร์เสี้ยวอันอุดมสมบูรณ์) สร้างสรรค์อักษรรูปลิ่ม ซิกกูแรต และประมวลกฎหมายฮัมมูราบี",
  "ประกอบด้วยชนชาติต่างๆ เช่น สุเมเรียน บาบิโลน อัสซีเรีย มีผลงานสำคัญคือการแบ่งเวลา 60 นาที/วินาที และการชลประทาน",
  "เปรียบเสมือนห้องทดลองแรกเริ่มของมนุษยชาติในการสร้างระบบเมือง กฎหมาย และการเขียน",
  "การชลประทาน, การประดิษฐ์ตัวอักษร, ประมวลกฎหมายลายลักษณ์อักษร",
  ["อักษรรูปลิ่ม (Cuneiform)", "ประมวลกฎหมายฮัมมูราบี (ตาต่อตา ฟันต่อฟัน)", "ซิกกูแรต (Ziggurat)"],
  ["ระบบประชาธิปไตยโดยตรง"],
)

taxonomyCategory2 = TaxonomyCategory(
  "อารยธรรมอียิปต์โบราณ",
  "ของขวัญแห่งแม่น้ำไนล์ (Gift of the Nile)",
  "Pyramid",
  "yellow",
  "อารยธรรมที่รุ่งเรืองริมแม่น้ำไนล์ โดดเด่นด้วยสถาปัตยกรรมพีระมิด ความเชื่อเรื่องชีวิตหลังความตาย และระบบกษัตริย์ฟาโรห์ที่เป็นสมมติเทพ",
  "คิดค้นอักษรไฮโรกลิฟิกบนกระดาษปาปิรุส มีความก้าวหน้าทางการแพทย์ การทำมัมมี่ ดาราศาสตร์ และการคำนวณปฏิทินสุริยคติ 365 วัน",
  "เปรียบเหมือนอนุสรณ์สถานแห่งความศรัทธาและความเป็นอมตะที่ผสานวิทยาการเรขาคณิต",
  "การปกครองแบบเทวสิทธิ์, สถาปัตยกรรมหิน, การแพทย์และความเชื่อหลังความตาย",
  ["พีระมิดและมัมมี่", "อักษรไฮโรกลิฟิก (Hieroglyphs)", "ระบบฟาโรห์และการเกษตรลุ่มน้ำไนล์"],
  ["ระบบปรัชญาวิพากษ์แบบกรีก"],
)

taxonomyCategory3 = TaxonomyCategory(
  "อารยธรรมกรีกและโรมัน",
  "รากฐานอารยธรรมตะวันตกคลาสสิก",
  "Columns",
