root = Flashcards(
  "คำศัพท์และมโนทัศน์สำคัญ",
  [cuneiform, feudalism, renaissance, industrialRev, coldWar, silkRoad],
)

cuneiform = Flashcard(
  "cuneiform",
  "Cuneiform (อักษรรูปลิ่ม)",
  "kyoo-nee-uh-fawrm",
  "civilization",
  "ระบบการเขียนยุคแรกสุดของโลก ประดิษฐ์โดยชาวสุเมเรียนในเมโสโปเตเมีย",
  "อักษรรูปลิ่มเขียนโดยใช้ก้านอ้อกดลงบนแผ่นดินเหนียวเปียกแล้วนำไปตากแห้งหรือเผาไฟ เป็นจุดเริ่มต้นของการบันทึกประวัติศาสตร์ กฎหมาย และการค้า",
  "ถือเป็นจุดแบ่งแยกระหว่างยุคก่อนประวัติศาสตร์และยุคประวัติศาสตร์ของมนุษยชาติอย่างเป็นทางการ",
)

feudalism = Flashcard(
  "feudalism",
  "Feudalism (ระบบฟิวดัล / ศักดินาสวามิภักดิ์)",
  "fyoo-dl-iz-uhm",
  "society",
  "โครงสร้างความสัมพันธ์ทางสังคม การเมือง และการถือครองที่ดินในยุโรปยุคกลาง",
  "เป็นระบบลำดับขั้นที่กษัตริย์พระราชทานที่ดินแก่ขุนนาง (Lords) แลกกับความจงรักภักดีและกำลังทหาร โดยมีอัศวิน (Knights) ให้ความคุ้มครอง และชาวนาทาสติดที่ดิน (Serfs) เป็นผู้เพาะปลูก",
  "กำหนดระเบียบสังคม เศรษฐกิจ และความมั่นคงของยุโรปเป็นเวลานานเกือบพันปีก่อนเกิดรัฐชาติสมัยใหม่",
)

renaissance = Flashcard(
  "renaissance",
  "Renaissance (ยุคฟื้นฟูศิลปวิทยาการ)",
  "ren-uh-sahns",
  "culture",
  "ขบวนการฟื้นฟูศิลปะ วรรณกรรม และวิทยาการคลาสสิกของกรีก-โรมัน เกิดขึ้นในอิตาลีช่วงศตวรรษที่ 14-17",
  "เน้นแนวคิดมนุษยนิยม (Humanism) ที่เชื่อมั่นในคุณค่า ศักยภาพ และเหตุผลของมนุษย์ ก่อให้เกิดผลงานศิลปะชิ้นเอกและการตั้งคำถามต่อความเชื่องมงาย",
  "เป็นสะพานเชื่อมระหว่างยุคกลางอันมืดมนสู่ยุคใหม่ และเป็นรากฐานของการปฏิวัติวิทยาศาสตร์",
)

industrialRev = Flashcard(
  "industrial-rev",
  "Industrial Revolution (การปฏิวัติอุตสาหกรรม)",
  "in-duhs-tree-uhl rev-uh-loo-shuhn",
  "economy",
  "การเปลี่ยนผ่านจากกระบวนการผลิตด้วยมือและแรงงานสัตว์สู่การใช้เครื่องจักรและระบบโรงงาน",
  "เริ่มต้นในอังกฤษช่วงศตวรรษที่ 18 ด้วยการประดิษฐ์เครื่องจักรไอน้ำของเจมส์ วัตต์ ขยายสู่การคมนาคมรถไฟ และการเติบโตอย่างรวดเร็วของสังคมเมือง (Urbanization)",
  "เพิ่มกำลังการผลิตอย่างมหาศาล สร้างระบบทุนนิยมสมัยใหม่ และก่อให้เกิดการเปลี่ยนแปลงโครงสร้างชนชั้นแรงงาน",
)

coldWar = Flashcard(
  "cold-war",
  "Cold War (สงครามเย็น)",
  "kohld wawr",
  "politics",
  "ความขัดแย้งและการแข่งขันทางอุดมการณ์ระหว่างค่ายเสรีประชาธิปไตย (นำโดยสหรัฐฯ) และค่ายคอมมิวนิสต์ (นำโดยสหภาพโซเวียต)",
  "ดำเนินอยู่ระหว่าง ค.ศ. 1947–1991 ไม่มีการปะทะทางทหารโดยตรงระหว่างสองมหาอำนาจ แต่แข่งขันผ่านสงครามตัวแทน (Proxy Wars) การสะสมอาวุธนิวเคลียร์ และการแข่งขันด้านอวกาศ",
  "กำหนดภูมิรัฐศาสตร์และความสัมพันธ์ระหว่างประเทศทั่วโลกในครึ่งหลังของศตวรรษที่ 20",
)

silkRoad = Flashcard(
  "silk-road",
  "Silk Road (เส้นทางสายไหม)",
  "silk rohd",
  "trade",
  "เครือข่ายเส้นทางการค้าโบราณที่เชื่อมต่อระหว่างเอเชียตะวันออก ตะวันออกกลาง และยุโรป",
  "นอกจากจะเป็นเส้นทางขนส่งสินค้ามีค่า เช่น ผ้าไหม เครื่องเทศ เครื่องเคลือบดินเผา ยังเป็นช่องทางแลกเปลี่ยนศาสนา เทคโนโลยี และวัฒนธรรมข้ามทวีป",
  "เป็นตัวอย่างแรกเริ่มของระบบการค้าข้ามทวีปและโลกาภิวัตน์ในโลกยุคโบราณ",
)
