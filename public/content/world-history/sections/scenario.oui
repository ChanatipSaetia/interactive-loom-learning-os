root = Scenario(
  "สถานการณ์จำลอง: วิกฤตการณ์ประวัติศาสตร์",
  "industrial_era_crisis",
  [
    start,
    nodeReformPath,
    nodeSuppressPath,
    outcomeSustainableLeader,
    outcomeTariffProtection,
    outcomeDelayedPeace,
    outcomeRevolutionDisaster,
  ],
  "คุณเป็นผู้นำประเทศในยุคศตวรรษที่ 19 โรงงานอุตสาหกรรมกำลังขยายตัวอย่างรวดเร็ว แต่เกิดความตึงเครียดเรื่องสภาพความเป็นอยู่ของคนงาน มลพิษ และสินค้าล้นตลาด คุณจะเลือกตัดสินใจอย่างไร?",
  null,
  "วิกฤตการณ์เปลี่ยนผ่านสู่ยุคอุตสาหกรรม",
  "สวมบทบาทผู้นำในการตัดสินใจแก้ปัญหาวิกฤตการณ์เศรษฐกิจและสังคม",
)

start = ScenarioNode(
  "start",
  "ปัญหาแรกที่ต้องเผชิญ: สหภาพแรงงานชุมนุมประท้วงสภาพการทำงาน 14 ชั่วโมงต่อวันและค่าจ้างต่ำ คุณจะรับมืออย่างไร?",
  [
    ScenarioChoice(
      "pass_reforms",
      "เปิดการเจรจาและตรากฎหมายคุ้มครองแรงงาน (จำกัดเวลาทำงาน 10 ชม. จัดระบบสุขอนามัย)",
      "node_reform_path",
    ),
    ScenarioChoice(
      "suppress_protest",
      "ใช้กำลังทหารเข้าสลายการชุมนุมเพื่อปกป้องผลประโยชน์ของนายทุนและรักษาระเบียบโรงงาน",
      "node_suppress_path",
    ),
  ],
)

nodeReformPath = ScenarioNode(
  "node_reform_path",
  "การปฏิรูปทำให้แรงงานสงบลง แต่นายทุนเริ่มกังวลเรื่องต้นทุนการผลิตที่สูงขึ้น คุณจะส่งเสริมเศรษฐกิจอย่างไรต่อไป?",
  [
    ScenarioChoice(
      "invest_innovation",
      "สนับสนุนเงินกู้และการศึกษาวิจัยเพื่อพัฒนาเครื่องจักรและระบบรถไฟขนส่ง",
      "outcome_sustainable_leader",
    ),
    ScenarioChoice(
      "impose_tariffs",
      "ตั้งกำแพงภาษีนำเข้าสูงเพื่อกีดกันสินค้าต่างชาติและปกป้องโรงงานในประเทศ",
      "outcome_tariff_protection",
    ),
  ],
)

nodeSuppressPath = ScenarioNode(
  "node_suppress_path",
  "การสลายการชุมนุมทำให้เกิดความโกรธแค้นใต้ดินและเสี่ยงต่อการปฏิวัติล้มล้าง คุณจะแก้สถานการณ์อย่างไร?",
  [
    ScenarioChoice(
      "concession_late",
      "ยอมประนีประนอมในภายหลังและมอบสวัสดิการบางส่วนเพื่อคลายความตึงเครียด",
      "outcome_delayed_peace",
    ),
    ScenarioChoice(
      "authoritarian_rule",
      "เพิ่มมาตรการควบคุมเข้มงวดและปิดกั้นสื่อหนังสือพิมพ์ทั้งหมด",
      "outcome_revolution_disaster",
    ),
  ],
)

outcomeSustainableLeader = ScenarioNode(
  "outcome_sustainable_leader",
  null,
  null,
  Outcome(
    "คุณนำพาประเทศสู่มหาอำนาจทางอุตสาหกรรมได้อย่างยั่งยืน!",
    "การปฏิรูปแรงงานควบคู่กับการลงทุนในนวัตกรรมช่วยสร้างเสถียรภาพทางสังคมและกระตุ้นการเติบโตทางเศรษฐกิจในระยะยาวได้อย่างแท้จริง",
    "a",
  ),
)

outcomeTariffProtection = ScenarioNode(
  "outcome_tariff_protection",
  null,
  null,
  Outcome(
    "เศรษฐกิจในประเทศเติบโต แต่เกิดสงครามการค้ากับประเทศเพื่อนบ้าน",
    "การตั้งกำแพงภาษีช่วยปกป้องอุตสาหกรรมภายในระยะสั้น แต่ลดทอนประสิทธิภาพการแข่งขันในระดับสากล",
    "b-plus",
  ),
)

outcomeDelayedPeace = ScenarioNode(
  "outcome_delayed_peace",
  null,
  null,
  Outcome(
    "รอดพ้นจากการลุกฮือมาได้ แต่สูญเสียความเชื่อมั่นทางการเมืองไปมาก",
    "การปฏิรูปที่ล่าช้าหลังเกิดความรุนแรงทำให้ต้องเสียต้นทุนทางสังคมสูงกว่าการแก้ปัญหาตั้งแต่แรกเริ่ม",
    "b-minus",
  ),
)

outcomeRevolutionDisaster = ScenarioNode(
  "outcome_revolution_disaster",
  null,
  null,
  Outcome(
    "เกิดการลุกฮือปฏิวัติทั่วประเทศ ระบบเศรษฐกิจและการปกครองพังทลาย",
    "การกดขี่โดยไร้การประนีประนอมในยุคแห่งการตื่นรู้ของประชาชนนำไปสู่จุดจบอันหายนะของระบอบการปกครอง",
    "c",
  ),
)
