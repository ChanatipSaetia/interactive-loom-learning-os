root = ReflectionTemplate(
  "สังเคราะห์บทเรียนการเปลี่ยนแปลง",
  [challenge1, challenge2, challenge3, challenge4, challenge5],
  "วิเคราะห์สาเหตุและผลกระทบของจุดเปลี่ยนสำคัญในประวัติศาสตร์โลก",
)

challenge1 = TemplateChallenge(
  "เติมคำในช่องว่างเพื่ออธิบายการเปลี่ยนผ่านสู่ยุคใหม่และการปฏิวัติอุตสาหกรรม (Part 1):",
  "การประดิษฐ์แท่นพิมพ์ของกูเทนแบร์กช่วยให้ความรู้แพร่กระจายอย่าง {zone-1} ส่งผลให้เกิดยุคฟื้นฟูศิลปวิทยาการ ต่อมาการพัฒนาเครื่องจักรไอน้ำทำให้เกิดการผลิตสินค้าในปริมาณที่ {zone-2} มากขึ้น และทำให้ประชากรย้ายถิ่นฐานเข้าสู่เขต {zone-3} อย่างรวดเร็ว",
  [
    Chip("chip-fast", "รวดเร็วและกว้างขวาง"),
    Chip("chip-slow", "จำกัดเฉพาะชนชั้นสูง"),
    Chip("chip-mass", "มหาศาลแบบอุตสาหกรรม"),
    Chip("chip-few", "ลดน้อยลง"),
    Chip("chip-urban", "เมืองใหญ่ (Urbanization)"),
    Chip("chip-rural", "ชนบทห่างไกล"),
  ],
  {"zone-1": "chip-fast", "zone-2": "chip-mass", "zone-3": "chip-urban"},
  "<strong>ยอดเยี่ยม!</strong> แท่นพิมพ์ทำให้ความรู้หลุดพ้นจากการผูกขาดของศาสนจักร นำไปสู่การปฏิวัติวิทยาศาสตร์ ส่วนเครื่องจักรไอน้ำทำให้โรงงานต้องการแรงงานจำนวนมาก จึงเกิดการขยายตัวของเมืองใหญ่ (Urbanization)",
)

challenge2 = TemplateChallenge(
  "เติมคำในช่องว่างเพื่ออธิบายความเปลี่ยนแปลงหลังสงครามโลกครั้งที่ 2 (Part 2):",
  "หลังปี ค.ศ. 1945 โลกเข้าสู่ยุคสงครามเย็น ซึ่งเป็นการแข่งขันทางอุดมการณ์ระหว่างระบอบเสรีประชาธิปไตยและ {zone-1} โดยมหาอำนาจหลีกเลี่ยงสงครามนิวเคลียร์โดยตรง แต่หันไปสู้รบผ่าน {zone-2} ในภูมิภาคต่างๆ แทน",
  [
    Chip("chip-communist", "คอมมิวนิสต์"),
    Chip("chip-feudal", "ศักดินาโบราณ"),
    Chip("chip-proxy", "สงครามตัวแทน (Proxy Wars)"),
    Chip("chip-space-only", "การแข่งขันกีฬาเท่านั้น"),
  ],
  {"zone-1": "chip-communist", "zone-2": "chip-proxy"},
  "<strong>ถูกต้อง!</strong> สงครามเย็นคือการแข่งขันระหว่างค่ายเสรีนิยมทุนนิยม (สหรัฐฯ) กับค่ายคอมมิวนิสต์ (สหภาพโซเวียต) ซึ่งเกิดสงครามตัวแทน เช่น สงครามเกาหลีและสงครามเวียดนาม",
)

challenge3 = TemplateChallenge(
  "เติมคำในช่องว่างเพื่ออธิบายปัจจัยการกำเนิดอารยธรรมลุ่มแม่น้ำโบราณ (Part 3):",
  "อารยธรรมยุคโบราณมักกำเนิดบริเวณลุ่มแม่น้ำใหญ่ เช่น ดินแดนพระจันทร์เสี้ยวอันอุดมสมบูรณ์ในเมโสโปเตเมียและลุ่มแม่น้ำไนล์ เพราะมี {zone-1} ที่อุดมด้วยแร่ธาตุจากการท่วมของแม่น้ำ ทำให้มนุษย์ต้องร่วมมือกันพัฒนาระบบ {zone-2} ซึ่งกลายเป็นรากฐานของการรวมศูนย์อำนาจและการเกิด {zone-3}",
  [
    Chip("chip-silt", "ดินตะกอนอันอุดมสมบูรณ์"),
    Chip("chip-sand", "ทะเลทรายแห้งแล้ง"),
    Chip("chip-irrigation", "การชลประทานและคูคลอง"),
    Chip("chip-random-flood", "การปล่อยให้น้ำท่วมตามยถากรรม"),
    Chip("chip-city-state", "นครรัฐและการจัดระเบียบสังคม"),
    Chip("chip-nomad", "ชนเผ่าเร่ร่อนไร้ผู้นำ"),
  ],
  {"zone-1": "chip-silt", "zone-2": "chip-irrigation", "zone-3": "chip-city-state"},
  "<strong>ถูกต้อง!</strong> การเกษตรในเขตแม่น้ำต้องการการจัดการน้ำและการชลประทานขนาดใหญ่ ทำให้สังคมต้องมีผู้นำ กฎหมาย และแรงงาน เกิดเป็นนครรัฐและอารยธรรมแรกของโลก",
)

challenge4 = TemplateChallenge(
  "เติมคำในช่องว่างเพื่ออธิบายมรดกทางการเมืองของกรีกและโรมัน (Part 4):",
  "นครรัฐเอเธนส์เป็นผู้ริเริ่มระบอบ {zone-1} ที่เปิดโอกาสให้พลเมืองชายร่วมอภิปรายและลงคะแนน ขณะที่จักรวรรดิโรมันได้วางรากฐานของ {zone-2} โดยการบันทึกข้อกฎหมายเป็นลายลักษณ์อักษร เพื่อสร้างความเท่าเทียมและจำกัดการใช้อำนาจตามอำเภอใจ",
  [
    Chip("chip-direct-democracy", "ประชาธิปไตยทางตรง"),
    Chip("chip-monarchy", "สมบูรณาญาสิทธิราชย์เบ็ดเสร็จ"),
    Chip("chip-rule-of-law", "หลักนิติธรรมและประมวลกฎหมาย"),
    Chip("chip-anarchy", "ความไร้ระเบียบกฎเกณฑ์"),
  ],
  {"zone-1": "chip-direct-democracy", "zone-2": "chip-rule-of-law"},
  "<strong>ยอดเยี่ยม!</strong> กรีกมอบแนวคิดเรื่องเสรีภาพและการมีส่วนร่วมของพลเมือง ส่วนโรมันมอบโครงสร้างระบบกฎหมายและนิติรัฐที่ยังใช้อ้างอิงจนถึงปัจจุบัน",
)

challenge5 = TemplateChallenge(
  "เติมคำในช่องว่างเพื่อสังเคราะห์ระบบฟิวดัลและศาสนจักรในยุคกลาง (Part 5):",
  "ในยุคกลาง ยุโรปกระจายอำนาจผ่านระบบศักดินา โดยกษัตริย์มอบที่ดินให้แก่ {zone-1} เพื่อแลกกับความภักดีและกำลังทหาร ขณะเดียวกัน {zone-2} ทำหน้าที่เป็นศูนย์รวมจิตใจและสถาบันเดียวที่มีอิทธิพลครอบคลุมทั่วยุโรป จนกระทั่งเกิด {zone-3} ที่ช่วยฟื้นฟูการค้าระหว่างยุโรปและเอเชีย",
  [
    Chip("chip-nobles", "ขุนนางและอัศวิน (Lords/Vassals)"),
    Chip("chip-slaves-only", "ทาสกรรมกรเท่านั้น"),
    Chip("chip-church", "ศาสนจักรคาทอลิก"),
    Chip("chip-merchants-guild", "สมาคมพ่อค้าเร่ร่อน"),
    Chip("chip-crusades", "สงครามครูเสด"),
    Chip("chip-world-war", "สงครามโลก"),
  ],
  {"zone-1": "chip-nobles", "zone-2": "chip-church", "zone-3": "chip-crusades"},
  "<strong>สมบูรณ์แบบ!</strong> ระบบฟิวดัลพึ่งพาขุนนางและอัศวินในระดับท้องถิ่น โดยมีศาสนจักรเป็นศูนย์กลางความเชื่อ และสงครามครูเสดได้กระตุ้นการค้าและนำวิทยาการจากตะวันออกกลางกลับเข้าสู่ยุโรป",
)
