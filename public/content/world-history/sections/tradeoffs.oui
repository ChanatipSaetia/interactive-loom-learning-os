root = TradeoffSandbox(
  "ยุทธศาสตร์และทางเลือกในประวัติศาสตร์",
  [ancientTradeRoutes, industrialPolicyBalance],
  "ทดลองชั่งน้ำหนักผลกระทบจากการตัดสินใจเชิงนโยบายและยุทธศาสตร์สำคัญ",
)

ancientTradeRoutes = TradeoffScenario(
  "ancient-trade-routes",
  "ยุทธศาสตร์เส้นทางการค้าระหว่างประเทศ (Silk Road vs Maritime Route)",
  [
    TradeoffMetric("trade_volume", "ปริมาณสินค้าที่ขนส่งได้ (Trade Volume)", 50, 0, 100, "higher"),
    TradeoffMetric(
      "security",
      "ความปลอดภัยจากโจร/ภัยธรรมชาติ (Route Security)",
      50,
      0,
      100,
      "higher",
    ),
    TradeoffMetric(
      "diplomatic_reach",
      "การแผ่ขยายอิทธิพลทางการทูต (Diplomatic Reach)",
      50,
      0,
      100,
      "higher",
    ),
    TradeoffMetric(
      "maintenance_cost",
      "ประสิทธิภาพด้านต้นทุน (Cost Efficiency)",
      50,
      0,
      100,
      "higher",
    ),
  ],
  [primaryRoute, protectionStrategy],
  "จำลองการตัดสินใจของอาณาจักรโบราณในการเลือกลงทุนระหว่างเส้นทางสายไหมทางบก (Caravan) และเส้นทางเดินเรือทางทะเล (Maritime)",
)

primaryRoute = TradeoffStep(
  "primary_route",
  "เลือกเส้นทางหลักในการค้า",
  [overlandSilk, maritimeFleet],
  "กำหนดรูปแบบการขนส่งสินค้าหลักของอาณาจักร",
  "maritime-fleet",
)

overlandSilk = TradeoffChoice(
  "overland-silk",
  "เส้นทางสายไหมทางบก (Overland Silk Road)",
  "ใช้คาราวานอูฐและม้า เดินทางผ่านโอเอซิสและเมืองหน้าด่านในเอเชียกลาง",
  {trade_volume: -10, security: -15, diplomatic_reach: 20, maintenance_cost: -5},
  [
    ProCon("เข้าถึงเมืองรายทาง", "สร้างความสัมพันธ์กับชนเผ่าและอาณาจักรย่อยตามเส้นทางได้โดยตรง"),
    ProCon("เหมาะกับสินค้าล้ำค่าขนาดเล็ก", "เช่น ผ้าไหม หยก เครื่องประดับ อัญมณี"),
  ],
  [
    ProCon("เสี่ยงภัยโจรทะเลทราย", "ต้องจ่ายค่าผ่านทางและเสี่ยงต่อการถูกปล้นชิง"),
    ProCon("ขนสินค้าหนักได้จำกัด", "ความจุของสัตว์บรรทุกมีขีดจำกัด"),
  ],
  null,
  "เหมาะสมเมื่อต้องการแผ่ขยายอิทธิพลทางวัฒนธรรมในแผ่นดินใหญ่และค้าขายสินค้าหรูหราน้ำหนักเบา",
)

maritimeFleet = TradeoffChoice(
  "maritime-fleet",
  "เส้นทางสายไหมทางทะเล (Maritime Silk Route)",
  "สร้างกองเรือสำเภาขนาดใหญ่ ขนส่งสินค้าข้ามมหาสมุทรอินเดียและทะเลจีนใต้",
  {trade_volume: 25, security: 10, diplomatic_reach: 10, maintenance_cost: 15},
  [
    ProCon("ขนส่งปริมาณมหาศาล", "เรือหนึ่งลำจุสินค้าได้เท่ากับคาราวานอูฐหลายร้อยตัว"),
    ProCon("ขนสินค้าขนาดใหญ่ได้", "เช่น เครื่องเทศ เครื่องเคลือบดินเผา ชา ข้าวสาร"),
  ],
  [
    ProCon("เสี่ยงภัยพายุและลมมรสุม", "ต้องพึ่งพาทิศทางลมตามฤดูกาล"),
    ProCon("ต้องลงทุนต่อเรือสูง", "ต้องใช้ทักษะการต่อเรือและการเดินเรือขั้นสูง"),
  ],
  "เส้นทางทางทะเลช่วยขยายปริมาณการค้าอย่างก้าวกระโดดและลดต้นทุนต่อหน่วยได้อย่างมีนัยสำคัญ",
)

protectionStrategy = TradeoffStep(
  "protection_strategy",
  "ยุทธศาสตร์การคุ้มกันการค้า",
  [fortressChain, navalPatrol],
  "เลือกแนวทางการรักษาความปลอดภัยของเส้นทาง",
  "naval-patrol",
)

fortressChain = TradeoffChoice(
  "fortress-chain",
  "สร้างป้อมปราการและกองทหารประจำด่าน",
  "ตั้งป้อมทหารตลอดเส้นทางบกเพื่อคุ้มกันพ่อค้า",
  {trade_volume: 5, security: 20, diplomatic_reach: 10, maintenance_cost: -20},
  [ProCon("ความปลอดภัยสูงสุด", "ปราบปรามโจรผู้ร้ายได้อย่างเฉียบขาด")],
  [ProCon("งบประมาณมหาศาล", "ต้องจ่ายเบี้ยเลี้ยงทหารและค่าบำรุงรักษาป้อมปราการตลอดเวลา")],
  null,
  "เหมาะกับยุคที่อาณาจักรมีงบประมาณทหารเหลือเฟือและเผชิญภัยคุกคามจากชนเผ่าเร่ร่อนสูง",
)

navalPatrol = TradeoffChoice(
  "naval-patrol",
  "จัดตั้งกองเรือตรวจการและสนธิสัญญาเมืองท่า",
  "ส่งกองเรือคุ้มกันจุดยุทธศาสตร์และทำข้อตกลงกับเมืองท่าพันธมิตร",
  {trade_volume: 15, security: 10, diplomatic_reach: 15, maintenance_cost: 5},
  [ProCon("ยืดหยุ่นและครอบคลุม", "คุ้มกันช่องแคบสำคัญและเปิดตลาดใหม่ไปพร้อมกัน")],
  [ProCon("ควบคุมเมืองท่าห่างไกลได้ยาก", "ต้องอาศัยความไว้เนื้อเชื่อใจทางการทูต")],
  "กองเรือตรวจการคุ้มกันจุดยุทธศาสตร์ช่วยสร้างดุลยภาพระหว่างความปลอดภัยและต้นทุนที่มีประสิทธิภาพ",
)

industrialPolicyBalance = TradeoffScenario(
  "industrial-policy-balance",
  "นโยบายการปฏิรูปในยุคการปฏิวัติอุตสาหกรรม",
  [
    TradeoffMetric(
      "gdp_growth",
      "การเติบโตของผลผลิตอุตสาหกรรม (Production Growth)",
      50,
      0,
      100,
      "higher",
    ),
    TradeoffMetric(
      "worker_wellbeing",
      "คุณภาพชีวิตและสวัสดิภาพแรงงาน (Worker Welfare)",
      40,
      0,
      100,
      "higher",
    ),
    TradeoffMetric(
      "social_stability",
      "เสถียรภาพทางสังคมและการเมือง (Social Stability)",
      45,
      0,
      100,
      "higher",
    ),
    TradeoffMetric(
      "innovation_pace",
      "ความเร็วในการสร้างนวัตกรรม (Innovation Speed)",
      50,
      0,
      100,
      "higher",
    ),
  ],
  [laborRegulations],
  "ชั่งน้ำหนักการจัดสมดุลระหว่างการเร่งขยายตัวทางเศรษฐกิจกับการคุ้มครองคุณภาพชีวิตแรงงานและสิ่งแวดล้อม",
)

laborRegulations = TradeoffStep(
  "labor_regulations",
  "กฎหมายคุ้มครองแรงงาน",
  [laissezFaire, balancedFactoryAct],
  "กำหนดชั่วโมงทำงานและเกณฑ์อายุแรงงานขั้นต่ำ",
  "balanced-factory-act",
)

laissezFaire = TradeoffChoice(
  "laissez-faire",
  "ปล่อยเสรีเต็มที่ (Laissez-Faire)",
  "ไม่จำกัดชั่วโมงทำงาน เพื่อให้โรงงานเดินเครื่องตลอด 24 ชม.",
  {gdp_growth: 20, worker_wellbeing: -25, social_stability: -20, innovation_pace: 10},
  [ProCon("กำไรของนายทุนสูงสุด", "ผลิตสินค้าได้ปริมาณมหาศาลในราคาถูก")],
  [ProCon("แรงงานเด็กและสภาพแวดล้อมอันตราย", "ก่อให้เกิดความคับแค้นใจและการประท้วงหยุดงาน")],
  null,
  "เป็นแนวคิดยุคแรกเริ่มของการปฏิวัติอุตสาหกรรมที่ยังไม่มีการจัดตั้งสหภาพแรงงาน",
)

balancedFactoryAct = TradeoffChoice(
  "balanced-factory-act",
  "กฎหมายโรงงานและจำกัดชั่วโมงทำงาน (Factory Acts)",
  "ห้ามใช้แรงงานเด็ก กำหนดเวลาทำงาน 10 ชั่วโมง/วัน และจัดระบบความปลอดภัย",
  {gdp_growth: 5, worker_wellbeing: 25, social_stability: 20, innovation_pace: 5},
  [
    ProCon("สังคมมีเสถียรภาพยั่งยืน", "ลดการก่อจลาจล และสร้างแรงงานที่มีสุขภาพดีในระยะยาว"),
    ProCon(
      "กระตุ้นการประดิษฐ์เครื่องจักรทุ่นแรง",
      "เมื่อใช้แรงงานคนไม่จำกัดไม่ได้ นายทุนจึงหันไปพัฒนาเทคโนโลยีทดแทน",
    ),
  ],
  [ProCon("ต้นทุนการผลิตเพิ่มขึ้นเล็กน้อย", "นายทุนต้องปรับตัวในระยะสั้น")],
  "การคุ้มครองแรงงานสร้างเสถียรภาพทางสังคมในระยะยาวและกระตุ้นการพัฒนานวัตกรรมเครื่องจักรทุ่นแรง",
)
