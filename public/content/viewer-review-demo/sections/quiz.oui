root = Quiz("13 · Quiz — Can the summary be shared?", [q1, q2])
q1 = QuizQuestion("q1", "A summary contains a claim with no supporting source. What should Sam do?", [QuizChoice("verify", "Verify it or remove it before sharing", true, "Keep the summary limited to what can be supported."), QuizChoice("trust", "Keep it because the wording sounds confident", false, "Confident wording does not establish evidence.")], "Check the connection between the claim and its source.")
q2 = QuizQuestion("q2", "What makes a comparison of support volume useful?", [QuizChoice("scope", "A clear date range and consistent channels", true, "A defined scope makes the comparison interpretable."), QuizChoice("length", "A longer answer with more adjectives", false, "Length does not fix an unclear comparison.")], "Compare like with like.")
