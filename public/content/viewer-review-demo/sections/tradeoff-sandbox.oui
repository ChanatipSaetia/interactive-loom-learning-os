root = TradeoffSandbox("16 · Tradeoff sandbox — Choose a research approach", [research])
research = TradeoffScenario("research", "A first-pass investigation", [speed, depth], [approach, verification, uncertainty, delivery], "Illustrative scores show a trade-off, not benchmark results.")
speed = TradeoffMetric("speed", "Speed", 50, 0, 100, "higher")
depth = TradeoffMetric("depth", "Evidence depth", 50, 0, 100, "higher")
approach = TradeoffStep("approach", "Evidence collection", [quick, thorough], "What does this first-pass question need?", "quick")
quick = TradeoffChoice("quick", "Focused search", "Search the most relevant report first.", {speed: 25, depth: -10}, [ProCon("Fast first answer")], [ProCon("Narrow coverage", "May miss evidence in other channels")], "Start with the most relevant report to answer a clearly scoped question quickly.")
thorough = TradeoffChoice("thorough", "Cross-source review", "Compare records, documents and feedback.", {speed: -15, depth: 30}, [ProCon("Broader context")], [ProCon("More review time", "Extra sources take time to inspect")], "Use a broader investigation when the initial report leaves important gaps.")
verification = TradeoffStep("verification", "Review before sharing", [human, automatic], "Who checks that each material claim is supported?", "human")
human = TradeoffChoice("human", "Human source check", "Sam opens the cited sources before sharing.", {speed: -15, depth: 25}, [ProCon("Traceable findings")], [ProCon("Extra review time", "Someone must inspect the citations")], "A short human check catches unsupported claims before the summary is used in a meeting.")
automatic = TradeoffChoice("automatic", "Automated checks only", "Share after checking that citation links are present.", {speed: 20, depth: -15}, [ProCon("Faster handoff")], [ProCon("Weak evidence check", "A working link does not prove that a claim is supported")], "Useful for a private draft that will receive a separate review before anyone relies on it.")
uncertainty = TradeoffStep("uncertainty", "Handle missing evidence", [flag, infer], "What should happen when a source does not support a claim?", "flag")
flag = TradeoffChoice("flag", "Flag the evidence gap", "Remove unsupported claims and state what is still unknown.", {speed: -5, depth: 10}, [ProCon("Clear limits")], [ProCon("Less complete answer", "Some questions remain open")], "Visible gaps keep the team from treating an assumption as a finding.")
infer = TradeoffChoice("infer", "Include a labeled hypothesis", "Keep a possible explanation clearly marked as unverified.", {speed: 10, depth: -15}, [ProCon("More ideas to explore")], [ProCon("Risk of confusion", "Readers may mistake the hypothesis for a finding")], "Useful during brainstorming when someone will test the explanation later.")
delivery = TradeoffStep("delivery", "Choose the handoff format", [brief, appendix], "How will the team review the result?", "brief")
brief = TradeoffChoice("brief", "Source-linked brief", "Share the key findings with citations and limitations.", {speed: 10, depth: 0}, [ProCon("Quick to review")], [ProCon("Less background", "Readers must open sources for detail")], "A short meeting needs a concise summary with inspectable sources.")
appendix = TradeoffChoice("appendix", "Full evidence appendix", "Attach detailed extracts and the complete review notes.", {speed: -15, depth: 5}, [ProCon("More review context")], [ProCon("Longer reading time", "The key findings may be harder to find")], "Use when reviewers need to audit the investigation in depth.")
