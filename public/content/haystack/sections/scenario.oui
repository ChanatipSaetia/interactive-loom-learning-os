root = Scenario(
  "Architecture Decision Scenario",
  "haystack-design",
  [start, bm25Outcome, vectorOutcome, hybridOutcome],
  "Your company needs a search system for its knowledge base. You've chosen Haystack. How do you design it?",
  null,
  "Designing a Search System",
)

start = ScenarioNode(
  "start",
  "Your knowledge base has 50,000 documents in multiple languages. Users search with natural language questions. What retrieval strategy do you choose?",
  [
    ScenarioChoice("bm25", "BM25 keyword search only — it's fast and simple", "bm25-outcome"),
    ScenarioChoice(
      "vector",
      "Dense vector search — captures semantic meaning across languages",
      "vector-outcome",
    ),
    ScenarioChoice("hybrid", "Hybrid BM25 + vectors with Reciprocal Rank Fusion", "hybrid-outcome"),
  ],
)

bm25Outcome = ScenarioNode(
  "bm25-outcome",
  null,
  null,
  Outcome(
    "Users find exact product codes but struggle with conceptual questions. Cross-language queries fail entirely.",
    "BM25 alone cannot handle semantic understanding or cross-language matching. For natural language questions, you need vector search.",
    "c",
  ),
)

vectorOutcome = ScenarioNode(
  "vector-outcome",
  null,
  null,
  Outcome(
    "Conceptual queries work well, but users miss documents with specific IDs, codes, or exact terms.",
    "Vector search misses exact keyword matches. A hybrid approach covering both strengths is the production standard.",
    "b-minus",
  ),
)

hybridOutcome = ScenarioNode(
  "hybrid-outcome",
  null,
  null,
  Outcome(
    "Users find both conceptual answers and exact terms. The RRF fusion combines scores seamlessly without tuning.",
    "Hybrid retrieval is the recommended production default — it covers the full spectrum of search needs.",
    "a",
  ),
)
