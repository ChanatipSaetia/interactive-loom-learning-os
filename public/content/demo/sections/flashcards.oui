root = Flashcards(
  "Key Vocabulary",
  [hierarchy, whitespace, contrast, affordance, consistency, fluidity, typography, animations],
)

hierarchy = Flashcard(
  "hierarchy",
  "Visual Hierarchy",
  "vizh-oo-uhl hahy-er-ahr-kee",
  "hierarchy",
  "Arranging UI elements in order of visual importance using scale, contrast, and weight.",
  "Visual hierarchy guides the user's eyes through an interface. Instead of specifying hardcoded fonts, instruct the AI to analyze element importance first and ask clarification questions to align on size scaling, weight contrast, and visual density.",
  "If you instruct an AI vaguely, it defaults to a uniform, boring structure. Prompting the AI to think about hierarchy and ask for clarification forces it to design with distinct focal points rather than generic, monotonous text blocks.",
)

whitespace = Flashcard(
  "whitespace",
  "Negative Space (Whitespace)",
  "neg-uh-tiv speys",
  "layout",
  "The empty breathing room surrounding and between UI components that groups elements and enhances legibility.",
  "Negative space is an active design tool that organizes content without physical borders. Ask the AI to plan a spacing hierarchy (margins, padding, gaps) first, and ask back about the desired layout density.",
  "AIs tend to default to conservative, tight spacing to save room. Asking the AI to analyze spacing and ask for your layout preferences prevents cluttered, claustrophobic designs and achieves clean, breathing breathing room.",
)

contrast = Flashcard(
  "contrast",
  "Color Contrast Ratio",
  "kuhl-er kon-trast rey-shee-oh",
  "accessibility",
  "The difference in light intensity between text/foreground elements and their background, ensuring maximum accessibility.",
  "Accessible web design requires a contrast ratio of at least 4.5:1. Ask the AI to evaluate color contrast mathematically and query you on strict accessibility compliance versus specific brand tint options.",
  "AIs often pair light gray text on light backgrounds to attempt a 'minimalist' look, violating readability standards. Instructing the AI to check contrast metrics first and ask for alignment ensures beautiful, readable, WCAG-friendly palettes.",
)

affordance = Flashcard(
  "affordance",
  "Interactive Affordance",
  "in-ter-ak-tiv uh-fawr-duhns",
  "interaction",
  "Visual signifiers that communicate how an element behaves and how users should interact with it.",
  "Interactive affordance makes buttons and inputs look clickable. Direct the AI to outline its planned interactive states (hover, focus, click transitions) first, and ask you to choose the tactile intensity of the feedback.",
  "Without prompting, AIs often render static, flat buttons that don't react to a cursor. Asking the AI to explain states and ask for alignment ensures buttons have clear interactive weight and satisfying feedback.",
)

consistency = Flashcard(
  "consistency",
  "Aesthetic Consistency",
  "es-thet-ik kuhn-sis-tuhn-see",
  "layout",
  "Using standardized, repeating design variables (typography, spacing, borders) to create a unified design system.",
  "Aesthetic consistency prevents visual chaos. Instruct the AI to design a mini design system (consistent corner radiuses, border weights, gap increments) and align with you on a styling motif.",
  "Without a consistency constraint, an AI might mix random styles (like highly rounded cards with sharp buttons). Declaring a unified motif and asking for confirmation makes the output feel extremely cohesive.",
)

fluidity = Flashcard(
  "fluidity",
  "Responsive Fluidity",
  "ri-spon-siv floo-id-i-tee",
  "layout",
  "Designing layouts that fluidly adapt, scale, and reorganize across all screens and window dimensions.",
  "Responsive fluidity adapts layouts to any viewport. Ask the AI to plan grid or flex structures first and query you on the breakpoint behavior and max-width layout thresholds.",
  "If you specify static pixel dimensions, the AI compiles hardcoded CSS that breaks on mobile. Ordering the AI to analyze responsive reflow and ask for parameters guarantees a mobile-optimized, fluid layout.",
)

typography = Flashcard(
  "typography",
  "Intentional Typography Pairings",
  "in-ten-shuh-nuhl tahy-pog-ruh-fee",
  "typography",
  "Using contrasting but complementary font families for titles and body text to convey a specific aesthetic mood.",
  "Type pairing combines an expressive, stylistic display face for headers with a neutral, highly readable font for body elements. Direct the AI to suggest pairing combinations and ask which one fits your brand.",
  "Without explicit directives, AIs fall back to generic system font stacks. Asking the AI to propose pairings and align on a visual mood adds immediate character and professional, editorial weight.",
)

animations = Flashcard(
  "animations",
  "Purposeful Micro-interactions",
  "pur-puhs-fuhl mahy-kroh-in-ter-ak-shuhnz",
  "interaction",
  "Subtle, organic UI transitions and animations that guide attention and confirm state changes.",
  "Micro-interactions use quick, physical transitions to smooth out state changes. Direct the AI to outline its animation durations and transition curves first, and ask for your preference on animation playfulness.",
  "When visual states change instantly, the transition feels robotic and jarring. Specifying physics curves and asking for alignment ensures high-end, responsive micro-animations.",
)
