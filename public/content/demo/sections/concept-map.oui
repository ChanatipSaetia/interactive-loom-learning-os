    ConceptLink(orchestrator, planner, "uses"),
    ConceptLink(workers, reactLoop, "executes"),
    ConceptLink(workers, tools, "invokes"),
    ConceptLink(reactLoop, memory, "reads from"),
    ConceptLink(reactLoop, feedbackLoop, "forms"),
    ConceptLink(planner, contextWindow, "constrained by"),
    ConceptLink(critic, workers, "reviews"),
    ConceptLink(critic, feedbackLoop, "feeds into"),
    ConceptLink(promptTemplate, orchestrator, "configures"),
    ConceptLink(promptTemplate, workers, "guides"),
    ConceptLink(memory, contextWindow, "fits within"),
    ConceptLink(feedbackLoop, orchestrator, "informs"),
    ConceptLink(benchmark, metric, "defines"),
