    ScenarioChoice(
      "engine-brake",
      "ใช้เกียร์ช่วยเบรก (Engine Brake) และพักเบรกเป็นระยะ",
      "engine-brake-outcome",
    ),
    ScenarioChoice("coast", "เลิกเบรกแล้วปล่อยให้รถไหลลงเขา", "coast-outcome"),
  ],
)

brakeFadeOutcome = ScenarioNode(
  "brake-fade-outcome",
  null,
  null,
  Outcome(
    "เบรกจมจากความร้อนสูง ทำให้เบรกไม่อยู่และเสี่ยงอุบัติเหตุรุนแรง",
    "เมื่อเบรกใช้งานหนักต่อเนื่อง ควรใช้เกียร์ช่วยเบรกและพักเบรกเป็นระยะเพื่อไม่ให้จานเบรกและผ้าเบรกร้อนเกินจุดทำงานปกติ",
    "c",
  ),
)

engineBrakeOutcome = ScenarioNode(
  "engine-brake-outcome",
  null,
  null,
  Outcome(
    "คุณควบคุมความเร็วได้ดีด้วยเกียร์และเบรกเป็นระยะ เบรกไม่ร้อนเกินไป",
    "การใช้เกียร์ช่วยเบรก (Engine Brake) เป็นวิธีที่ปลอดภัยที่สุดเมื่อลงเขาสูง ช่วยลดภาระของระบบเบรก",
