root = Quiz("ทดสอบความรู้", [q1, q2, q3, q4, q5, q6, q7, q8])

q1 = QuizQuestion(
  "q1",
  "ลูกสูบทำงานกี่จังหวะ?",
  [
    QuizChoice(
      "a",
      "2 จังหวะ (ดูด-คาย)",
      false,
      "เครื่องยนต์มอเตอร์ไซค์ส่วนใหญ่เป็น 4 จังหวะ ไม่ใช่ 2 จังหวะ",
    ),
    QuizChoice(
      "b",
      "4 จังหวะ (ดูด-อัด-ระเบิด-คาย)",
      true,
      "ถูกต้อง! เครื่องยนต์สันดาปภายในทำงาน 4 จังหวะ: ดูดส่วนผสมเข้า, อัดส่วนผสม, ระเบิดดันลูกสูบลง, คายไอเสียออก",
    ),
    QuizChoice("c", "6 จังหวะ", false, "เครื่องยนต์มอเตอร์ไซค์มาตรฐานใช้ 4 จังหวะ"),
  ],
  "คิดถึงการเคลื่อนที่ขึ้น-ลงของลูกสูบ",
)

q2 = QuizQuestion(
  "q2",
  "หัวเทียนทำหน้าที่อะไร?",
