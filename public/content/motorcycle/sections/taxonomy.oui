root = TaxonomyBrowser("ปัญหาและระบบมอเตอร์ไซค์", [engineSystem, drivetrain, taxonomyCategory])

engineSystem = TaxonomyCategory(
  "ระบบเครื่องยนต์ (Engine System)",
  "แหล่งกำเนิดพลังงานหลักของรถ",
  "Folder",
  "red",
  "ปัญหาที่ส่งผลโดยตรงต่อการสตาร์ทเครื่องยนต์หรือกำลังของเครื่องยนต์",
  "ระบบเครื่องยนต์มีปัญหาถือเป็นเรื่องใหญ่ที่สุด มักเกิดจากความร้อนสะสม หรือการขาดการบำรุงรักษาน้ำมันเครื่อง อาการที่พบคือ สตาร์ทไม่ติด, เครื่องร้อนจัด, มีควันขาวพุ่งออกจากท่อไอเสีย, หรือเร่งเครื่องแล้วมีเสียงดังผิดปกติภายในเครื่อง",
  "เหมือนหัวใจของร่างกายมนุษย์ หากหัวใจเต้นผิดจังหวะหรือหยุดทำงาน ร่างกายทั้งหมดก็ขยับไม่ได้",
  "ตรวจสอบระบบจุดระเบิด (หัวเทียน), ระบบจ่ายเชื้อเพลิง, และระบบหล่อลื่น (น้ำมันเครื่อง)",
  [
    "สตาร์ทไม่ติด หรือสตาร์ทติดยาก",
    "เครื่องร้อนจัด (Overheat)",
    "กินน้ำมันเครื่อง/ควันขาว",
    "เครื่องสั่นหรือมีเสียงดังคล้ายเหล็กกระทบกัน",
  ],
  ["ปัญหาล้อฝืด (มักเป็นที่เบรก)", "ระบบไฟส่องสว่างไม่ติด"],
)

drivetrain = TaxonomyCategory(
  "ระบบส่งกำลัง (Drivetrain)",
  "การถ่ายทอดกำลังสู่ล้อ",
  "Folder",
  "blue",
  "ปัญหาที่ทำให้เครื่องยนต์ทำงานปกติ แต่รถไม่เคลื่อนที่หรือวิ่งได้ไม่เต็มประสิทธิภาพ",
  "แม้เครื่องยนต์จะแรงแค่ไหน หากระบบส่งกำลังมีปัญหาก็เปล่าประโยชน์ ปัญหาในรถเกียร์มักเป็นโซ่หย่อน โซ่ตาย หรือคลัตช์ลื่น ในขณะที่รถออโตเมติกมักเป็นปัญหาสายพานยืด ชามสึก หรือเม็ดตุ้มน้ำหนักแตก",
  "เหมือนกระดูกและกล้ามเนื้อขาที่คอยส่งแรงจากร่างกายไปที่พื้น หากขาเจ็บก็วิ่งไม่ออก",
  "โซ่ สเตอร์ แผ่นคลัตช์ (รถเกียร์) หรือ สายพาน ชาม เม็ด (รถออโตเมติก)",
  [
    "เข้าเกียร์แล้วรถกระตุก",
    "เร่งเครื่องแล้วรอบขึ้นแต่รถไม่วิ่ง (คลัตช์ลื่น)",
    "มีเสียงแคร่กๆ เวลาขับขี่ (โซ่หย่อน)",
    "ความเร็วปลายหดหาย",
  ],
  ["เครื่องยนต์ดับกลางอากาศ", "เบรกไม่อยู่"],
)

taxonomyCategory = TaxonomyCategory(
  "ระบบช่วงล่างและเบรก",
  "ความปลอดภัยและการทรงตัว",
  "Folder",
  "green",
  "ระบบที่คอยรับแรงกระแทกและควบคุมการหยุดรถ",
  "ปัญหาช่วงล่างทำให้ควบคุมรถยากและเสี่ยงเกิดอุบัติเหตุสูง หากโช้คอัพแตกจะมีน้ำมันซึมและทำให้รถเด้งไม่หยุด ส่วนปัญหาเบรกอาจเกิดจากผ้าเบรกหมดจนเหล็กสีกับจานเบรก หรือมีฟองอากาศในระบบน้ำมันเบรก",
  "เหมือนรองเท้าและระบบประสาทสั่งการหยุด หากรองเท้าลื่นหรือสั่งหยุดไม่ได้ก็เตรียมตัวล้ม",
  "น้ำมันเบรก, ความหนาผ้าเบรก, ซีลโช้คอัพ, และลมยาง",
  [
    "เบรกจม เบรกไม่อยู่",
    "ตกหลุมแล้วมีเสียงกระแทกแรงๆ (โช้คยัน)",
    "คอรถฝืด เลี้ยวแล้วฝืนๆ (ลูกปืนคอแตก)",
    "หน้าส่ายเวลาขับความเร็วสูง",
  ],
  ["แฮนด์สั่นเพราะเครื่องยนต์สั่น", "ล้อหมุนไม่ไปเพราะเข้าเกียร์ค้าง"],
)
