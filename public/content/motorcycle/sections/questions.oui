// @openui "คำถามที่ต้องถามช่าง"
root = Stack(
  [
    TextContent("เมื่อรถมอเตอร์ไซค์มีปัญหาและต้องนำไปให้ช่างซ่อม การสื่อสารกับช่างให้เข้าใจตรงกันเป็นสิ่งสำคัญมาก นี่คือคำถามพื้นฐานที่คุณควรถามช่างเพื่อรักษาผลประโยชน์ของตนเอง:"),
    TextContent("สาเหตุของปัญหาคืออะไร? (เพื่อให้รู้ว่าเกิดจากอะไร จะได้หลีกเลี่ยงพฤติกรรมเสี่ยงในอนาคต)"),
    TextContent("ต้องเปลี่ยนอะไหล่ชิ้นไหนบ้าง? (สอบถามให้แน่ใจว่าเป็นอะไหล่แท้, อะไหล่เทียม หรืออะไหล่มือสอง)"),
    TextContent("ค่าใช้จ่ายทั้งหมดประมาณเท่าไหร่? (ควรถามให้ชัดเจนว่ารวมค่าแรงช่างแล้วหรือยัง)"),
    TextContent("ใช้เวลาซ่อมนานแค่ไหน? (รอรับได้เลย หรือต้องทิ้งรถไว้กี่วัน)"),
    TextContent("หลังจากการซ่อมมีการรับประกันหรือไม่? (เช่น รับประกันงานซ่อม 1 เดือน)"),
  ],
)
