root = DecisionTree(
  "วินิจฉัยปัญหารถมอเตอร์ไซค์",
  "motorcycle-diag",
  "symptom",
  [
    symptom,
    startCheck,
    powerCheck,
    brakeCheck,
    recElectric,
    recFuel,
    recChain,
    recClutch,
    recBrakeFluid,
    recBrakePad,
  ],
  "ตัวช่วยวินิจฉัยปัญหา",
)

symptom = DecisionNode(
  "symptom",
  "รถมีอาการแบบไหน?",
  [
    DecisionChoice(
      "no-start",
      "สตาร์ทไม่ติด",
      "start-check",
      "สตาร์ทไม่ติดเป็นปัญหาที่พบบ่อย มีหลายสาเหตุ",
    ),
    DecisionChoice(
      "no-power",
      "เร่งไม่ขึ้น หรือรอบขึ้นแต่รถไม่วิ่ง",
      "power-check",
      "อาการนี้มักเกี่ยวกับระบบส่งกำลังหรือระบบจุดระเบิด",
      true,
    ),
    DecisionChoice(
      "brake-issue",
      "เบรกจม หรือเบรกไม่อยู่",
      "brake-check",
      "ปัญหาระบบเบรกต้องแก้ไขทันทีเพื่อความปลอดภัย",
    ),
  ],
)

startCheck = DecisionNode(
  "start-check",
  "ลองฟังเสียงตอนสตาร์ท",
  [
    DecisionChoice(
      "no-sound",
      "ไม่มีเสียงอะไรเลย",
      "rec-electric",
      "ไม่มีเสียงอาจหมายถึงระบบไฟฟ้ามีปัญหา",
    ),
    DecisionChoice(
      "crank-no-fire",
      "เครื่องหมุนแต่ไม่ติด",
      "rec-fuel",
      "เครื่องหมุนได้แต่ไม่ติด มักเกี่ยวกับน้ำมันหรือหัวเทียน",
    ),
  ],
)

powerCheck = DecisionNode(
  "power-check",
  "ลองฟังเสียงเพิ่มเติม",
  [
    DecisionChoice(
      "chain-noise",
      "มีเสียงแคร่กๆ เวลาขับขี่",
      "rec-chain",
      "เสียงโซ่เป็นสัญญาณว่าระบบส่งกำลังมีปัญหา",
    ),
    DecisionChoice(
      "no-noise",
      "ไม่มีเสียงผิดปกติ แต่รอบขึ้นรถไม่วิ่ง",
      "rec-clutch",
      "คลัตช์ลื่นเป็นสาเหตุพบบ่อยของอาการนี้",
    ),
  ],
)

brakeCheck = DecisionNode(
  "brake-check",
  "ลองกดเบรกดู",
  [
    DecisionChoice(
      "brake-soft",
      "เบรกนุ่ม กดจมง่าย",
      "rec-brake-fluid",
      "เบรกนุ่มมักเกิดจากฟองอากาศหรือซีลแตก",
    ),
    DecisionChoice(
      "brake-slow",
      "เบรกแข็งแต่ไม่อยู่",
      "rec-brake-pad",
      "เบรกแข็งแต่ไม่อยู่อาจเพราะผ้าเบรกหมด",
    ),
  ],
)

recElectric = DecisionNode(
  "rec-electric",
  null,
  null,
  DecisionLeaf(
    "เช็คระบบไฟฟ้า: แบตเตอรี่, สวิตช์, ฟิวส์ และสตาร์ทเตอร์",
    "ถ้าไม่มีเสียงตอนสตาร์ท ให้เริ่มเช็คจากแบตเตอรี่ก่อน แล้วตามด้วยฟิวส์และสวิตช์ ถ้าแบตเตอรี่ดี อาจเป็นสตาร์ทเตอร์เสีย",
    ["การเช็คระบบไฟฟ้าทำได้เองเบื้องต้น", "ถ้าสตาร์ทเตอร์เสียอาจต้องส่งร้าน"],
  ),
)

recFuel = DecisionNode(
  "rec-fuel",
  null,
  null,
  DecisionLeaf(
    "เช็คหัวเทียนและระบบจ่ายน้ำมัน",
    "ถ้าเครื่องหมุนแต่ไม่ติด ให้เริ่มจากหัวเทียนก่อน — ถอดออกมาดูว่ายังมีประกายไฟหรือไม่ ถ้ามี เช็คคาร์บูเรเตอร์หรือหัวฉีด",
    ["การเปลี่ยนหัวเทียนทำได้เอง", "การล้างคาร์บูเรเตอร์หรือซ่อมหัวฉีดอาจต้องส่งร้าน"],
  ),
)

recChain = DecisionNode(
  "rec-chain",
  null,
  null,
  DecisionLeaf(
    "เช็คความตึงโซ่และสภาพสเตอร์",
    "โซ่หย่อนเกินไปทำให้สูญเสียกำลังและเสียงดัง ตั้งความตึงโซ่ให้อยู่ในระดับที่พอดี (ระยะฟรีประมาณ 2-3 ซม.)",
    ["การตั้งโซ่ทำได้เอง", "ถ้าสเตอร์ฟันแหลมหรือโซ่ตาย ต้องเปลี่ยนใหม่ยกชุด"],
  ),
)

recClutch = DecisionNode(
  "rec-clutch",
  null,
  null,
  DecisionLeaf(
    "เช็คแผ่นคลัตช์ (รถเกียร์) หรือสายพาน (รถออโตเมติก)",
    "ถ้ารอบเครื่องขึ้นแต่รถไม่วิ่ง คลัตช์ลื่น (รถเกียร์) หรือสายพานยืด (รถออโตเมติก) เป็นสาเหตุหลัก",
    ["การเช็คคลัตช์/สายพานต้องถอดชิ้นส่วน", "ควรส่งร้านที่มีเครื่องมือ"],
  ),
)

recBrakeFluid = DecisionNode(
  "rec-brake-fluid",
  null,
  null,
  DecisionLeaf(
    "ไล่อากาศน้ำมันเบรก หรือเช็คซีลกระปุกเบรก",
    "เบรกนุ่มกดจมง่ายมักเกิดจากฟองอากาศในระบบหรือซีลแตก ตรวจสอบระดับน้ำมันเบรกที่กระปุกเบรกบน",
    ["การไล่อากาศทำได้เองถ้ามีผู้ช่วย", "ถ้าซีลแตกต้องเปลี่ยนซีลที่ร้าน"],
  ),
)

recBrakePad = DecisionNode(
  "rec-brake-pad",
  null,
  null,
  DecisionLeaf(
    "เช็คความหนาผ้าเบรกและสภาพจานเบรก",
    "ผ้าเบรกที่บางเกินไปทำให้เหล็กเสียดสีกับจานเบรก ทำให้เบรกไม่อยู่และจานเบรกเป็นรอย",
    ["การเปลี่ยนผ้าเบรกทำได้เองเบื้องต้น", "ถ้าจานเบรกเป็นร่องลึก ต้องลับหรือเปลี่ยนจาน"],
  ),
)
