root = TradeoffSandbox("ทางเลือกและการตัดสินใจ", [fuelSystem, engineOil, tires])

fuelSystem = TradeoffScenario(
  "fuel-system",
  "ระบบจ่ายเชื้อเพลิง (Fuel Delivery System)",
  [
    TradeoffMetric("precision", "ความแม่นยำส่วนผสม", 0),
    TradeoffMetric("coldstart", "สตาร์ทง่าย (เครื่องเย็น)", 0),
    TradeoffMetric("maintenance", "ความสะดวกในการบำรุงรักษา", 0),
    TradeoffMetric("price", "ความประหยัด (ราคา)", 0, null, null, "lower"),
  ],
  [fuelSystemType],
  "เลือกระบบจ่ายเชื้อเพลิงที่เหมาะกับรถและพฤติกรรมการใช้งานของคุณ",
)

fuelSystemType = TradeoffStep(
  "fuel-system-type",
  "เลือกระบบจ่ายเชื้อเพลิง",
  [fuelInjection, carburetor],
  "ระบบจ่ายเชื้อเพลิงที่เหมาะสมกับรถของคุณ",
  "fuel-injection",
)

fuelInjection = TradeoffChoice(
  "fuel-injection",
  "หัวฉีด (Fuel Injection / EFI)",
  "ระบบอิเล็กทรอนิกส์ที่ ECU คำนวณและควบคุมการพ่นละอองน้ำมันเชื้อเพลิงอย่างแม่นยำ",
  {precision: 90, coldstart: 95, maintenance: 60, price: -80},
  [
    ProCon(
      "ส่วนผสมแม่นยำ",
      "ECU คำนวณจากเซ็นเซอร์หลายตัว ปรับตามสภาวะจริง ทำให้ประหยัดน้ำมันและได้กำลังเต็มที่",
    ),
    ProCon("สตาร์ทง่าย", "เพิ่มส่วนผสมอัตโนมัติเมื่อเครื่องเย็น ไม่ต้องเปิดโช้ค"),
    ProCon("ไม่ต้องจูน", "ปรับจูนอัตโนมัติ ไม่ต้องยุ่งกับสกรูจูนคาร์บู"),
  ],
  [
    ProCon("ราคาสูง", "ค่าอะไหล่และค่าซ่อมสูง ต้องใช้เครื่องมือพิเศษในการวินิจฉัย"),
    ProCon("ซ่อมเองยาก", "ต้องเข้าใจระบบไฟฟ้าและอ่านค่าจากสแกนเนอร์"),
  ],
  "เป็นมาตรฐานของรถรุ่นใหม่ ให้ความแม่นยำสูงและใช้งานสะดวกที่สุด",
  "เมื่อต้องการรถที่สตาร์ทง่าย ประหยัดน้ำมัน และไม่ต้องจูนบ่อย",
)

carburetor = TradeoffChoice(
  "carburetor",
  "คาร์บูเรเตอร์ (Carburetor)",
  "ระบบกลไกผสมน้ำมันและอากาศด้วยแรงดูด ควบคุมด้วยสกรูและโช้ค",
  {precision: 40, coldstart: 45, maintenance: 85, price: -20},
  [
    ProCon("ซ่อมง่าย", "เห็นการทำงานด้วยตาเปล่า ถอดล้างและจูนเองได้ ไม่ต้องใช้เครื่องมือพิเศษ"),
    ProCon("ราคาถูก", "อะไหล่ถูกและหาซื้อง่าย ช่างส่วนใหญ่ซ่อมได้"),
    ProCon("ปรับแต่งง่าย", "เปลี่ยนเจ็ทหรือจูนสกรูอากาศเพื่อเพิ่มกำลังได้โดยตรง"),
  ],
  [
    ProCon("ส่วนผสมไม่แม่นยำ", "ไม่สามารถปรับตามสภาวะได้จริง กินน้ำมันมากกว่าหัวฉีด"),
    ProCon("สตาร์ทติดยาก", "ต้องเปิดโช้คช่วย และถ้าลืมปิดโช้ค รถจะเร่งไม่ขึ้นและหัวเทียนสกปรก"),
    ProCon("ต้องจูนบ่อย", "สภาพอากาศและระดับความสูงส่งผลต่อส่วนผสม ต้องจูนใหม่"),
  ],
  null,
  "เหมาะสำหรับรถรุ่นเก่า ที่ต้องการซ่อมเองได้ และชอบปรับแต่งด้วยมือ",
)

engineOil = TradeoffScenario(
  "engine-oil",
  "ประเภทของน้ำมันเครื่อง",
  [
    TradeoffMetric("protection", "การปกป้องเครื่องยนต์", 0),
    TradeoffMetric("lifespan", "ระยะเวลาใช้งาน", 0),
    TradeoffMetric("price", "ความประหยัด (ราคา)", 0, null, null, "lower"),
  ],
  [oilType],
  "เลือกน้ำมันเครื่องที่เหมาะสมกับการใช้งานและงบประมาณของคุณ ซึ่งจะส่งผลโดยตรงต่ออายุการใช้งานเครื่องยนต์",
)

oilType = TradeoffStep(
  "oil-type",
  "เลือกชนิดน้ำมันเครื่อง",
  [synthetic, semiSynthetic, mineral],
  "ชนิดของน้ำมันเครื่องที่คุณต้องการเปลี่ยน",
  "semi-synthetic",
)

synthetic = TradeoffChoice(
  "synthetic",
  "สังเคราะห์แท้ 100% (Fully Synthetic)",
  "น้ำมันเครื่องที่ผ่านการสังเคราะห์ทางเคมี ทนความร้อนสูง หล่อลื่นได้ดีเยี่ยมที่สุด",
  {protection: 95, lifespan: 90, price: -80},
  [
    ProCon("ปกป้องดีเยี่ยม", "ทนความร้อนสูง เครื่องยนต์ไม่สึกหรอง่าย"),
    ProCon("อายุการใช้งานยาวนาน", "เปลี่ยนถ่ายทุกๆ 5,000 - 10,000 กม."),
  ],
  [ProCon("ราคาสูง", "แพงกว่าน้ำมันเครื่องธรรมดาหลายเท่า")],
  "เหมาะสำหรับรถที่ใช้งานหนัก วิ่งระยะทางไกล หรือรถบิ๊กไบค์ที่ต้องการการปกป้องสูงสุด",
  "เมื่อคุณต้องการให้น้ำมันเครื่องมีอายุการใช้งานนานที่สุด",
)

semiSynthetic = TradeoffChoice(
  "semi-synthetic",
  "กึ่งสังเคราะห์ (Semi-Synthetic)",
  "ส่วนผสมระหว่างน้ำมันแร่ธรรมชาติและน้ำมันสังเคราะห์ คุ้มค่าและให้การปกป้องที่ดี",
  {protection: 75, lifespan: 70, price: -40},
  [ProCon("ราคาคุ้มค่า", "ราคาไม่แพงจนเกินไป ได้คุณสมบัติที่ดีจากน้ำมันสังเคราะห์")],
  [ProCon("อายุการใช้งานปานกลาง", "เปลี่ยนถ่ายทุกๆ 3,000 - 5,000 กม.")],
  "เป็นตัวเลือกที่สมดุลที่สุดสำหรับรถใช้งานทั่วไปในชีวิตประจำวัน",
)

mineral = TradeoffChoice(
  "mineral",
  "ธรรมดา (Mineral)",
  "น้ำมันเครื่องพื้นฐานที่กลั่นจากน้ำมันดิบ ราคาถูกที่สุด แต่ต้องเปลี่ยนถ่ายบ่อย",
  {protection: 50, lifespan: 40, price: -10},
  [ProCon("ราคาถูกที่สุด", "ประหยัดค่าใช้จ่ายในการเปลี่ยนถ่ายแต่ละครั้ง")],
  [
    ProCon("เสื่อมสภาพเร็ว", "ต้องเปลี่ยนถ่ายบ่อย (ทุกๆ 1,500 - 2,000 กม.)"),
    ProCon("ทนความร้อนต่ำ", "ไม่เหมาะกับการขับขี่ทางไกลแบบแช่ยาวๆ"),
  ],
  null,
  "เหมาะสำหรับรถใช้งานระยะใกล้ หรือรถรุ่นเก่าที่ไม่ต้องการการดูแลเป็นพิเศษ",
)

tires = TradeoffScenario(
  "tires",
  "ประเภทยางรถมอเตอร์ไซค์",
  [
    TradeoffMetric("safety", "ความปลอดภัยเมื่อยางรั่ว", 0),
    TradeoffMetric("convenience", "ความสะดวกในการปะยาง", 0),
    TradeoffMetric("price", "ความประหยัด (ราคายางและล้อ)", 0, null, null, "lower"),
  ],
  [tireType],
  "ประเภทยางมีผลต่อความปลอดภัยเมื่อเกิดการรั่วซึม และความสะดวกในการปะยาง",
)

tireType = TradeoffStep(
  "tire-type",
  "เลือกประเภทยาง",
  [tubeless, tubeType],
  "เลือกลักษณะยางที่ใช้กับล้อรถของคุณ",
  "tubeless",
)

tubeless = TradeoffChoice(
  "tubeless",
  "แบบไม่มียางใน (Tubeless)",
  "ใช้ร่วมกับล้อแม็ก หากโดนตะปูตำลมจะค่อยๆ ซึมออก ไม่แบนทันที",
  {safety: 90, convenience: 95, price: -70},
  [
    ProCon("ปลอดภัยสูง", "ลมไม่รั่วออกทันทีเมื่อโดนตะปู รถไม่ส่ายเสียอาการ"),
    ProCon("ปะยางง่าย", "สามารถแทงไหมอุดรูรั่วได้เลย ไม่ต้องถอดล้อ"),
  ],
  [ProCon("ต้นทุนสูง", "ต้องใช้ร่วมกับล้อแม็กซึ่งมีราคาแพง")],
  "เพิ่มความปลอดภัยสูงสุด ลดปัญหาจอดตายกลางทางจากยางรั่ว",
)

tubeType = TradeoffChoice(
  "tube-type",
  "แบบมียางใน (Tube Type)",
  "มักใช้กับล้อซี่ลวด หากโดนตะปูตำยางจะแบนทันที",
  {safety: 30, convenience: 40, price: -30},
  [
    ProCon("ราคาถูก", "ยางและล้อซี่ลวดมีราคาถูกกว่า"),
    ProCon("รับแรงกระแทกได้ดี", "ล้อซี่ลวดมีความยืดหยุ่นสูง เหมาะกับทางวิบาก"),
  ],
  [
    ProCon("อันตรายถ้ายางรั่วตอนวิ่งเร็ว", "ยางจะแบนทันที รถอาจจะเสียการควบคุม"),
    ProCon("ปะยาก", "ต้องถอดล้อเพื่องัดยางในออกมาปะ"),
  ],
  null,
  "เหมาะสำหรับรถคลาสสิก ล้อซี่ลวด หรือรถวิบากลุยป่า",
)
