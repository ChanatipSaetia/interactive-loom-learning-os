root = Scenario(
  "สถานการณ์: ที่สนามบินปักกิ่ง",
  "airport-meeting",
  [start, helloResult, nameResult, waveResult],
  "คุณเดินทางมาที่สนามบินปักกิ่งเป็นครั้งแรก เพื่อนจีนชื่อ '李明' (Lǐ Míng) กำลังรอคุณอยู่ คุณจะเริ่มบทสนทนาอย่างไร?",
  null,
  "การพบปะที่สนามบิน",
  "ลองใช้ภาษาจีนในชีวิตจริง",
)

start = ScenarioNode(
  "start",
  "คุณเห็น李明 ยืนถือป้ายชื่อของคุณ จะทักทายอย่างไร?",
  [
    ScenarioChoice(
      "say-hello",
      "你好！我是朋友。(Nǐ hǎo! Wǒ shì péngyou.) — สวัสดี! ฉันเป็นเพื่อน",
      "hello-result",
    ),
    ScenarioChoice("say-name", "我叫… (Wǒ jiào…) — ฉันชื่อ…", "name-result"),
    ScenarioChoice("wave", "แค่ยิ้มและโบกมือ", "wave-result"),
  ],
)

helloResult = ScenarioNode(
  "hello-result",
  null,
  null,
  Outcome(
    "李明 ยิ้มและตอบ '你好！很高兴认识你！' (สวัสดี! ยินดีที่ได้รู้จัก!)",
    "การทักทายด้วย '你好' เป็นวิธีที่ดีที่สุดในการเริ่มต้นบทสนทนา กับคนจีน การทักทายแบบสุภาพจะสร้างความประทับใจแรกที่ดี",
    "a",
  ),
)

nameResult = ScenarioNode(
  "name-result",
  null,
  null,
  Outcome(
    "李明 ตอบ '你好！我叫李明！' (สวัสดี! ฉันชื่อ李明)",
    "การแนะนำตัวเองด้วยชื่อเป็นวิธีที่ดีมาก คนจีนชอบเมื่อชาวต่างชาติพยายามพูดภาษาจีน แม้จะแค่ประโยคเดียว",
    "a",
  ),
)

waveResult = ScenarioNode(
  "wave-result",
  null,
  null,
  Outcome(
    "李明 ยิ้มและทักทายก่อน '你好！欢迎来到中国！' (สวัสดี! ยินดีต้อนรับสู่ประเทศจีน!)",
    "การยิ้มเป็นสากล แต่ลองพยายามพูด '你好' ดู下次 (ครั้งหน้า) เพื่อสร้างความประทับใจมากขึ้น",
    "b-plus",
  ),
)
