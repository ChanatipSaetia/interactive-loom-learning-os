characters = Concept("characters", "อักษรจีน (汉字)", "concept")
greeting = Concept("greeting", "คำทักทาย", "phrase")
numbers = Concept("numbers", "ตัวเลข 1-10", "phrase")
selfIntro = Concept("self-intro", "แนะนำตัวเอง", "phrase")
topic = Concept("topic", "ประธาน", "grammar")
comment = Concept("comment", "ขยายความ", "grammar")
sentence = Concept("sentence", "ประโยคพื้นฐาน", "grammar")
