root = Quiz("ทดสอบความรู้", [q1, q2, q3, q4, q5, q6, q7, q8], "ตอบคำถามเพื่อตรวจสอบความเข้าใจ")

q1 = QuizQuestion(
  "q1",
  "'你好' (nǐ hǎo) แปลว่าอะไร?",
  [
    QuizChoice("a", "ขอบคุณ", false, "ไม่ถูก '谢谢' (xiè xie) คือขอบคุณ"),
    QuizChoice("b", "สวัสดี", true, "ถูกต้อง! '你好' (nǐ hǎo) แปลว่า สวัสดี"),
    QuizChoice("c", "ลาก่อน", false, "ไม่ถูก '再见' (zài jiàn) คือนั่น"),
  ],
  "เป็นคำทักทายพื้นฐานที่สุด",
)

q2 = QuizQuestion(
  "q2",
  "ตัวเลข '五' อ่านว่าอะไร?",
  [
    QuizChoice("a", "wǔ (อู่)", true, "ถูกต้อง! '五' (wǔ) = ห้า"),
    QuizChoice("b", "sì (ซื่อ)", false, "ไม่ถูก '四' (sì) = สี่"),
    QuizChoice("c", "shí (สือ)", false, "ไม่ถูก '十' (shí) = สิบ"),
  ],
  "ออกเสียงคล้าย 'อู่'",
)

q3 = QuizQuestion(
  "q3",
  "ภาษาจีนกลางมีกี่เสียง?",
  [
    QuizChoice("a", "2 เสียง", false, "ไม่ถูก ภาษาจีนมีมากกว่า 2 เสียง"),
    QuizChoice("b", "4 เสียง", true, "ถูกต้อง! ภาษาจีนกลางมี 4 เสียง (ไม่รวมเสียงเบา)"),
    QuizChoice(
      "c",
      "6 เสียง",
      false,
      "ไม่ถูก ภาษาจีนกลางมี 4 เสียงหลัก (ภาษาจีนท้องถิ่นอื่นๆ อาจมีมากกว่า)",
    ),
  ],
  "เสียงคือระดับเสียงที่ใช้แยกความหมาย",
)

q4 = QuizQuestion(
  "q4",
  "'再见' (zài jiàn) แปลว่าอะไร?",
  [
    QuizChoice("a", "สวัสดี", false, "ไม่ถูก '你好' (nǐ hǎo) คือนั่น"),
    QuizChoice("b", "ลาก่อน", true, "ถูกต้อง! '再见' (zài jiàn) = ลาก่อน/พบกันใหม่"),
    QuizChoice("c", "ขอบคุณ", false, "ไม่ถูก '谢谢' (xiè xie) คือนั่น"),
  ],
  "ใช้ตอนจบการสนทนา",
)

q5 = QuizQuestion(
  "q5",
  "จะแนะนำตัวเองว่า 'ฉันชื่อสมชาย' เป็นจีนยังไง?",
  [
    QuizChoice("a", "我叫สมชาย", true, "ถูกต้อง! '我叫' + ชื่อ = ฉันชื่อ..."),
    QuizChoice("b", "你叫สมชาย", false, "ไม่ถูก '你叫' = คุณชื่อ"),
    QuizChoice("c", "你好สมชาย", false, "ไม่ถูก '你好' = สวัสดี"),
  ],
  "ใช้ '我叫' (wǒ jiào) = ฉันชื่อ",
)

q6 = QuizQuestion(
  "q6",
  "'十' (shí) คือเลขอะไร?",
  [
    QuizChoice("a", "เก้า", false, "ไม่ถูก '九' (jiǔ) = เก้า"),
    QuizChoice("b", "แปด", false, "ไม่ถูก '八' (bā) = แปด"),
    QuizChoice("c", "สิบ", true, "ถูกต้อง! '十' (shí) = สิบ"),
  ],
  "เป็นเลขสุดท้ายของบทนี้",
)

q7 = QuizQuestion(
  "q7",
  "คำว่า '吗' (ma) ในประโยค '你好吗？' ทำหน้าที่อะไร?",
  [
    QuizChoice(
      "a",
      "ทำให้ประโยคเป็นคำถาม",
      true,
      "ถูกต้อง! '吗' (ma) เป็นคำช่วยเปลี่ยนประโยคเป็นคำถาม",
    ),
    QuizChoice("b", "ทำให้ประโยคเป็นประโยคปฏิเสธ", false, "ไม่ถูก '不' (bù) คือนั่น"),
    QuizChoice("c", "ทำให้ประโยคเป็นคำขอบคุณ", false, "ไม่ถูก '谢谢' (xiè xie) คือนั่น"),
  ],
  "เปลี่ยนประโยคบอกเล่าเป็นคำถาม",
)

q8 = QuizQuestion(
  "q8",
  "'谢谢' (xiè xie) แปลว่าอะไร?",
  [
    QuizChoice("a", "ขอโทษ", false, "ไม่ถูก '对不起' (duì bu qǐ) คือนั่น"),
    QuizChoice("b", "สวัสดี", false, "ไม่ถูก '你好' (nǐ hǎo) คือนั่น"),
    QuizChoice("c", "ขอบคุณ", true, "ถูกต้อง! '谢谢' (xiè xie) = ขอบคุณ"),
  ],
  "พูดเมื่อมีคนช่วยเหลือ",
)
