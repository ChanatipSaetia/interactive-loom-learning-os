root = ReflectionTemplate("Synthesis Vault", [challenge1, challenge2])

challenge1 = TemplateChallenge(
  "Complete the architecture statement describing how a story reaches the screen (Part 1):",
  "In Component Story Format, the file's default export is the {zone-1}, which declares the title and component; each named export is one {zone-2}. The indexer scans these exports to build the sidebar, while the {zone-3} iframe mounts the component with the story's args as props.",
  [
    Chip("chip-meta", "meta"),
    Chip("chip-decorator", "decorator"),
    Chip("chip-story", "story"),
    Chip("chip-manager", "manager"),
    Chip("chip-preview", "preview"),
    Chip("chip-addon", "addon"),
  ],
  {"zone-1": "chip-meta", "zone-2": "chip-story", "zone-3": "chip-preview"},
  "<strong>Correct!</strong> Meta is the file-level default export, each named export is one story, and the <em>preview</em> iframe is the runtime that actually renders your component — while the <em>manager</em> is just the chrome around it.",
)

challenge2 = TemplateChallenge(
  "Complete the safety-net statement forged from the testing track (Part 2):",
  "A {zone-1} scripts userEvent interactions so behavior is tested; the {zone-2} executes every story headlessly in CI; and {zone-3} diffing catches silent pixel changes — but its baseline approvals need {zone-4}, or the net becomes a rubber stamp.",
  [
    Chip("chip-play", "play function"),
    Chip("chip-argtypes", "argTypes table"),
    Chip("chip-testrunner", "test runner"),
    Chip("chip-composition", "composition"),
    Chip("chip-visual", "visual regression"),
    Chip("chip-snapshot", "MDX snapshot"),
    Chip("chip-discipline", "owners and review discipline"),
    Chip("chip-luck", "random luck"),
  ],
  {
    "zone-1": "chip-play",
    "zone-2": "chip-testrunner",
    "zone-3": "chip-visual",
    "zone-4": "chip-discipline",
  },
  "<strong>Correct! The safety net is forged.</strong> Play functions test behavior, the test runner executes stories as tests, visual regression guards pixels — and the Release-Day crisis proved that unreviewed baseline acceptance ships the bug anyway.",
)
