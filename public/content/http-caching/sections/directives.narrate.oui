root = Narration([overview, lifetime, misread, compare, privacy])

overview = NarrationStep("cards", "Four directives decide whether a cache may keep a response, and for how long.", [Spotlight(["maxAge", "noCache", "noStore", "private"])])

lifetime = NarrationStep("card1", "max-age is the simplest: how many seconds a copy stays fresh.", [
  Highlight("maxAge.description"),
])

misread = NarrationStep("card2", "The name no-cache is the one people misread.", [
  Highlight("noCache.title"),
  Callout("noCache", "no-cache does not mean do not cache. The copy is kept; it is only checked with the server before each reuse."),
])

compare = NarrationStep("card3", "If nothing may be kept at all, that is no-store.", [
  Callout("noStore", "Banking pages use no-store: nothing touches a disk, so every visit goes back to the server."),
])

privacy = NarrationStep("card4", "private is about who may keep it, not how long.", [
  Callout("private", "The browser may cache it; a shared CDN may not. Use it for pages that differ per signed-in user."),
])
