root = Quiz("Principles Check", [q1, q2, q3, q4, q5, q6, q7, q8, q9, q10, q11, q12, q13])

q1 = QuizQuestion(
  "q1",
  "Which module title best follows the task-first principle?",
  [
    QuizChoice(
      "q1-a",
      "Approve a leave request",
      true,
      "Task-first manuals are organised around real job tasks, not screens.",
    ),
    QuizChoice(
      "q1-b",
      "A tour of the Settings tab",
      false,
      "That is screen-first: it follows the software, not the learner's job.",
    ),
    QuizChoice(
      "q1-c",
      "All menus explained, A to Z",
      false,
      "A tour of every menu is exactly what task-first avoids.",
    ),
  ],
  "Which one is a job someone has to get done?",
)

q2 = QuizQuestion(
  "q2",
  "Under selective fidelity, what must match the real software exactly?",
  [
    QuizChoice(
      "q2-a",
      "The controls, labels and order on the task path",
      true,
      "The path the learner practises must be exact; everything off the path can be static or disabled.",
    ),
    QuizChoice(
      "q2-b",
      "Every screen and feature of the product",
      false,
      "That's full fidelity, which costs far more to build and maintain.",
    ),
    QuizChoice(
      "q2-c",
      "Nothing: approximate screens are fine",
      false,
      "The task path must be exact, or learners build the wrong muscle memory.",
    ),
  ],
  "Think of the film set that only builds what the camera sees.",
)

q3 = QuizQuestion(
  "q3",
  "A trainer suggests copying last month's real customer list into the simulation 'to make it realistic'. What does the realistic, safe data principle say?",
  [
    QuizChoice(
      "q3-a",
      "Use synthetic data that looks like real cases, never copied production data",
      true,
      "Realism comes from believable synthetic records, not from real people's data.",
    ),
    QuizChoice(
      "q3-b",
      "Fine, as long as it's only for a week",
      false,
      "The principle is never, not 'just for now'.",
    ),
    QuizChoice(
      "q3-c",
      "Use 'Test User 1' so nothing looks real",
      false,
      "That's safe, but not realistic: it hides the real difficulties learners will meet.",
    ),
  ],
  "Realistic and safe at the same time.",
)

q4 = QuizQuestion(
  "q4",
  "A learner clicks 'Refund' twice in the simulation. What does 'safe to fail' recommend?",
  [
    QuizChoice(
      "q4-a",
      "Show what would happen in the real system, then let them reset",
      true,
      "Learners can make mistakes, see the consequence and reset.",
    ),
    QuizChoice(
      "q4-b",
      "Block the second click silently",
      false,
      "Silently blocking hides the lesson the mistake could teach.",
    ),
    QuizChoice(
      "q4-c",
      "End the module and mark them as failed",
      false,
      "The point of simulating is that mistakes cost nothing.",
    ),
  ],
  "What's the flight simulator's approach to a crash?",
)

q5 = QuizQuestion(
  "q5",
  "Why split a 45-minute 'everything in the CRM' simulation into small modules?",
  [
    QuizChoice(
      "q5-a",
      "Each short, single-goal task can be finished in minutes and found again later",
      true,
      "Small chunks are finishable and findable, and one release breaks one small module instead of a giant course.",
    ),
    QuizChoice(
      "q5-b",
      "Small modules need no maintenance",
      false,
      "They still need upkeep, just less per change.",
    ),
    QuizChoice(
      "q5-c",
      "LMSs can't host long courses",
      false,
      "They can. The reason is learning and lookup.",
    ),
  ],
  "Think recipe cards versus a whole cookbook.",
)

q6 = QuizQuestion(
  "q6",
  "What belongs in the 'bridge to the real system' at the end of a module?",
  [
    QuizChoice(
      "q6-a",
      "What differs in the real system, such as extra approvals, permissions or live consequences",
      true,
      "The bridge tells learners what will be different when they do it for real.",
    ),
    QuizChoice(
      "q6-b",
      "A score summary",
      false,
      "Scores go to the LMS; the bridge is about the real system.",
    ),
    QuizChoice(
      "q6-c",
      "The product's release notes",
      false,
      "The bridge is specific to the task just practised.",
    ),
  ],
  "What will surprise them on the live system?",
)

q7 = QuizQuestion(
  "q7",
  "Which is an accessibility requirement for an interactive manual?",
  [
    QuizChoice(
      "q7-a",
      "Keyboard navigation, screen-reader labels and captions",
      true,
      "These are the three accessibility basics taught.",
    ),
    QuizChoice(
      "q7-b",
      "Mouse-only hotspots for precision",
      false,
      "Mouse-only hotspots lock out keyboard and screen-reader users.",
    ),
    QuizChoice("q7-c", "Autoplaying narration without captions", false, "Audio needs captions."),
  ],
  "Who uses the real system without a mouse?",
)

q8 = QuizQuestion(
  "q8",
  "What is the first step of building a simulation?",
  [
    QuizChoice(
      "q8-a",
      "Task analysis: watch an expert do the real task and note every step, decision and common mistake",
      true,
      "Everything else, including wrong-click feedback, is built from the task analysis.",
    ),
    QuizChoice(
      "q8-b",
      "Choose an authoring tool",
      false,
      "The tool comes after you know what the task is.",
    ),
    QuizChoice("q8-c", "Publish to the LMS", false, "Publishing comes last."),
  ],
  "Start by watching the real work.",
)

q9 = QuizQuestion(
  "q9",
  "A step script lists three things for each step. Which three?",
  [
    QuizChoice(
      "q9-a",
      "The expected action, the hint, and the feedback for a wrong action",
      true,
      "Those three turn a step into a teachable moment.",
    ),
    QuizChoice(
      "q9-b",
      "The screen colour, font and logo",
      false,
      "The step script is about behaviour, not branding.",
    ),
    QuizChoice(
      "q9-c",
      "The developer, the tester and the release date",
      false,
      "Ownership matters, but it isn't part of the step script.",
    ),
  ],
  "What should happen when the learner is right, stuck or wrong?",
)

q10 = QuizQuestion(
  "q10",
  "Before releasing to 900 staff, what should you do with the finished simulation?",
  [
    QuizChoice(
      "q10-a",
      "Pilot it with a few real learners and fix where they get stuck",
      true,
      "A pilot finds confusing steps while they're still cheap to fix.",
    ),
    QuizChoice(
      "q10-b",
      "Release it and wait for feedback",
      false,
      "Then 900 people meet the confusing steps instead of a few.",
    ),
    QuizChoice("q10-c", "Add a disclaimer", false, "A disclaimer doesn't fix a confusing step."),
  ],
  "Small audience first.",
)

q11 = QuizQuestion(
  "q11",
  "After release, how do you find the most confusing steps?",
  [
    QuizChoice(
      "q11-a",
      "Track completion and wrong-click data, e.g. via xAPI",
      true,
      "Steps where many learners click the wrong thing point to design problems.",
    ),
    QuizChoice(
      "q11-b",
      "Count how many people opened the module",
      false,
      "Opens don't show where people struggle.",
    ),
    QuizChoice(
      "q11-c",
      "Ask the developers",
      false,
      "The learners' behaviour tells you, not the builders' guesses.",
    ),
  ],
  "Which data shows where people click wrong?",
)

q12 = QuizQuestion(
  "q12",
  "Which mode removes all hints to check the learner can do the task alone?",
  [
    QuizChoice("q12-a", "Test", true, "Test is the unguided assessment."),
    QuizChoice("q12-b", "Try", false, "Try is guided practice with hints."),
    QuizChoice("q12-c", "Watch", false, "Watch is a demo; the learner doesn't act."),
  ],
  "Watch → Try → ?",
)

q13 = QuizQuestion(
  "q13",
  "In Try mode, a learner clicks 'Save' instead of 'Submit'. What should the simulation do?",
  [
    QuizChoice(
      "q13-a",
      "Give immediate, specific feedback about why that was wrong",
      true,
      "Wrong clicks should get immediate, specific feedback instead of silence.",
    ),
    QuizChoice(
      "q13-b",
      "Do nothing until they click the right button",
      false,
      "Silently doing nothing leaves the learner guessing.",
    ),
    QuizChoice(
      "q13-c",
      "Jump straight to Test mode",
      false,
      "They haven't finished guided practice yet.",
    ),
  ],
  "Look at the wrong-click branch of the flowchart.",
)
