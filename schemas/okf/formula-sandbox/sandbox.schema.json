            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "formula": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "analogy": {
            "type": "string"
          },
          "inScope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "outOfScope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
