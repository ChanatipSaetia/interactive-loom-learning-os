{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from Zod by `npm run okf:schemas` — do not edit by hand. Concept map nodes and edges — the concepts.yaml file of a concept-map section.",
  "title": "OKF concept-map concepts.yaml",
  "type": "object",
  "properties": {
    "nodes": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "category": {
            "type": "string"
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "from",
          "to"
        ]
      }
    }
  },
  "required": [
    "nodes",
    "edges"
  ]
}
