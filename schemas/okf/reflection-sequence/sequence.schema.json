{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from Zod by `npm run okf:schemas` — do not edit by hand. Sequencing challenges — the sequence.yaml file of a reflection-sequence section.",
  "title": "OKF reflection-sequence sequence.yaml",
  "type": "object",
  "properties": {
    "challenges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "icon": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text"
              ]
            }
          },
          "solution": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "groundedIn": {
            "type": "string"
          }
        },
        "required": [
          "prompt",
          "items",
          "solution"
        ]
      }
    }
  },
  "required": [
    "challenges"
  ]
}
