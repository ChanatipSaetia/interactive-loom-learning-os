{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Generated from Zod by `npm run okf:schemas` — do not edit by hand. Tradeoff scenarios (array) — a single-file tradeoff collection declared via resource.",
  "title": "OKF tradeoff-sandbox scenarios.yaml",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string"
      },
      "title": {
        "type": "string"
      },
      "description": {
        "type": "string"
      },
      "metrics": {
        "type": "array",
